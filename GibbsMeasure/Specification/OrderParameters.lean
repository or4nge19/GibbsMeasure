namespace MeasureTheory.GibbsMeasure

/-! ### Georgii Definition (16.18): discriminating systems -/

section Discriminating

variable {S E : Type*} [MeasurableSpace E] {N : ℕ}

/-- **Georgii's convention `f₀ = 1`** in Definition (16.18): the family `f₁, …, f_N` of bounded
observables extended by the constant function `1` in position `0`. -/
def withOne (f : Fin N → lp (fun _ : S → E ↦ ℝ) ∞) : Fin (N + 1) → lp (fun _ : S → E ↦ ℝ) ∞ :=
  Fin.cases 1 f

omit [MeasurableSpace E] in
@[simp] lemma withOne_zero (f : Fin N → lp (fun _ : S → E ↦ ℝ) ∞) : withOne f 0 = 1 :=
  Fin.cases_zero ..

omit [MeasurableSpace E] in
@[simp] lemma withOne_succ (f : Fin N → lp (fun _ : S → E ↦ ℝ) ∞) (n : Fin N) :
    withOne f n.succ = f n := Fin.cases_succ ..

/-- The vector of expectations `(μ(f₀), …, μ(f_N)) ∈ ℝ^{N+1}` of Georgii (16.18), where
`f₀ = 1`, so that its `0`-th entry is `1` for every probability measure. -/
def observableVector (f : Fin N → lp (fun _ : S → E ↦ ℝ) ∞) (μ : Measure (S → E)) :
    Fin (N + 1) → ℝ := fun n ↦ ∫ ω, ⇑(withOne f n) ω ∂μ

lemma observableVector_apply (f : Fin N → lp (fun _ : S → E ↦ ℝ) ∞) (μ : Measure (S → E))
    (n : Fin (N + 1)) : observableVector f μ n = ∫ ω, ⇑(withOne f n) ω ∂μ := rfl

@[simp] lemma observableVector_zero (f : Fin N → lp (fun _ : S → E ↦ ℝ) ∞)
    (μ : Measure (S → E)) [IsProbabilityMeasure μ] : observableVector f μ 0 = 1 := by
  simp [observableVector]

@[simp] lemma observableVector_succ (f : Fin N → lp (fun _ : S → E ↦ ℝ) ∞) (μ : Measure (S → E))
    (n : Fin N) : observableVector f μ n.succ = ∫ ω, ⇑(f n) ω ∂μ := by
  simp [observableVector]

/-- **Georgii Definition (16.18):** the matrix `(μ_m(f_n))_{0 ≤ m, n ≤ N}`, with `f₀ = 1`. -/
def observableMatrix (f : Fin N → lp (fun _ : S → E ↦ ℝ) ∞) (μ : Fin (N + 1) → Measure (S → E)) :
    Matrix (Fin (N + 1)) (Fin (N + 1)) ℝ :=
  Matrix.of fun m ↦ observableVector f (μ m)

@[simp] lemma observableMatrix_row (f : Fin N → lp (fun _ : S → E ↦ ℝ) ∞)
    (μ : Fin (N + 1) → Measure (S → E)) (m : Fin (N + 1)) :
    (observableMatrix f μ).row m = observableVector f (μ m) := rfl

/-- **Georgii Definition (16.18).** A family `{f₁, …, f_N}` of bounded observables is a
*discriminating system* for a family `P` of random fields if `P` contains `N + 1` measures
`μ₀, …, μ_N` whose matrix of expectations `(μ_m(f_n))_{0 ≤ m, n ≤ N}` (with `f₀ = 1`) has full
rank.

Georgii writes `Φ ≪ {f₁, …, f_N}` for `IsDiscriminating 𝒢_Θ(Φ) f`, and says that `Φ` *exhibits a
phase transition with discriminating system* `{f₁, …, f_N}`. -/
def IsDiscriminating (P : Set (Measure (S → E))) (f : Fin N → lp (fun _ : S → E ↦ ℝ) ∞) : Prop :=
  ∃ μ : Fin (N + 1) → Measure (S → E), (∀ m, μ m ∈ P) ∧ (observableMatrix f μ).det ≠ 0

lemma IsDiscriminating.mono {P Q : Set (Measure (S → E))} (hPQ : P ⊆ Q)
    {f : Fin N → lp (fun _ : S → E ↦ ℝ) ∞} (h : IsDiscriminating P f) : IsDiscriminating Q f := by
  obtain ⟨μ, hμ, hdet⟩ := h
  exact ⟨μ, fun m ↦ hPQ (hμ m), hdet⟩

/-- **Georgii (16.18), the linear-algebra content.** `{f₁, …, f_N}` is a discriminating system for
`P` exactly when the vectors `(μ(f₀), …, μ(f_N))`, `μ ∈ P`, span `ℝ^{N+1}`; equivalently (for
probability measures) when the points `(μ(f₁), …, μ(f_N))` affinely span `ℝ^N`.

This is Georgii's "well-known theorem of linear algebra" in the proof of Lemma (16.20): a matrix
of full rank has a full set of linearly independent rows. -/
theorem isDiscriminating_iff_span_eq_top (P : Set (Measure (S → E)))
    (f : Fin N → lp (fun _ : S → E ↦ ℝ) ∞) :
    IsDiscriminating P f ↔ Submodule.span ℝ (observableVector f '' P) = ⊤ := by
  have hrank : Module.finrank ℝ (Fin (N + 1) → ℝ) = N + 1 := Module.finrank_fin_fun ℝ
  constructor
  · rintro ⟨μ, hμ, hdet⟩
    have hsp := Matrix.det_ne_zero_iff_span_range_row_eq_top.1 hdet
    refine top_le_iff.1 (hsp.ge.trans (Submodule.span_mono ?_))
    rintro _ ⟨m, rfl⟩
    exact ⟨μ m, hμ m, rfl⟩
  · intro hspan
    have hrange : Set.range (fun p : P ↦ observableVector f (p : Measure (S → E)))
        = observableVector f '' P := by
      ext v; exact ⟨fun ⟨p, hp⟩ ↦ ⟨p, p.2, hp⟩, fun ⟨μ, hμ, h⟩ ↦ ⟨⟨μ, hμ⟩, h⟩⟩
    obtain ⟨w, hw⟩ := exists_linearIndependent_comp_of_span_eq_top hrank
      (fun p : P ↦ observableVector f (p : Measure (S → E))) (by rw [hrange]; exact hspan)
    refine ⟨fun m ↦ ((w m : P) : Measure (S → E)), fun m ↦ (w m).2, ?_⟩
    refine Matrix.det_ne_zero_iff_span_range_row_eq_top.2 ?_
    exact span_range_eq_top_of_linearIndependent_of_finrank_eq hrank hw

end Discriminating

/-! ### Conditioning a `Θ`-invariant Gibbs measure on an invariant event -/

section Conditioning

variable {S E : Type*} [MeasurableSpace E] [Countable S] [StandardBorelSpace E]
  {γ : Specification S E} {Θ : Subgroup (Transformation S E)} [Countable Θ]

/-- `𝒢_Θ(γ)` is convex: a finite convex combination of `Θ`-invariant Gibbs measures is one.
The binary case is `MeasureTheory.GibbsMeasure.smul_add_smul_mem_invariantFields` together with
convexity of `𝒢(γ)`; this is the `n`-ary form, proved as
`MeasureTheory.GibbsMeasure.sum_smul_mem_G` is, through the barycentre `Measure.join`. -/
lemma sum_smul_mem_invariantG {n : ℕ} {c : Fin n → ℝ≥0∞} {ρ : Fin n → Measure (S → E)}
    (hρ : ∀ i, ρ i ∈ invariantG γ Θ) (hc : ∑ i, c i = 1) :
    (∑ i, c i • ρ i) ∈ invariantG γ Θ := by
  have hwprob : IsProbabilityMeasure
      (∑ i, c i • Measure.dirac (ρ i) : Measure (Measure (S → E))) := by
    constructor
    rw [Measure.finsetSum_apply]
    have h1 : ∀ i : Fin n, (c i • Measure.dirac (ρ i) : Measure (Measure (S → E))) univ = c i :=
      fun i ↦ by rw [Measure.smul_apply, measure_univ, smul_eq_mul, mul_one]
    rw [Finset.sum_congr rfl fun i _ ↦ h1 i]
    exact hc
  have hnull : (∑ i, c i • Measure.dirac (ρ i) : Measure (Measure (S → E)))
      ((invariantG γ Θ)ᶜ) = 0 := by
    rw [Measure.finsetSum_apply]
    refine Finset.sum_eq_zero fun i _ ↦ ?_
    rw [Measure.smul_apply, Measure.dirac_apply' _ (measurableSet_invariantG (γ := γ)).compl,
      Set.indicator_of_notMem (Set.notMem_compl_iff.2 (hρ i)), smul_zero]
  rw [← join_finset_sum_smul_dirac (Finset.univ : Finset (Fin n)) c ρ]
  exact join_mem_invariantG _ hnull

variable (hΘ : ∀ Λ : Finset S, ∃ τ ∈ Θ, Disjoint (τ.sites ⁻¹' (Λ : Set S)) (Λ : Set S))

include hΘ

omit [StandardBorelSpace E] in
/-- **Georgii, in the proof of Lemma (16.20)(ii) ⇒ (i).** Conditioning a `Θ`-invariant Gibbs
measure on an invariant event of positive probability gives again a `Θ`-invariant Gibbs measure:
the density `1_A / μ(A)` is `𝓘`-measurable, so Theorem (14.5)(b) puts `μ(·|A)` in `𝓟_Θ`, and
Theorem (14.15)(b) then puts it in `𝒢_Θ(γ)`. -/
theorem cond_mem_invariantG {μ : Measure (S → E)} (hμ : μ ∈ invariantG γ Θ)
    {A : Set (S → E)} (hA : MeasurableSet[invariantEvents Θ] A) (hA0 : μ A ≠ 0) :
    ProbabilityTheory.cond μ A ∈ invariantG γ Θ := by
  have hμp : IsProbabilityMeasure μ := hμ.1.1
  have hm : invariantEvents Θ ≤ (inferInstance : MeasurableSpace (S → E)) :=
    MeasurableSpace.smulInvariants_le
  have hAm : MeasurableSet A := hm _ hA
  have hprob : IsProbabilityMeasure (ProbabilityTheory.cond μ A) :=
    ProbabilityTheory.cond_isProbabilityMeasure hA0
  have hdens : ProbabilityTheory.cond μ A
      = μ.withDensity (fun ω ↦ A.indicator (fun _ ↦ (μ A)⁻¹) ω) := by
    rw [withDensity_indicator hAm, withDensity_const, ProbabilityTheory.cond]
  have hmeas : Measurable[invariantEvents Θ] fun ω ↦ A.indicator (fun _ ↦ (μ A)⁻¹) ω :=
    (measurable_const.indicator hA)
  have hfields : ProbabilityTheory.cond μ A ∈ invariantFields Θ :=
    (mem_invariantFields_iff_exists_withDensity hμ.2 ProbabilityTheory.cond_absolutelyContinuous).2
      ⟨_, hmeas, hdens⟩
  exact mem_invariantG_of_absolutelyContinuous hΘ hμ hfields
    ProbabilityTheory.cond_absolutelyContinuous

end Conditioning

/-! ### Variance of a conditional expectation -/

section Variance

variable {Ω : Type*} {m₀ m : MeasurableSpace Ω} {μ : Measure[m₀] Ω} [IsProbabilityMeasure μ]

/-- For a bounded observable `g` and a probability measure, Georgii's inequality
`μ(g)² < μ(μ(g | 𝒜)²)` says exactly that `μ(g | 𝒜)` is not `μ`-a.s. constant: the difference of
the two sides is the variance of `μ(g | 𝒜)`. -/
theorem sq_integral_lt_integral_sq_condExp_iff (hm : m ≤ m₀) {g : Ω → ℝ} {C : ℝ}
    (hgb : ∀ᵐ ω ∂μ, ‖g ω‖ ≤ C) :
    (∫ ω, g ω ∂μ) ^ 2 < ∫ ω, ((μ[g | m]) ω) ^ 2 ∂μ ↔
      ¬ ((μ[g | m]) =ᵐ[μ] fun _ ↦ ∫ ω, g ω ∂μ) := by
  have hbdd : ∀ᵐ ω ∂μ, ‖(μ[g | m]) ω‖ ≤ C := ae_bdd_norm_condExp_of_ae_bdd_norm hgb
  have hmem : MemLp (μ[g | m]) 2 μ :=
    MemLp.of_bound (stronglyMeasurable_condExp.mono hm).aestronglyMeasurable C hbdd
  have hmean : ∫ ω, (μ[g | m]) ω ∂μ = ∫ ω, g ω ∂μ := integral_condExp hm
  have hvar : ProbabilityTheory.variance (μ[g | m]) μ
      = (∫ ω, ((μ[g | m]) ω) ^ 2 ∂μ) - (∫ ω, g ω ∂μ) ^ 2 := by
    rw [ProbabilityTheory.variance_eq_sub hmem, hmean]
    congr 1
  constructor
  · intro hlt hconst
    have h0 : ProbabilityTheory.variance (μ[g | m]) μ = 0 := by
      rw [ProbabilityTheory.variance_congr hconst,
        ProbabilityTheory.variance_eq_integral aemeasurable_const]
      simp
    rw [hvar] at h0
    linarith
  · intro hne
    have hpos : ProbabilityTheory.variance (μ[g | m]) μ ≠ 0 := fun h0 ↦
      hne (Filter.EventuallyEq.trans
        (ProbabilityTheory.ae_eq_integral_of_variance_eq_zero hmem h0)
        (Filter.Eventually.of_forall fun _ ↦ hmean))
    have := (ProbabilityTheory.variance_nonneg (μ[g | m]) μ).lt_of_ne (Ne.symm hpos)
    rw [hvar] at this
    linarith

end Variance

/-! ### Georgii Lemma (16.20) -/

section Lemma1620

variable {S E : Type*} [MeasurableSpace E] {N : ℕ}

/-- **Georgii's `f_a = ∑_{n=1}^N a_n f_n`**, §16.3, before Lemma (16.20). -/
def combo (f : Fin N → lp (fun _ : S → E ↦ ℝ) ∞) (a : Fin N → ℝ) :
    lp (fun _ : S → E ↦ ℝ) ∞ := ∑ n, a n • f n

omit [MeasurableSpace E] in
@[simp] lemma coeFn_combo (f : Fin N → lp (fun _ : S → E ↦ ℝ) ∞) (a : Fin N → ℝ) (ω : S → E) :
    ⇑(combo f a) ω = ∑ n, a n * ⇑(f n) ω := by
  rw [combo, lp.coeFn_sum]
  simp

lemma measurable_combo {f : Fin N → lp (fun _ : S → E ↦ ℝ) ∞} (hf : ∀ n, Measurable ⇑(f n))
    (a : Fin N → ℝ) : Measurable ⇑(combo f a) := by
  have : ⇑(combo f a) = fun ω ↦ ∑ n, a n * ⇑(f n) ω := funext (coeFn_combo f a)
  rw [this]
  exact Finset.measurable_sum _ fun n _ ↦ (hf n).const_mul _

lemma integral_combo {f : Fin N → lp (fun _ : S → E ↦ ℝ) ∞} (hf : ∀ n, Measurable ⇑(f n))
    (a : Fin N → ℝ) (μ : Measure (S → E)) [IsProbabilityMeasure μ] :
    ∫ ω, ⇑(combo f a) ω ∂μ = ∑ n, a n * ∫ ω, ⇑(f n) ω ∂μ := by
  simp_rw [coeFn_combo]
  rw [integral_finsetSum _ fun n _ ↦ (lp.integrable_of_measurable (hf n) μ).const_mul _]
  exact Finset.sum_congr rfl fun n _ ↦ integral_const_mul _ _

variable (Θ : Subgroup (Transformation S E))

/-- **Georgii (16.20)(ii).** The random field `μ` has *nondegenerate invariant means* for the
family `{f₁, …, f_N}` if for every `a ≠ 0` the conditional expectation `μ(f_a | 𝓘)` of
`f_a = ∑ a_n f_n` given the invariant σ-algebra has positive variance,
`μ(f_a)² < μ(μ(f_a | 𝓘)²)`.

Georgii states the condition for `|a| = 1`; both sides of the inequality are homogeneous of
degree `2` in `a`, so the two forms are equivalent, and `a ≠ 0` avoids putting a norm on `ℝ^N`
(`MeasureTheory.GibbsMeasure.hasNondegenerateInvariantMeans_of_forall_norm_eq_one`). -/
def HasNondegenerateInvariantMeans (μ : Measure (S → E))
    (f : Fin N → lp (fun _ : S → E ↦ ℝ) ∞) : Prop :=
  ∀ a : Fin N → ℝ, a ≠ 0 →
    (∫ ω, ⇑(combo f a) ω ∂μ) ^ 2 < ∫ ω, ((μ[⇑(combo f a) | invariantEvents Θ]) ω) ^ 2 ∂μ

variable {Θ}

/-- **Georgii (16.20)(ii)**, restated: no non-trivial linear combination of the `f_n` has a
`μ`-a.s. constant conditional expectation given the invariant σ-algebra. -/
theorem hasNondegenerateInvariantMeans_iff {μ : Measure (S → E)} [IsProbabilityMeasure μ]
    {f : Fin N → lp (fun _ : S → E ↦ ℝ) ∞} :
    HasNondegenerateInvariantMeans Θ μ f ↔
      ∀ a : Fin N → ℝ, a ≠ 0 → ¬ ((μ[⇑(combo f a) | invariantEvents Θ]) =ᵐ[μ]
        fun _ ↦ ∫ ω, ⇑(combo f a) ω ∂μ) := by
  refine forall_congr' fun a ↦ forall_congr' fun _ ↦ ?_
  exact sq_integral_lt_integral_sq_condExp_iff MeasurableSpace.smulInvariants_le
    (C := ‖combo f a‖)
    (Filter.Eventually.of_forall fun ω ↦ lp.norm_apply_le_norm ENNReal.top_ne_zero _ ω)

/-- **Georgii, in the proof of Lemma (16.20)(i) ⇒ (ii).** If the conditional expectation of a
bounded measurable observable `g` given the invariant σ-algebra `𝓘` is `μ`-a.s. equal to a
constant `c`, then every `Θ`-invariant random field `ρ ≪ μ` gives `g` the expectation `c`.

This is Georgii's `μ_m(f_a) = μ(g_m f̃_a) = −a₀`: by Theorem (14.5)(b) the density `dρ/dμ` may be
taken `𝓘`-measurable, and the conditional expectation may then be pulled out of the integral. -/
theorem integral_eq_of_condExp_invariantEvents_ae_eq_const [Countable Θ]
    {μ ρ : Measure (S → E)} (hμ : μ ∈ invariantFields Θ) (hρ : ρ ∈ invariantFields Θ)
    (hρμ : ρ ≪ μ) {g : lp (fun _ : S → E ↦ ℝ) ∞} (hgm : Measurable ⇑g) {c : ℝ}
    (hc : (μ[⇑g | invariantEvents Θ]) =ᵐ[μ] fun _ ↦ c) :
    ∫ ω, ⇑g ω ∂ρ = c := by
  have hμp : IsProbabilityMeasure μ := hμ.1
  have hρp : IsProbabilityMeasure ρ := hρ.1
  have hm : invariantEvents Θ ≤ (inferInstance : MeasurableSpace (S → E)) :=
    MeasurableSpace.smulInvariants_le
  obtain ⟨F, hFmeas, hFeq⟩ := (mem_invariantFields_iff_exists_withDensity hμ hρμ).1 hρ
  have hFm : Measurable F := hFmeas.mono hm le_rfl
  have hlint : ∫⁻ ω, F ω ∂μ = 1 := by
    have h := hρp.measure_univ
    rwa [hFeq, withDensity_apply _ MeasurableSet.univ, setLIntegral_univ] at h
  have hFtop : ∫⁻ ω, F ω ∂μ ≠ ⊤ := by rw [hlint]; exact ENNReal.one_ne_top
  have hFlt : ∀ᵐ ω ∂μ, F ω < ⊤ := ae_lt_top hFm hFtop
  set G : (S → E) → ℝ := fun ω ↦ (F ω).toReal with hGdef
  have hGmI : Measurable[invariantEvents Θ] G := ENNReal.measurable_toReal.comp hFmeas
  have hGint : Integrable G μ := integrable_toReal_of_lintegral_ne_top hFm.aemeasurable hFtop
  have hGtot : ∫ ω, G ω ∂μ = 1 := by
    rw [hGdef, integral_toReal hFm.aemeasurable hFlt, hlint, ENNReal.toReal_one]
  have hgint : Integrable (⇑g) μ := lp.integrable_of_measurable hgm μ
  have hGg : Integrable (fun ω ↦ G ω * ⇑g ω) μ :=
    hGint.mul_bdd hgm.aestronglyMeasurable (c := ‖g‖)
      (Filter.Eventually.of_forall fun ω ↦ lp.norm_apply_le_norm ENNReal.top_ne_zero g ω)
  have hpull : ∫ ω, ⇑g ω ∂ρ = ∫ ω, G ω * ⇑g ω ∂μ := by
    rw [hFeq, integral_withDensity_eq_integral_toReal_smul hFm hFlt]
    rfl
  rw [hpull]
  calc ∫ ω, G ω * ⇑g ω ∂μ
      = ∫ ω, (μ[fun ω ↦ G ω * ⇑g ω | invariantEvents Θ]) ω ∂μ := (integral_condExp hm).symm
    _ = ∫ ω, (G * (μ[⇑g | invariantEvents Θ])) ω ∂μ :=
        integral_congr_ae (condExp_mul_of_stronglyMeasurable_left
          hGmI.stronglyMeasurable hGg hgint)
    _ = ∫ ω, G ω * c ∂μ :=
        integral_congr_ae (by filter_upwards [hc] with ω hω; simp [hω])
    _ = c := by rw [integral_mul_const, hGtot, one_mul]

/-- Each term of a uniform mixture of `N + 1` measures is absolutely continuous with respect to
the mixture. -/
lemma absolutelyContinuous_uniform_mixture (ρ : Fin (N + 1) → Measure (S → E)) (m : Fin (N + 1)) :
    ρ m ≪ ∑ k : Fin (N + 1), ((N : ℝ≥0∞) + 1)⁻¹ • ρ k := by
  have hne : ((N : ℝ≥0∞) + 1) ≠ 0 := by positivity
  have hnt : ((N : ℝ≥0∞) + 1) ≠ ⊤ := by finiteness
  refine Measure.absolutelyContinuous_of_le_smul (c := (N : ℝ≥0∞) + 1) (Measure.le_iff.2 ?_)
  intro A _
  rw [Measure.smul_apply, smul_eq_mul, Measure.finsetSum_apply, Finset.mul_sum]
  refine le_trans ?_ (Finset.single_le_sum (f := fun k ↦ ((N : ℝ≥0∞) + 1) *
    (((N : ℝ≥0∞) + 1)⁻¹ • ρ k) A) (fun k _ ↦ zero_le) (Finset.mem_univ m))
  rw [Measure.smul_apply, smul_eq_mul, ← mul_assoc, ENNReal.mul_inv_cancel hne hnt, one_mul]

/-- **Georgii, the proof of Lemma (16.20)(i) ⇒ (ii).** If `N + 1` random fields `ρ_m ∈ 𝓟_Θ`, all
absolutely continuous with respect to a `μ ∈ 𝓟_Θ`, have a nonsingular matrix of expectations
`(ρ_m(f_n))_{0 ≤ m,n ≤ N}`, then the invariant means of `μ` are nondegenerate: no `μ(f_a | 𝓘)`,
`a ≠ 0`, is `μ`-a.s. constant. -/
theorem hasNondegenerateInvariantMeans_of_det_ne_zero [Countable Θ]
    {μ : Measure (S → E)} [IsProbabilityMeasure μ] (hμ : μ ∈ invariantFields Θ)
    {f : Fin N → lp (fun _ : S → E ↦ ℝ) ∞} (hf : ∀ n, Measurable ⇑(f n))
    {ρ : Fin (N + 1) → Measure (S → E)} (hρ : ∀ m, ρ m ∈ invariantFields Θ)
    (hac : ∀ m, ρ m ≪ μ) (hdet : (observableMatrix f ρ).det ≠ 0) :
    HasNondegenerateInvariantMeans Θ μ f := by
  rw [hasNondegenerateInvariantMeans_iff]
  intro a ha hconst
  have hcm : ∀ m, ∫ ω, ⇑(combo f a) ω ∂(ρ m) = ∫ ω, ⇑(combo f a) ω ∂μ := fun m ↦
    integral_eq_of_condExp_invariantEvents_ae_eq_const hμ (hρ m) (hac m)
      (measurable_combo hf a) hconst
  set c : ℝ := ∫ ω, ⇑(combo f a) ω ∂μ with hcdef
  set b : Fin (N + 1) → ℝ := Fin.cases (-c) a with hbdef
  have hmulvec : Matrix.mulVec (observableMatrix f ρ) b = 0 := by
    funext m
    have hpm : IsProbabilityMeasure (ρ m) := (hρ m).1
    have hexp : ∑ n : Fin (N + 1), observableVector f (ρ m) n * b n = 0 := by
      rw [Fin.sum_univ_succ]
      simp only [hbdef, Fin.cases_zero, Fin.cases_succ, observableVector_zero,
        observableVector_succ, one_mul]
      have : ∑ n : Fin N, (∫ ω, ⇑(f n) ω ∂(ρ m)) * a n = c := by
        rw [← hcm m, integral_combo hf a (ρ m)]
        exact Finset.sum_congr rfl fun n _ ↦ mul_comm _ _
      rw [this, neg_add_cancel]
    simpa [Matrix.mulVec_apply, dotProduct, observableMatrix] using hexp
  have hb : b = 0 := Matrix.eq_zero_of_mulVec_eq_zero hdet hmulvec
  refine ha (funext fun n ↦ ?_)
  have := congrFun hb n.succ
  simpa [hbdef] using this

/-- **Georgii Lemma (16.20).** `{f₁, …, f_N}` is a discriminating system for `𝒢_Θ(γ)` — Georgii's
`Φ ≪ {f₁, …, f_N}` — if and only if some `μ ∈ 𝒢_Θ(γ)` has nondegenerate invariant means,
`μ(f_a)² < μ(μ(f_a | 𝓘)²)` for every `a ≠ 0`.

Georgii states this for `γ = γ^Φ` with `Φ ∈ ℬ_Θ` and `Θ` the shift group of `ℤ^d`. The proof uses
only that `𝒢_Θ(γ)` is convex and stable under conditioning on invariant events of positive
probability, i.e. Theorems (14.5)(b) and (14.15)(b), so it is stated here for an arbitrary
specification `γ` and an arbitrary countable group `Θ` of transformations moving every finite
volume off itself.

The proof of `(ii) ⇒ (i)` given here differs from Georgii's: instead of approximating the
countably generated σ-algebra `σ(f̃₁, …, f̃_N) ⊆ 𝓘` by finite subalgebras, it observes that the
conditional measures `μ(· | A)`, `A ∈ 𝓘`, already exhaust the linear span in question — a linear
functional vanishing on all of `{(ρ(f₀), …, ρ(f_N)) : ρ ∈ 𝒢_Θ(γ)}` forces `∫_A (μ(f_a|𝓘) + b₀) = 0`
for every `A ∈ 𝓘`, hence `μ(f_a|𝓘) = −b₀` almost surely. -/
theorem isDiscriminating_invariantG_iff [Countable S] [StandardBorelSpace E] [Countable Θ]
    (hΘ : ∀ Λ : Finset S, ∃ τ ∈ Θ, Disjoint (τ.sites ⁻¹' (Λ : Set S)) (Λ : Set S))
    {γ : Specification S E} {f : Fin N → lp (fun _ : S → E ↦ ℝ) ∞}
    (hf : ∀ n, Measurable ⇑(f n)) :
    IsDiscriminating (invariantG γ Θ) f ↔
      ∃ μ ∈ invariantG γ Θ, HasNondegenerateInvariantMeans Θ μ f := by
  have hm : invariantEvents Θ ≤ (inferInstance : MeasurableSpace (S → E)) :=
    MeasurableSpace.smulInvariants_le
  constructor
  · -- (i) ⇒ (ii): the uniform mixture of the `N + 1` discriminating Gibbs measures works.
    rintro ⟨ρ, hρ, hdet⟩
    have hne : ((N : ℝ≥0∞) + 1) ≠ 0 := by positivity
    have hnt : ((N : ℝ≥0∞) + 1) ≠ ⊤ := by finiteness
    set μ : Measure (S → E) := ∑ m : Fin (N + 1), ((N : ℝ≥0∞) + 1)⁻¹ • ρ m with hμdef
    have hsum : ∑ _m : Fin (N + 1), ((N : ℝ≥0∞) + 1)⁻¹ = 1 := by
      rw [Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul]
      push_cast
      exact ENNReal.mul_inv_cancel hne hnt
    have hμG : μ ∈ invariantG γ Θ := sum_smul_mem_invariantG hρ hsum
    have hμp : IsProbabilityMeasure μ := hμG.1.1
    exact ⟨μ, hμG, hasNondegenerateInvariantMeans_of_det_ne_zero hμG.2 hf (fun m ↦ (hρ m).2)
      (absolutelyContinuous_uniform_mixture ρ) hdet⟩
  · -- (ii) ⇒ (i)
    rintro ⟨μ, hμG, hnd⟩
    have hμp : IsProbabilityMeasure μ := hμG.1.1
    rw [isDiscriminating_iff_span_eq_top]
    by_contra hspan
    obtain ⟨φ, hφ, hker⟩ :=
      Submodule.exists_le_ker_of_lt_top _ (lt_top_iff_ne_top.2 hspan)
    set b : Fin (N + 1) → ℝ := fun n ↦ φ (fun j ↦ if n = j then 1 else 0) with hbdef
    have hφb : ∀ v : Fin (N + 1) → ℝ, φ v = ∑ n, v n * b n := fun v ↦ by
      rw [LinearMap.pi_apply_eq_sum_univ φ v]
      exact Finset.sum_congr rfl fun n _ ↦ by rw [smul_eq_mul]
    have hvanish : ∀ ρ ∈ invariantG γ Θ, ∑ n, observableVector f ρ n * b n = 0 := by
      intro ρ hρ
      rw [← hφb]
      exact hker (Submodule.subset_span ⟨ρ, hρ, rfl⟩)
    set a : Fin N → ℝ := fun n ↦ b n.succ with hadef
    have hkey : ∀ ρ ∈ invariantG γ Θ, ∫ ω, ⇑(combo f a) ω ∂ρ = -b 0 := by
      intro ρ hρ
      have hpm : IsProbabilityMeasure ρ := hρ.1.1
      have h := hvanish ρ hρ
      rw [Fin.sum_univ_succ] at h
      simp only [observableVector_zero, observableVector_succ, one_mul] at h
      rw [integral_combo hf a ρ]
      have : ∑ n : Fin N, a n * ∫ ω, ⇑(f n) ω ∂ρ
          = ∑ n : Fin N, (∫ ω, ⇑(f n) ω ∂ρ) * b n.succ :=
        Finset.sum_congr rfl fun n _ ↦ mul_comm _ _
      rw [this]
      linarith
    have ha : a ≠ 0 := by
      intro ha0
      have hb0 : b 0 = 0 := by
        have h := hvanish μ hμG
        rw [Fin.sum_univ_succ] at h
        simp only [observableVector_zero, observableVector_succ, one_mul] at h
        have hz : ∀ n : Fin N, (∫ ω, ⇑(f n) ω ∂μ) * b n.succ = 0 := fun n ↦ by
          have : b n.succ = 0 := congrFun ha0 n
          rw [this, mul_zero]
        rw [Finset.sum_congr rfl fun n _ ↦ hz n, Finset.sum_const_zero, add_zero] at h
        exact h
      refine hφ (LinearMap.ext fun v ↦ ?_)
      rw [hφb v, LinearMap.zero_apply]
      refine Finset.sum_eq_zero fun n _ ↦ ?_
      refine mul_eq_zero_of_right _ ?_
      refine Fin.cases ?_ ?_ n
      · exact hb0
      · exact fun n ↦ congrFun ha0 n
    have hgint : Integrable (⇑(combo f a)) μ :=
      lp.integrable_of_measurable (measurable_combo hf a) μ
    have hae : (μ[⇑(combo f a) | invariantEvents Θ]) =ᵐ[μ] fun _ ↦ -b 0 := by
      refine ae_eq_of_forall_setIntegral_eq_of_sigmaFinite' hm
        (fun s _ _ ↦ integrable_condExp.integrableOn)
        (fun s _ _ ↦ (integrable_const _).integrableOn) (fun s hs _ ↦ ?_)
        stronglyMeasurable_condExp.aestronglyMeasurable aestronglyMeasurable_const
      rw [setIntegral_condExp hm hgint hs, setIntegral_const]
      by_cases hs0 : μ s = 0
      · rw [Measure.restrict_eq_zero.2 hs0, integral_zero_measure]
        simp [measureReal_def, hs0]
      · have hcond := hkey _ (cond_mem_invariantG hΘ hμG hs hs0)
        rw [ProbabilityTheory.cond, integral_smul_measure, ENNReal.toReal_inv,
          smul_eq_mul] at hcond
        have hstop : (μ s).toReal ≠ 0 := by
          simp [ENNReal.toReal_eq_zero_iff, hs0, measure_ne_top μ s]
        field_simp at hcond
        rw [hcond, measureReal_def, smul_eq_mul]
        ring
    have hmean : ∫ ω, ⇑(combo f a) ω ∂μ = -b 0 := hkey μ hμG
    exact (hasNondegenerateInvariantMeans_iff.1 hnd a ha) (by rw [hmean]; exact hae)

end Lemma1620

/-! ### The variance of `μ(f_a | 𝓘)` as a quadratic form in `a` -/

section InvariantVariance

variable {S E : Type*} [MeasurableSpace E] {N : ℕ} {Θ : Subgroup (Transformation S E)}
  {μ : Measure (S → E)} [IsProbabilityMeasure μ]
  {f : Fin N → lp (fun _ : S → E ↦ ℝ) ∞}

/-- **Georgii (16.20)(ii), left-hand side:** `μ(μ(f_a | 𝓘)²) − μ(f_a)²`, the variance of the
conditional expectation of `f_a = ∑ a_n f_n` given the invariant σ-algebra, as a function of
`a ∈ ℝ^N`. It is a quadratic form in `a`
(`MeasureTheory.GibbsMeasure.invariantVariance_eq_sum`), hence continuous. -/
def invariantVariance (Θ : Subgroup (Transformation S E)) (μ : Measure (S → E))
    (f : Fin N → lp (fun _ : S → E ↦ ℝ) ∞) (a : Fin N → ℝ) : ℝ :=
  (∫ ω, ((μ[⇑(combo f a) | invariantEvents Θ]) ω) ^ 2 ∂μ) - (∫ ω, ⇑(combo f a) ω ∂μ) ^ 2

omit [IsProbabilityMeasure μ] in
lemma hasNondegenerateInvariantMeans_iff_invariantVariance_pos :
    HasNondegenerateInvariantMeans Θ μ f ↔ ∀ a : Fin N → ℝ, a ≠ 0 → 0 < invariantVariance Θ μ f a :=
  forall_congr' fun a ↦ forall_congr' fun _ ↦ by rw [invariantVariance, sub_pos]

/-- The conditional expectation given `𝓘` of `f_a = ∑ a_n f_n` is `∑ a_n μ(f_n | 𝓘)`. -/
lemma condExp_combo (hf : ∀ n, Measurable ⇑(f n)) (a : Fin N → ℝ) :
    (μ[⇑(combo f a) | invariantEvents Θ]) =ᵐ[μ]
      fun ω ↦ ∑ n, a n * (μ[⇑(f n) | invariantEvents Θ]) ω := by
  have hfun : ⇑(combo f a) = ∑ n, a n • ⇑(f n) := by
    funext ω; simp [coeFn_combo]
  rw [hfun]
  refine ((condExp_finsetSum (fun n _ ↦
    ((lp.integrable_of_measurable (hf n) μ).smul (a n))) (invariantEvents Θ))).trans ?_
  have hsm : ∀ n : Fin N, (μ[a n • ⇑(f n) | invariantEvents Θ]) =ᵐ[μ]
      a n • (μ[⇑(f n) | invariantEvents Θ]) := fun n ↦ condExp_smul _ _ _
  filter_upwards [ae_all_iff.2 hsm] with ω hω
  simp only [Finset.sum_apply, hω, Pi.smul_apply, smul_eq_mul]

omit [IsProbabilityMeasure μ] in
/-- The conditional expectation of a bounded observable given `𝓘` is bounded by the same
constant. -/
lemma ae_abs_condExp_le_norm (g : lp (fun _ : S → E ↦ ℝ) ∞) :
    ∀ᵐ ω ∂μ, |(μ[⇑g | invariantEvents Θ]) ω| ≤ ‖g‖ :=
  ae_bdd_norm_condExp_of_ae_bdd_norm
    (Filter.Eventually.of_forall fun ω ↦ lp.norm_apply_le_norm ENNReal.top_ne_zero g ω)

/-- **Georgii (16.20)(ii) as a quadratic form.** The variance of `μ(f_a | 𝓘)` is the quadratic
form in `a` with matrix `Cov(μ(f_m | 𝓘), μ(f_n | 𝓘))`. -/
lemma invariantVariance_eq_sum (hf : ∀ n, Measurable ⇑(f n)) (a : Fin N → ℝ) :
    invariantVariance Θ μ f a = ∑ p : Fin N × Fin N, a p.1 * a p.2 *
      ((∫ ω, (μ[⇑(f p.1) | invariantEvents Θ]) ω * (μ[⇑(f p.2) | invariantEvents Θ]) ω ∂μ)
        - (∫ ω, ⇑(f p.1) ω ∂μ) * (∫ ω, ⇑(f p.2) ω ∂μ)) := by
  have hm : invariantEvents Θ ≤ (inferInstance : MeasurableSpace (S → E)) :=
    MeasurableSpace.smulInvariants_le
  have hcemeas : ∀ n : Fin N, AEStronglyMeasurable (μ[⇑(f n) | invariantEvents Θ]) μ :=
    fun n ↦ (stronglyMeasurable_condExp.mono hm).aestronglyMeasurable
  have hint : ∀ p : Fin N × Fin N, Integrable
      (fun ω ↦ (μ[⇑(f p.1) | invariantEvents Θ]) ω * (μ[⇑(f p.2) | invariantEvents Θ]) ω) μ :=
    fun p ↦ Integrable.bdd_mul (c := ‖f p.1‖) integrable_condExp (hcemeas p.1)
      ((ae_abs_condExp_le_norm (Θ := Θ) (f p.1)).mono fun ω hω ↦ by
        simpa [Real.norm_eq_abs] using hω)
  have hsq : ∫ ω, ((μ[⇑(combo f a) | invariantEvents Θ]) ω) ^ 2 ∂μ
      = ∑ p : Fin N × Fin N, a p.1 * a p.2 *
        ∫ ω, (μ[⇑(f p.1) | invariantEvents Θ]) ω * (μ[⇑(f p.2) | invariantEvents Θ]) ω ∂μ := by
    rw [integral_congr_ae ((condExp_combo hf a).mono fun ω hω ↦ by rw [hω])]
    have hexp : ∀ ω, (∑ n, a n * (μ[⇑(f n) | invariantEvents Θ]) ω) ^ 2
        = ∑ p : Fin N × Fin N, a p.1 * a p.2 *
          ((μ[⇑(f p.1) | invariantEvents Θ]) ω * (μ[⇑(f p.2) | invariantEvents Θ]) ω) := by
      intro ω
      rw [sq, Finset.sum_mul_sum, Fintype.sum_prod_type]
      exact Finset.sum_congr rfl fun m _ ↦ Finset.sum_congr rfl fun n _ ↦ by ring
    simp_rw [hexp]
    rw [integral_finsetSum _ fun p _ ↦ (hint p).const_mul _]
    exact Finset.sum_congr rfl fun p _ ↦ integral_const_mul _ _
  have hmean : (∫ ω, ⇑(combo f a) ω ∂μ) ^ 2
      = ∑ p : Fin N × Fin N, a p.1 * a p.2 *
        ((∫ ω, ⇑(f p.1) ω ∂μ) * (∫ ω, ⇑(f p.2) ω ∂μ)) := by
    rw [integral_combo hf a, sq, Finset.sum_mul_sum, Fintype.sum_prod_type]
    exact Finset.sum_congr rfl fun m _ ↦ Finset.sum_congr rfl fun n _ ↦ by ring
  rw [invariantVariance, hsq, hmean, ← Finset.sum_sub_distrib]
  exact Finset.sum_congr rfl fun p _ ↦ by ring

/-- The variance of `μ(f_a | 𝓘)` is a continuous function of `a`. -/
lemma continuous_invariantVariance (hf : ∀ n, Measurable ⇑(f n)) :
    Continuous (invariantVariance Θ μ f) := by
  simp_rw [funext (invariantVariance_eq_sum hf)]
  fun_prop

omit [IsProbabilityMeasure μ] in
/-- The variance of `μ(f_a | 𝓘)` is homogeneous of degree `2` in `a`. -/
lemma invariantVariance_smul (t : ℝ) (a : Fin N → ℝ) :
    invariantVariance Θ μ f (t • a) = t ^ 2 * invariantVariance Θ μ f a := by
  have hcombo : combo f (t • a) = t • combo f a := by
    rw [combo, combo, Finset.smul_sum]
    exact Finset.sum_congr rfl fun n _ ↦ by rw [Pi.smul_apply, smul_eq_mul, smul_smul]
  have hco : ⇑(combo f (t • a)) = fun ω ↦ t * ⇑(combo f a) ω := by
    rw [hcombo]; exact lp.coeFn_smul t (combo f a)
  have hce : (μ[⇑(combo f (t • a)) | invariantEvents Θ]) =ᵐ[μ]
      fun ω ↦ t * (μ[⇑(combo f a) | invariantEvents Θ]) ω := by
    have h : ⇑(combo f (t • a)) = t • ⇑(combo f a) := by
      rw [hcombo]; exact lp.coeFn_smul t (combo f a)
    rw [h]
    exact (condExp_smul t _ _).mono fun ω hω ↦ hω
  have hint1 : ∫ ω, ((μ[⇑(combo f (t • a)) | invariantEvents Θ]) ω) ^ 2 ∂μ
      = t ^ 2 * ∫ ω, ((μ[⇑(combo f a) | invariantEvents Θ]) ω) ^ 2 ∂μ := by
    rw [integral_congr_ae (hce.mono fun ω hω ↦ by rw [hω])]
    simp_rw [mul_pow]
    rw [integral_const_mul]
  have hint2 : ∫ ω, ⇑(combo f (t • a)) ω ∂μ = t * ∫ ω, ⇑(combo f a) ω ∂μ := by
    rw [hco]; exact integral_const_mul t _
  rw [invariantVariance, invariantVariance, hint1, hint2, mul_pow]
  ring

omit [MeasurableSpace E] [IsProbabilityMeasure μ] in
lemma combo_smul (t : ℝ) (a : Fin N → ℝ) : combo f (t • a) = t • combo f a := by
  rw [combo, combo, Finset.smul_sum]
  exact Finset.sum_congr rfl fun n _ ↦ by rw [Pi.smul_apply, smul_eq_mul, smul_smul]

omit [MeasurableSpace E] [IsProbabilityMeasure μ] in
lemma continuous_combo : Continuous fun a : Fin N → ℝ ↦ combo f a := by
  refine continuous_finsetSum _ fun n _ ↦ ?_
  exact (continuous_apply n).smul continuous_const

/-- **Georgii, in the proof of Theorem (16.21): the uniform gap.** If `μ(f_a)² < μ(μ(f_a | 𝓘)²)`
for every `a ≠ 0`, then for every constant `K` there is a single `ε ∈ ]0, 1[` with
`ε K ‖f_a‖² < μ(μ(f_a | 𝓘)²) − μ(f_a)²` for *all* `a ≠ 0` simultaneously.

Georgii takes `K = 4 |Λ₀|`. Both sides are homogeneous of degree `2` in `a`, so it is enough to
compare them on the unit sphere of `ℝ^N`, which is compact; the variance is continuous because it
is a quadratic form in `a`. -/
theorem exists_pos_lt_one_forall_lt_invariantVariance (hf : ∀ n, Measurable ⇑(f n))
    (hnd : HasNondegenerateInvariantMeans Θ μ f) (K : ℝ) :
    ∃ ε : ℝ, 0 < ε ∧ ε < 1 ∧ ∀ a : Fin N → ℝ, a ≠ 0 →
      ε * (K * ‖combo f a‖ ^ 2) < invariantVariance Θ μ f a := by
  set S : Set (Fin N → ℝ) := Metric.sphere 0 1 with hS
  set W : (Fin N → ℝ) → ℝ := fun a ↦ K * ‖combo f a‖ ^ 2 with hW
  have hWcont : Continuous W := by
    refine continuous_const.mul (Continuous.pow ?_ 2)
    exact continuous_combo.norm
  have hVpos : ∀ a ∈ S, 0 < invariantVariance Θ μ f a := by
    intro a ha
    refine hasNondegenerateInvariantMeans_iff_invariantVariance_pos.1 hnd a fun h ↦ ?_
    rw [hS, mem_sphere_iff_norm, sub_zero, h] at ha
    simp at ha
  obtain ⟨v, hv0, hvle⟩ := (isCompact_sphere (0 : Fin N → ℝ) 1).exists_forall_le'
    (continuous_invariantVariance hf).continuousOn hVpos
  obtain ⟨w, hw⟩ := (isCompact_sphere (0 : Fin N → ℝ) 1).exists_bound_of_continuousOn
    hWcont.continuousOn
  set w' : ℝ := max w 0 with hw'
  have hw'0 : 0 ≤ w' := le_max_right _ _
  have hWle : ∀ a ∈ S, W a ≤ w' := fun a ha ↦
    ((le_abs_self _).trans (by simpa [Real.norm_eq_abs] using hw a ha)).trans (le_max_left _ _)
  refine ⟨min (v / (2 * (w' + 1))) (1 / 2), lt_min (by positivity) (by norm_num),
    (min_le_right _ _).trans_lt (by norm_num), ?_⟩
  set ε : ℝ := min (v / (2 * (w' + 1))) (1 / 2) with hε
  have hε0 : 0 < ε := lt_min (by positivity) (by norm_num)
  have hsphere : ∀ a ∈ S, ε * W a < invariantVariance Θ μ f a := by
    intro a ha
    have h1 : ε * W a ≤ ε * w' := mul_le_mul_of_nonneg_left (hWle a ha) hε0.le
    have h2 : ε * w' ≤ (v / (2 * (w' + 1))) * w' :=
      mul_le_mul_of_nonneg_right (min_le_left _ _) hw'0
    have h3 : (v / (2 * (w' + 1))) * w' < v := by
      rw [div_mul_eq_mul_div, div_lt_iff₀ (by positivity)]
      nlinarith
    exact lt_of_le_of_lt (h1.trans h2) (h3.trans_le (hvle a ha))
  intro a ha
  have hanorm : 0 < ‖a‖ := norm_pos_iff.2 ha
  set b : (Fin N → ℝ) := ‖a‖⁻¹ • a with hb
  have hbS : b ∈ S := by
    rw [hS, mem_sphere_iff_norm, sub_zero, hb, norm_smul, norm_inv, norm_norm,
      inv_mul_cancel₀ hanorm.ne']
  have hab : a = ‖a‖ • b := by rw [hb, smul_smul, mul_inv_cancel₀ hanorm.ne', one_smul]
  have hV : invariantVariance Θ μ f a = ‖a‖ ^ 2 * invariantVariance Θ μ f b := by
    conv_lhs => rw [hab]
    rw [invariantVariance_smul]
  have hWa : W a = ‖a‖ ^ 2 * W b := by
    change K * ‖combo f a‖ ^ 2 = ‖a‖ ^ 2 * (K * ‖combo f b‖ ^ 2)
    conv_lhs => rw [hab]
    rw [combo_smul, norm_smul, norm_norm, mul_pow]
    ring
  have hgoal : ε * W a < invariantVariance Θ μ f a := by
    rw [hV, hWa, ← mul_assoc, mul_comm ε (‖a‖ ^ 2), mul_assoc]
    exact mul_lt_mul_of_pos_left (hsphere b hbS) (by positivity)
  exact hgoal

end InvariantVariance

/-! ### Local observables and shifts -/

section LocalShift

variable {S E : Type*} [MeasurableSpace E] [AddCommGroup S]

/-- The shift `θ_i` turns an `𝓕_Λ`-measurable bounded observable into an
`𝓕_{Λ − i}`-measurable one: `f ∘ θ_i ∈ 𝓛_{Λ − i}` for `f ∈ 𝓛_Λ`. -/
lemma precomp_shift_mem_localFunctionsOn {Λ : Finset S} {g : lp (fun _ : S → E ↦ ℝ) ∞}
    (hg : g ∈ localFunctionsOn S E Λ) (i : S) :
    lp.precomp (shift E i).toFun g ∈ localFunctionsOn S E (Potential.translate Λ (-i)) := by
  rw [mem_localFunctionsOn] at hg ⊢
  have him : ((· - i) '' (Λ : Set S)) = ((Potential.translate Λ (-i) : Finset S) : Set S) := by
    ext x
    simp only [Set.mem_image, Finset.mem_coe, Potential.mem_translate, sub_neg_eq_add]
    exact ⟨by rintro ⟨y, hy, rfl⟩; simpa using hy, fun hx ↦ ⟨x + i, hx, by abel⟩⟩
  have hcomp : Measurable[(cylinderEvents (X := fun _ : S ↦ E) (Λ : Set S)).comap
      (shift E i).toFun] (⇑g ∘ (shift E i).toFun) :=
    hg.comp (Measurable.of_comap_le le_rfl)
  rwa [cylinderEvents_comap_shift, him] at hcomp

end LocalShift

/-! ### Georgii's spaces `ℬ_Θ(f₁, …, f_N)` (§16.3, before Theorem (16.21))

Georgii fixes a cube `Λ₀` with `f₁, …, f_N ∈ 𝓛_{Λ₀}`, sets `Λ_i = Λ₀ ∪ (Λ₀ − i)` for `i ≠ 0`, and
defines `ℬ_Θ(f₁, …, f_N)` by three conditions on the interaction terms: `Φ_{Λ₀}` is a linear
combination of the `f_n`, `Φ_{Λ_i}` is a linear combination of the `f_m (f_n ∘ θ_i)`, and `Φ_A = 0`
if `A` is not a translate of some `Λ_i`. He then observes that this space *is* the closed linear
span of the potentials `Φ^{(Λ₀, f_n)}` and `Φ^{(Λ_i, f_m (f_n ∘ θ_i))}` of Lemma (16.10), and it is
that description which is taken as the definition here — it is the one his proofs use, and it
makes closedness, convexity and the cone property immediate.

The set `I` of admissible `i ≠ 0` is a parameter: `I = {0}ᶜ` is Georgii's `ℬ_Θ(f₁, …, f_N)`,
`I = {i ≠ 0 : R ≤ diam Λ_i}` is his `ℬ^R_Θ(f₁, …, f_N)` of Comment (16.24)(1), and a symmetric
infinite `I ⊆ S` gives his `ℬ^I_Θ(f)` of Theorem (16.30). -/

section OrderSubspace

variable {ι E : Type*} [MeasurableSpace E] {N : ℕ}

open Potential

open scoped Classical in
/-- **Georgii Lemma (16.10)** as a map into the Banach space `ℬ_Θ`: `Φ^{(Λ,g)}` when `Λ` is
nonempty and `g ∈ 𝓛_Λ`, and the zero potential otherwise (so that the definition carries no proof
obligation). -/
def localPotentialB (Λ : Finset (ι → ℤ)) (g : lp (fun _ : (ι → ℤ) → E ↦ ℝ) ∞) :
    BTheta (ι → ℤ) E :=
  if h : Λ.Nonempty ∧ g ∈ localFunctionsOn (ι → ℤ) E Λ then
    ⟨localPotential Λ g, localPotential_mem_BTheta h.1 h.2⟩
  else 0

variable {Λ : Finset (ι → ℤ)} {g : lp (fun _ : (ι → ℤ) → E ↦ ℝ) ∞}

lemma coe_localPotentialB (hΛ : Λ.Nonempty) (hg : g ∈ localFunctionsOn (ι → ℤ) E Λ) :
    (localPotentialB Λ g : Potential (ι → ℤ) E) = localPotential Λ g := by
  classical
  rw [localPotentialB, dite_eq_left ⟨hΛ, hg⟩]

/-- **Georgii Lemma (16.10):** `‖Φ^{(Λ,g)}‖₀ = |Λ| ‖g‖`. -/
lemma norm_localPotentialB (hΛ : Λ.Nonempty) (hg : g ∈ localFunctionsOn (ι → ℤ) E Λ) :
    ‖localPotentialB Λ g‖ = #Λ * ‖g‖ := by
  rw [BTheta.norm_def, coe_localPotentialB hΛ hg, normAt_localPotential hΛ,
    ENNReal.toReal_mul, ENNReal.toReal_natCast, ENNReal.toReal_ofReal (norm_nonneg g)]

/-- **Georgii Lemma (16.10):** `⟨μ, Φ^{(Λ,g)}⟩ = μ(g)` for a shift-invariant `μ`. -/
lemma specificEnergy_localPotentialB (hΛ : Λ.Nonempty) (hg : g ∈ localFunctionsOn (ι → ℤ) E Λ)
    {μ : Measure ((ι → ℤ) → E)} [IsProbabilityMeasure μ]
    (hμ : μ ∈ invariantFields (shiftGroup (ι → ℤ) E)) :
    (localPotentialB Λ g : Potential (ι → ℤ) E).specificEnergy μ = ∫ ω, ⇑g ω ∂μ := by
  rw [coe_localPotentialB hΛ hg]
  exact specificEnergy_localPotential hΛ hg (mem_invariantFields_shiftGroup.1 hμ).2

/-- `g ↦ Φ^{(Λ,g)}` is linear on `𝓛_Λ`. -/
lemma localPotentialB_sum_smul {J : Type*} [Fintype J] (hΛ : Λ.Nonempty) (c : J → ℝ)
    (u : J → lp (fun _ : (ι → ℤ) → E ↦ ℝ) ∞) (hu : ∀ j, u j ∈ localFunctionsOn (ι → ℤ) E Λ) :
    localPotentialB Λ (∑ j, c j • u j) = ∑ j, c j • localPotentialB Λ (u j) := by
  have hmem : (∑ j, c j • u j) ∈ localFunctionsOn (ι → ℤ) E Λ :=
    Subalgebra.sum_mem _ fun j _ ↦ Subalgebra.smul_mem _ (hu j) _
  refine Subtype.ext ?_
  rw [coe_localPotentialB hΛ hmem]
  have : ((∑ j, c j • localPotentialB Λ (u j) : BTheta (ι → ℤ) E) : Potential (ι → ℤ) E)
      = ∑ j, c j • ((localPotentialB Λ (u j) : BTheta (ι → ℤ) E) : Potential (ι → ℤ) E) := by
    simp
  rw [this, Finset.sum_congr rfl fun j _ ↦
    congrArg (c j • ·) (coe_localPotentialB hΛ (hu j))]
  rw [← localPotentialₗ_apply, map_sum]
  exact Finset.sum_congr rfl fun j _ ↦ by
    rw [_root_.map_smul, localPotentialₗ_apply]

section Lattice

variable [Fintype ι] [DecidableEq ι]

variable {Λ₀ : Finset (ι → ℤ)} {f : Fin N → lp (fun _ : (ι → ℤ) → E ↦ ℝ) ∞} {I : Set (ι → ℤ)}

/-- **Georgii's volumes `Λ_i = Λ₀ ∪ (Λ₀ − i)`** (§16.3, before Theorem (16.21)). -/
def pairVolume (Λ₀ : Finset (ι → ℤ)) (i : ι → ℤ) : Finset (ι → ℤ) := Λ₀ ∪ translate Λ₀ (-i)

omit [DecidableEq ι] in
lemma pairVolume_nonempty (hΛ₀ : Λ₀.Nonempty) (i : ι → ℤ) : (pairVolume Λ₀ i).Nonempty :=
  hΛ₀.mono Finset.subset_union_left

omit [DecidableEq ι] in
/-- `|Λ_i| ≤ 2 |Λ₀|`, the estimate used in Georgii (16.22). -/
lemma card_pairVolume_le (Λ₀ : Finset (ι → ℤ)) (i : ι → ℤ) : #(pairVolume Λ₀ i) ≤ 2 * #Λ₀ := by
  refine (Finset.card_union_le _ _).trans ?_
  rw [Potential.translate, Finset.card_map, two_mul]

/-- The observable `f_m (f_n ∘ θ_i)` of Georgii's condition (ii) on `ℬ_Θ(f₁, …, f_N)`. -/
def pairObservable (f : Fin N → lp (fun _ : (ι → ℤ) → E ↦ ℝ) ∞) (i : ι → ℤ)
    (p : Fin N × Fin N) : lp (fun _ : (ι → ℤ) → E ↦ ℝ) ∞ :=
  f p.1 * lp.precomp (shift E i).toFun (f p.2)

omit [DecidableEq ι] in
lemma pairObservable_mem_localFunctionsOn (hf : ∀ n, f n ∈ localFunctionsOn (ι → ℤ) E Λ₀)
    (i : ι → ℤ) (p : Fin N × Fin N) :
    pairObservable f i p ∈ localFunctionsOn (ι → ℤ) E (pairVolume Λ₀ i) :=
  Subalgebra.mul_mem _ (localFunctionsOn_mono Finset.subset_union_left (hf p.1))
    (localFunctionsOn_mono Finset.subset_union_right
      (precomp_shift_mem_localFunctionsOn (hf p.2) i))

variable (Λ₀ f I) in
/-- The potentials generating Georgii's space `ℬ_Θ(f₁, …, f_N)`: `Φ^{(Λ₀, f_n)}` for `1 ≤ n ≤ N`
and `Φ^{(Λ_i, f_m (f_n ∘ θ_i))}` for `i ∈ I` and `1 ≤ m, n ≤ N`. -/
def orderGenerators : Set (BTheta (ι → ℤ) E) :=
  {Φ | (∃ n, Φ = localPotentialB Λ₀ (f n)) ∨
    ∃ i ∈ I, ∃ p : Fin N × Fin N, Φ = localPotentialB (pairVolume Λ₀ i) (pairObservable f i p)}

variable (Λ₀ f I) in
/-- **Georgii's space `ℬ_Θ(f₁, …, f_N)`** (§16.3, before Theorem (16.21)), in his own "more
precise" description: the closed linear span in `ℬ_Θ` of the potentials `Φ^{(Λ₀, f_n)}` and
`Φ^{(Λ_i, f_m (f_n ∘ θ_i))}`, `i ∈ I`.

Georgii's `ℬ_Θ(f₁, …, f_N)` is `I = {0}ᶜ`; his `ℬ^R_Θ(f₁, …, f_N)` of Comment (16.24)(1) is
`I = {i ≠ 0 : R ≤ diam Λ_i}`; his `ℬ^I_Θ(f)` of Theorem (16.30) is a symmetric infinite `I`. -/
def BThetaOrder : Submodule ℝ (BTheta (ι → ℤ) E) :=
  (Submodule.span ℝ (orderGenerators Λ₀ f I)).topologicalClosure

omit [DecidableEq ι] in
lemma isClosed_BThetaOrder : IsClosed (BThetaOrder Λ₀ f I : Set (BTheta (ι → ℤ) E)) :=
  Submodule.isClosed_topologicalClosure _

omit [DecidableEq ι] in
lemma subset_BThetaOrder : orderGenerators Λ₀ f I ⊆ (BThetaOrder Λ₀ f I : Set (BTheta (ι → ℤ) E)) :=
  (Submodule.subset_span).trans (Submodule.le_topologicalClosure _)

omit [DecidableEq ι] in
lemma BThetaOrder_mono {I J : Set (ι → ℤ)} (h : I ⊆ J) :
    BThetaOrder Λ₀ f I ≤ BThetaOrder Λ₀ f J := by
  refine Submodule.topologicalClosure_mono (Submodule.span_mono ?_)
  rintro Φ (⟨n, rfl⟩ | ⟨i, hi, p, rfl⟩)
  · exact Or.inl ⟨n, rfl⟩
  · exact Or.inr ⟨i, h hi, p, rfl⟩

omit [DecidableEq ι] in
/-- Georgii's `Ψ⁰`, `Ψ̄⁰` of (16.22): a multiple of `Φ^{(Λ₀, f_a)}` lies in `ℬ_Θ(f₁, …, f_N)`. -/
lemma localPotentialB_smul_combo_mem (hΛ₀ : Λ₀.Nonempty)
    (hf : ∀ n, f n ∈ localFunctionsOn (ι → ℤ) E Λ₀) (c : ℝ) (a : Fin N → ℝ) :
    localPotentialB Λ₀ (c • combo f a) ∈ BThetaOrder Λ₀ f I := by
  have hsum : (c • combo f a) = ∑ n, (c * a n) • f n := by
    rw [combo, Finset.smul_sum]
    exact Finset.sum_congr rfl fun n _ ↦ smul_smul c (a n) (f n)
  rw [hsum, localPotentialB_sum_smul hΛ₀ _ _ hf]
  exact Submodule.sum_mem _ fun n _ ↦
    Submodule.smul_mem _ _ (subset_BThetaOrder (Or.inl ⟨n, rfl⟩))

omit [MeasurableSpace E] [Fintype ι] [DecidableEq ι] in
lemma precomp_combo (φ : ((ι → ℤ) → E) → ((ι → ℤ) → E)) (f : Fin N → lp (fun _ : (ι → ℤ) → E ↦ ℝ) ∞)
    (a : Fin N → ℝ) :
    lp.precomp φ (combo f a) = combo (fun n ↦ lp.precomp φ (f n)) a := by
  refine lp.ext (funext fun ω ↦ ?_)
  simp [coeFn_combo]

omit [Fintype ι] [DecidableEq ι] in
lemma combo_mul_precomp_combo (i : ι → ℤ) (f : Fin N → lp (fun _ : (ι → ℤ) → E ↦ ℝ) ∞)
    (a : Fin N → ℝ) :
    combo f a * lp.precomp (shift E i).toFun (combo f a)
      = ∑ p : Fin N × Fin N, (a p.1 * a p.2) • pairObservable f i p := by
  refine lp.ext (funext fun ω ↦ ?_)
  rw [lp.infty_coeFn_mul]
  simp only [Pi.mul_apply, lp.coeFn_sum, Finset.sum_apply, lp.coeFn_smul, Pi.smul_apply,
    smul_eq_mul, coeFn_combo, lp.coeFn_precomp, Function.comp_apply, pairObservable,
    lp.infty_coeFn_mul]
  rw [Fintype.sum_prod_type, Finset.sum_mul_sum]
  exact Finset.sum_congr rfl fun m _ ↦ Finset.sum_congr rfl fun n _ ↦ by ring

omit [DecidableEq ι] in
/-- Georgii's `Ψ^i` of (16.22): a multiple of `Φ^{(Λ_i, f_a (f_a ∘ θ_i))}` lies in
`ℬ_Θ(f₁, …, f_N)` for every `i ∈ I`. -/
lemma localPotentialB_pairVolume_smul_mem (hΛ₀ : Λ₀.Nonempty)
    (hf : ∀ n, f n ∈ localFunctionsOn (ι → ℤ) E Λ₀) {i : ι → ℤ} (hi : i ∈ I) (c : ℝ)
    (a : Fin N → ℝ) :
    localPotentialB (pairVolume Λ₀ i)
        (c • (combo f a * lp.precomp (shift E i).toFun (combo f a))) ∈ BThetaOrder Λ₀ f I := by
  have hsum : (c • (combo f a * lp.precomp (shift E i).toFun (combo f a)))
      = ∑ p : Fin N × Fin N, (c * (a p.1 * a p.2)) • pairObservable f i p := by
    rw [combo_mul_precomp_combo, Finset.smul_sum]
    exact Finset.sum_congr rfl fun p _ ↦ smul_smul c _ _
  rw [hsum, localPotentialB_sum_smul (pairVolume_nonempty hΛ₀ i) _ _
    (pairObservable_mem_localFunctionsOn hf i)]
  exact Submodule.sum_mem _ fun p _ ↦
    Submodule.smul_mem _ _ (subset_BThetaOrder (Or.inr ⟨i, hi, p, rfl⟩))

end Lattice

end OrderSubspace

/-! ### The transfer lemma behind Theorems (16.21) and (16.30) -/

section Transfer

open Potential Potential.BTheta

variable {ι E : Type*} [Fintype ι] [DecidableEq ι] [MeasurableSpace E] [StandardBorelSpace E]
  (ν : Measure E) [IsProbabilityMeasure ν]

/-- **The engine of Theorems (16.21) and (16.30).** Let `μ` be a shift-invariant random field of
finite specific entropy, `C ⊆ ℬ_Θ` a closed convex cone with vertex `0`, `Φ⁰ ∈ ℬ_Θ` and `ε > 0`.
Then there are a potential `Φ ∈ Φ⁰ + C` and a shift-invariant Gibbs measure `ρ ∈ 𝒢_Θ(Φ)` with
`ε ‖Φ − Φ⁰‖₀ ≤ 𝓀(μ|Φ⁰) = P(Φ⁰) + ⟨μ, Φ⁰⟩ − 𝓀(μ)` and `⟨ρ, Ψ⟩ ≤ ⟨μ, Ψ⟩ + ε ‖Ψ‖₀` for all `Ψ ∈ C`.

This is Proposition (16.7) applied to `L₀ = j(μ)`, which is `P`-bounded by Theorem (16.13); the
tangent functional it produces is `j(ρ)` for some `ρ ∈ 𝒢_Θ(Φ)` by Theorem (16.14). -/
theorem exists_mem_invariantG_specificEnergy_le
    {μ : Measure ((ι → ℤ) → E)} [IsProbabilityMeasure μ]
    (hμ : μ ∈ invariantFieldsOfFiniteEntropy ι E ν)
    {C : Set (BTheta (ι → ℤ) E)} (hC : IsClosed C) (hCconv : Convex ℝ C)
    (hC0 : (0 : BTheta (ι → ℤ) E) ∈ C) (hCadd : ∀ Ψ ∈ C, ∀ Χ ∈ C, Ψ + Χ ∈ C)
    (Φ₀ : BTheta (ι → ℤ) E) {ε : ℝ} (hε : 0 < ε) :
    ∃ Φ : BTheta (ι → ℤ) E, Φ - Φ₀ ∈ C ∧
      ε * ‖Φ - Φ₀‖ ≤ pressure ν Φ₀ + (Φ₀ : Potential (ι → ℤ) E).specificEnergy μ
          - (specificEntropy ν μ).toReal ∧
      ∃ ρ ∈ invariantG (gibbsSpecificationOfAbsolutelySummable
          (Φ := (Φ : Potential (ι → ℤ) E)) ν 1) (shiftGroup (ι → ℤ) E),
        ∀ Ψ ∈ C, (Ψ : Potential (ι → ℤ) E).specificEnergy ρ
          ≤ (Ψ : Potential (ι → ℤ) E).specificEnergy μ + ε * ‖Ψ‖ := by
  obtain ⟨Φ, hΦC, L, hL, hnorm, hLC⟩ :=
    exists_mem_subgradientAt_pressure_of_isBoundedBy ν
      (isBoundedBy_pressure_specificEnergyFunctional ν hμ) hC hCconv hC0 hCadd Φ₀ hε
  obtain ⟨ρ, hρf, hρG⟩ := exists_mem_fieldsOf_mem_invariantG ν hL
  refine ⟨Φ, hΦC, hnorm.trans ?_, ρ, hρG, fun Ψ hΨ ↦ ?_⟩
  · have h1 : specificEnergyFunctional μ Φ₀ = -(Φ₀ : Potential (ι → ℤ) E).specificEnergy μ := rfl
    have h2 := specificEntropy_toReal_le_negFenchel ν hμ
    rw [h1]
    linarith
  · have h := hLC Ψ hΨ
    have hρΨ : L Ψ = -(Ψ : Potential (ι → ℤ) E).specificEnergy ρ := by
      rw [hρf.2 Ψ]; ring
    rw [specificEnergyFunctional_apply, hρΨ] at h
    linarith

end Transfer

/-! ### Finite mixtures of random fields of finite specific entropy -/

section MixtureEntropy

variable {S E : Type*} [MeasurableSpace E] [Countable S] [StandardBorelSpace E]
  {Θ : Subgroup (Transformation S E)} [Countable Θ]

/-- `𝓟_Θ` is convex: a finite convex combination of `Θ`-invariant random fields is one. -/
lemma sum_smul_mem_invariantFields {n : ℕ} {c : Fin n → ℝ≥0∞} {ρ : Fin n → Measure (S → E)}
    (hρ : ∀ i, ρ i ∈ invariantFields Θ) (hc : ∑ i, c i = 1) :
    (∑ i, c i • ρ i) ∈ invariantFields Θ := by
  have hwprob : IsProbabilityMeasure
      (∑ i, c i • Measure.dirac (ρ i) : Measure (Measure (S → E))) := by
    constructor
    rw [Measure.finsetSum_apply]
    have h1 : ∀ i : Fin n, (c i • Measure.dirac (ρ i) : Measure (Measure (S → E))) univ = c i :=
      fun i ↦ by rw [Measure.smul_apply, measure_univ, smul_eq_mul, mul_one]
    rw [Finset.sum_congr rfl fun i _ ↦ h1 i]
    exact hc
  have hnull : (∑ i, c i • Measure.dirac (ρ i) : Measure (Measure (S → E)))
      ((invariantFields Θ)ᶜ) = 0 := by
    rw [Measure.finsetSum_apply]
    refine Finset.sum_eq_zero fun i _ ↦ ?_
    rw [Measure.smul_apply, Measure.dirac_apply' _ (measurableSet_invariantFields (Θ := Θ)).compl,
      Set.indicator_of_notMem (Set.notMem_compl_iff.2 (hρ i)), smul_zero]
  rw [← join_finset_sum_smul_dirac (Finset.univ : Finset (Fin n)) c ρ]
  exact join_mem_invariantFields _ hnull

end MixtureEntropy

section MixtureEntropyLattice

variable {ι E : Type*} [Fintype ι] [DecidableEq ι] [MeasurableSpace E]
  (lam : Measure E) [IsProbabilityMeasure lam]

/-- **A finite mixture of random fields of finite specific entropy has finite specific entropy.**
For every box `Δ` the relative entropy of a mixture is at most the largest of the relative
entropies of its components (`relativeEntropyIn_finset_sum_smul_le`), so the specific entropy of
the mixture is at least the smallest specific entropy of a component. -/
theorem specificEntropy_finsetSum_smul_ne_bot {n : ℕ} [NeZero n] {c : Fin n → ℝ≥0}
    (hc : ∑ i, c i = 1) {ρ : Fin n → Measure ((ι → ℤ) → E)}
    [∀ i, IsProbabilityMeasure (ρ i)] (hρ : ∀ i, specificEntropy lam (ρ i) ≠ ⊥) :
    specificEntropy lam (∑ i, c i • ρ i) ≠ ⊥ := by
  have : Nonempty (Fin n) := Fin.pos_iff_nonempty.1 (Nat.pos_of_ne_zero (NeZero.ne n))
  have hnonpos : ∀ i, (specificEntropy lam (ρ i)).toReal ≤ 0 := by
    intro i
    have h1 : specificEntropy lam (ρ i) = ((specificEntropy lam (ρ i)).toReal : EReal) :=
      (EReal.coe_toReal (specificEntropy_ne_top lam) (hρ i)).symm
    have h2 := specificEntropy_nonpos (lam := lam) (μ := ρ i)
    rw [h1, ← EReal.coe_zero, EReal.coe_le_coe_iff] at h2
    exact h2
  set K : ℝ := ∑ i, (specificEntropy lam (ρ i)).toReal with hK
  have hKle : ∀ i, (K : EReal) ≤ specificEntropy lam (ρ i) := by
    intro i
    have h1 : specificEntropy lam (ρ i) = ((specificEntropy lam (ρ i)).toReal : EReal) :=
      (EReal.coe_toReal (specificEntropy_ne_top lam) (hρ i)).symm
    rw [h1, EReal.coe_le_coe_iff, hK]
    have hsplit : ∑ j, (specificEntropy lam (ρ j)).toReal
        = (specificEntropy lam (ρ i)).toReal
          + ∑ j ∈ Finset.univ.erase i, (specificEntropy lam (ρ j)).toReal :=
      (Finset.add_sum_erase _ _ (Finset.mem_univ i)).symm
    have hrest : ∑ j ∈ Finset.univ.erase i, (specificEntropy lam (ρ j)).toReal ≤ 0 :=
      Finset.sum_nonpos fun j _ ↦ hnonpos j
    rw [hsplit]
    linarith
  refine ne_bot_of_le_ne_bot (EReal.coe_ne_bot K) (le_iInf₂ fun Δ hΔ ↦ ?_)
  obtain ⟨i₀, hi₀⟩ := Finite.exists_max fun i ↦
    relativeEntropyIn (Δ : Set (ι → ℤ)) (ρ i) (Measure.infinitePi fun _ ↦ lam)
  have hmix : relativeEntropyIn (Δ : Set (ι → ℤ)) (∑ i, c i • ρ i)
        (Measure.infinitePi fun _ ↦ lam)
      ≤ relativeEntropyIn (Δ : Set (ι → ℤ)) (ρ i₀) (Measure.infinitePi fun _ ↦ lam) := by
    refine (relativeEntropyIn_finset_sum_smul_le hc ρ _ _).trans ?_
    calc ∑ i, (c i : ℝ≥0∞) * relativeEntropyIn (Δ : Set (ι → ℤ)) (ρ i)
            (Measure.infinitePi fun _ ↦ lam)
        ≤ ∑ _i : Fin n, (c _i : ℝ≥0∞) * relativeEntropyIn (Δ : Set (ι → ℤ)) (ρ i₀)
            (Measure.infinitePi fun _ ↦ lam) :=
          Finset.sum_le_sum fun i _ ↦ mul_le_mul' le_rfl (hi₀ i)
      _ = relativeEntropyIn (Δ : Set (ι → ℤ)) (ρ i₀) (Measure.infinitePi fun _ ↦ lam) := by
          rw [← Finset.sum_mul]
          have : ∑ i, (c i : ℝ≥0∞) = 1 := by
            rw [← ENNReal.ofNNReal_finsetSum, hc, ENNReal.coe_one]
          rw [this, one_mul]
  have hent : entropyIn lam (Δ : Set (ι → ℤ)) (ρ i₀)
      ≤ entropyIn lam (Δ : Set (ι → ℤ)) (∑ i, c i • ρ i) := by
    rw [entropyIn, entropyIn, EReal.neg_le_neg_iff, EReal.coe_ennreal_le_coe_ennreal_iff]
    exact hmix
  refine le_trans ?_ (EReal.div_le_div_right_of_nonneg (Nat.cast_nonneg' _) hent)
  exact (hKle i₀).trans (specificEntropy_le_entropyIn_div_card lam hΔ)

end MixtureEntropyLattice

/-! ### Georgii (16.29): the correlation function and `f`-`I`-oscillation -/

section Correlation

variable {ι E : Type*} [Fintype ι] [DecidableEq ι] [MeasurableSpace E]

/-- The correlation function `i ↦ μ(f · f ∘ θ_i)` of Georgii (16.29). -/
def correlation (f : lp (fun _ : (ι → ℤ) → E ↦ ℝ) ∞) (μ : Measure ((ι → ℤ) → E)) :
    (ι → ℤ) → ℝ := fun i ↦ ∫ ω, ⇑f ω * ⇑f ((shift E i).toFun ω) ∂μ

/-- Georgii's filter `|i| → ∞, i ∈ I` on `ℤ^d`: balls are finite, so escaping to infinity is the
cofinite filter. -/
abbrev atInfinityWithin (I : Set (ι → ℤ)) : Filter (ι → ℤ) := Filter.cofinite ⊓ Filter.principal I

omit [Fintype ι] [DecidableEq ι] in
lemma atInfinityWithin_neBot {I : Set (ι → ℤ)} (hI : I.Infinite) :
    (atInfinityWithin I).NeBot := hI.cofinite_inf_principal_neBot

/-- **Georgii (16.29).** The random field `μ` is *`f`-`I`-oscillating*: the correlations
`μ(f · f ∘ θ_i)` have different `limsup` and `liminf` as `|i| → ∞` inside `I`. -/
def IsOscillating (I : Set (ι → ℤ)) (f : lp (fun _ : (ι → ℤ) → E ↦ ℝ) ∞)
    (μ : Measure ((ι → ℤ) → E)) : Prop :=
  Filter.liminf (correlation f μ) (atInfinityWithin I)
    < Filter.limsup (correlation f μ) (atInfinityWithin I)

omit [Fintype ι] [DecidableEq ι] in
/-- The correlations of a bounded observable are bounded by `‖f‖²`. -/
lemma abs_correlation_le (f : lp (fun _ : (ι → ℤ) → E ↦ ℝ) ∞) (μ : Measure ((ι → ℤ) → E))
    [IsProbabilityMeasure μ] (i : ι → ℤ) : |correlation f μ i| ≤ ‖f‖ * ‖f‖ := by
  refine (abs_integral_le_integral_abs).trans ?_
  refine (integral_mono_of_nonneg (Filter.Eventually.of_forall fun ω ↦ abs_nonneg _)
    (integrable_const (‖f‖ * ‖f‖)) (Filter.Eventually.of_forall fun ω ↦ ?_)).trans ?_
  · change |⇑f ω * ⇑f ((shift E i).toFun ω)| ≤ ‖f‖ * ‖f‖
    rw [abs_mul]
    exact mul_le_mul (lp.norm_apply_le_norm ENNReal.top_ne_zero f ω)
      (lp.norm_apply_le_norm ENNReal.top_ne_zero f _) (abs_nonneg _) (norm_nonneg f)
  · simp

end Correlation

/-! ### Georgii (16.22) and (16.23): transferring the nondegeneracy from `μ` to `ν` -/


section Displays1622

open Potential Potential.BTheta

attribute [local instance] shiftAddAction measurableConstVAdd_shift

variable {ι E : Type*} [Fintype ι] [DecidableEq ι] [MeasurableSpace E] {N : ℕ}
  {Λ₀ : Finset (ι → ℤ)} {f : Fin N → lp (fun _ : (ι → ℤ) → E ↦ ℝ) ∞}
  {μ ρ : Measure ((ι → ℤ) → E)} [IsProbabilityMeasure μ] [IsProbabilityMeasure ρ]

omit [Fintype ι] [DecidableEq ι] [IsProbabilityMeasure ρ] in
lemma abs_integral_le_norm (g : lp (fun _ : (ι → ℤ) → E ↦ ℝ) ∞) :
    |∫ ω, ⇑g ω ∂μ| ≤ ‖g‖ := by
  refine abs_integral_le_integral_abs.trans ?_
  refine (integral_mono_of_nonneg (Filter.Eventually.of_forall fun ω ↦ abs_nonneg _)
    (integrable_const ‖g‖) (Filter.Eventually.of_forall fun ω ↦ ?_)).trans ?_
  · simpa [Real.norm_eq_abs] using lp.norm_apply_le_norm ENNReal.top_ne_zero g ω
  · simp

omit [Fintype ι] [DecidableEq ι] in
lemma combo_mem_localFunctionsOn (hf : ∀ n, f n ∈ localFunctionsOn (ι → ℤ) E Λ₀)
    (a : Fin N → ℝ) : combo f a ∈ localFunctionsOn (ι → ℤ) E Λ₀ :=
  Subalgebra.sum_mem _ fun n _ ↦ Subalgebra.smul_mem _ (hf n) _

omit [DecidableEq ι] in
/-- **Georgii (16.22).** If `ν` and `μ` satisfy `⟨ν, Ψ⟩ ≤ ⟨μ, Ψ⟩ + ε‖Ψ‖₀` on
`ℬ_Θ(f₁, …, f_N)`, then for every `i ≠ 0` the truncated correlations of `ν` dominate those of `μ`
up to `4ε|Λ₀| ‖f_a‖²`:
`ν(f_a f_a ∘ θ_i) − ν(f_a)² ≥ μ(f_a f_a ∘ θ_i) − μ(f_a)² − 4ε|Λ₀| ‖f_a‖²`.

The potentials tested are Georgii's `Ψ^i + Ψ⁰` and `Ψ̄⁰`, of `‖·‖₀`-norms at most `3|Λ₀| ‖f_a‖²`
and `|Λ₀| ‖f_a‖²`. -/
theorem correlation_sub_sq_le {C : Set (BTheta (ι → ℤ) E)} (hΛ₀ : Λ₀.Nonempty)
    (hf : ∀ n, f n ∈ localFunctionsOn (ι → ℤ) E Λ₀)
    (hμ : μ ∈ invariantFields (shiftGroup (ι → ℤ) E))
    (hρ : ρ ∈ invariantFields (shiftGroup (ι → ℤ) E)) {ε : ℝ} (hε : 0 ≤ ε)
    (hCadd : ∀ Ψ ∈ C, ∀ Χ ∈ C, Ψ + Χ ∈ C)
    (hle : ∀ Ψ ∈ C, (Ψ : Potential (ι → ℤ) E).specificEnergy ρ
        ≤ (Ψ : Potential (ι → ℤ) E).specificEnergy μ + ε * ‖Ψ‖)
    (a : Fin N → ℝ)
    (hPmem : ∀ c : ℝ, localPotentialB Λ₀ (c • combo f a) ∈ C) {i : ι → ℤ}
    (hQmem : localPotentialB (pairVolume Λ₀ i)
      ((-1 : ℝ) • (combo f a * lp.precomp (shift E i).toFun (combo f a))) ∈ C) :
    correlation (combo f a) μ i - (∫ ω, ⇑(combo f a) ω ∂μ) ^ 2
        - 4 * ε * #Λ₀ * ‖combo f a‖ ^ 2
      ≤ correlation (combo f a) ρ i - (∫ ω, ⇑(combo f a) ω ∂ρ) ^ 2 := by
  set g : lp (fun _ : (ι → ℤ) → E ↦ ℝ) ∞ := combo f a with hg
  have hgmem : g ∈ localFunctionsOn (ι → ℤ) E Λ₀ := combo_mem_localFunctionsOn hf a
  have hsmul : ∀ c : ℝ, c • g ∈ localFunctionsOn (ι → ℤ) E Λ₀ := fun c ↦
    Subalgebra.smul_mem _ hgmem c
  set A : ℝ := ∫ ω, ⇑g ω ∂ρ with hA
  set B : ℝ := ∫ ω, ⇑g ω ∂μ with hB
  have hn0 : (0 : ℝ) ≤ ‖g‖ := norm_nonneg g
  have hAle : |A| ≤ ‖g‖ := abs_integral_le_norm g
  have hBle : |B| ≤ ‖g‖ := abs_integral_le_norm g
  -- Georgii's `Ψ⁰` and `Ψ̄⁰`
  set P : ℝ → BTheta (ι → ℤ) E := fun c ↦ localPotentialB Λ₀ (c • g) with hP
  have hPenergy : ∀ (c : ℝ) (σ : Measure ((ι → ℤ) → E)) (_ : IsProbabilityMeasure σ),
      σ ∈ invariantFields (shiftGroup (ι → ℤ) E) →
        (P c : Potential (ι → ℤ) E).specificEnergy σ = c * ∫ ω, ⇑g ω ∂σ := by
    intro c σ _ hσ
    rw [hP, specificEnergy_localPotentialB hΛ₀ (hsmul c) hσ]
    simp_rw [lp.coeFn_smul, Pi.smul_apply, smul_eq_mul]
    exact integral_const_mul c _
  have hPnorm : ∀ c : ℝ, |c| ≤ ‖g‖ → ‖P c‖ ≤ #Λ₀ * ‖g‖ ^ 2 := by
    intro c hc
    rw [hP, norm_localPotentialB hΛ₀ (hsmul c), norm_smul, Real.norm_eq_abs]
    refine mul_le_mul_of_nonneg_left ?_ (by positivity)
    nlinarith
  -- Georgii's `Ψ^i`
  set Q : BTheta (ι → ℤ) E :=
    localPotentialB (pairVolume Λ₀ i) ((-1 : ℝ) • (g * lp.precomp (shift E i).toFun g)) with hQ
  have hQlocal : ((-1 : ℝ) • (g * lp.precomp (shift E i).toFun g))
      ∈ localFunctionsOn (ι → ℤ) E (pairVolume Λ₀ i) := by
    refine Subalgebra.smul_mem _ (Subalgebra.mul_mem _ ?_ ?_) _
    · exact localFunctionsOn_mono Finset.subset_union_left hgmem
    · exact localFunctionsOn_mono Finset.subset_union_right
        (precomp_shift_mem_localFunctionsOn hgmem i)
  have hQenergy : ∀ (σ : Measure ((ι → ℤ) → E)) (_ : IsProbabilityMeasure σ),
      σ ∈ invariantFields (shiftGroup (ι → ℤ) E) →
        (Q : Potential (ι → ℤ) E).specificEnergy σ = -correlation g σ i := by
    intro σ _ hσ
    rw [hQ, specificEnergy_localPotentialB (pairVolume_nonempty hΛ₀ i) hQlocal hσ]
    simp_rw [lp.coeFn_smul, Pi.smul_apply, smul_eq_mul, lp.infty_coeFn_mul, Pi.mul_apply,
      lp.precomp_apply]
    rw [integral_const_mul]
    simp [correlation]
  have hQnorm : ‖Q‖ ≤ 2 * #Λ₀ * ‖g‖ ^ 2 := by
    rw [hQ, norm_localPotentialB (pairVolume_nonempty hΛ₀ i) hQlocal, norm_smul,
      Real.norm_eq_abs, abs_neg, abs_one, one_mul]
    have hcard : (#(pairVolume Λ₀ i) : ℝ) ≤ 2 * #Λ₀ := by
      exact_mod_cast card_pairVolume_le Λ₀ i
    have hmul : ‖g * lp.precomp (shift E i).toFun g‖ ≤ ‖g‖ ^ 2 := by
      rw [sq]
      exact (norm_mul_le _ _).trans
        (mul_le_mul_of_nonneg_left (lp.norm_precomp_le _ g) hn0)
    exact mul_le_mul hcard hmul (norm_nonneg _) (by positivity)
  -- the two applications of the hypothesis
  have hsum : (Q + P A) ∈ C := hCadd _ hQmem _ (hPmem A)
  have h1 := hle (Q + P A) hsum
  have h2 := hle (P B) (hPmem B)
  rw [Submodule.coe_add, specificEnergy_add, specificEnergy_add, hQenergy ρ ‹_› hρ,
    hQenergy μ ‹_› hμ, hPenergy A ρ ‹_› hρ, hPenergy A μ ‹_› hμ] at h1
  rw [hPenergy B ρ ‹_› hρ, hPenergy B μ ‹_› hμ] at h2
  have hnormsum : ‖Q + P A‖ ≤ 3 * #Λ₀ * ‖g‖ ^ 2 := by
    refine (norm_add_le _ _).trans ?_
    have := hQnorm
    have := hPnorm A hAle
    linarith
  have hε1 : ε * ‖Q + P A‖ ≤ ε * (3 * #Λ₀ * ‖g‖ ^ 2) := mul_le_mul_of_nonneg_left hnormsum hε
  have hε2 : ε * ‖P B‖ ≤ ε * (#Λ₀ * ‖g‖ ^ 2) := mul_le_mul_of_nonneg_left (hPnorm B hBle) hε
  nlinarith [h1, h2, hε1, hε2]

omit [DecidableEq ι] in
/-- The Cesàro averages of the correlations `σ(f_a · f_a ∘ θ_i)` over cubes converge to
`σ(σ(f_a | 𝓘)²)`: the mean ergodic theorem, Georgii's (14.A3), in the form used in (16.23). -/
lemma tendsto_inv_card_sum_correlation [Nonempty ι] {F : ℕ → Finset (ι → ℤ)} (hFmono : Monotone F)
    (hFne : (F 0).Nonempty)
    (hFol : ∀ g : ι → ℤ, Filter.Tendsto
      (fun n ↦ (((g +ᵥ F n : Finset (ι → ℤ)) ∆ F n).card : ℝ) / (F n).card) Filter.atTop (𝓝 0))
    (g : lp (fun _ : (ι → ℤ) → E ↦ ℝ) ∞) (hgm : Measurable ⇑g)
    (σ : Measure ((ι → ℤ) → E)) [IsProbabilityMeasure σ]
    (hσ : σ ∈ invariantFields (shiftGroup (ι → ℤ) E)) :
    Filter.Tendsto (fun k ↦ ((F k).card : ℝ)⁻¹ * ∑ i ∈ F k, correlation g σ i) Filter.atTop
      (𝓝 (∫ ω, ((σ[⇑g | invariantEvents (shiftGroup (ι → ℤ) E)]) ω) ^ 2 ∂σ)) := by
  classical
  have hvadd : VAddInvariantMeasure (ι → ℤ) ((ι → ℤ) → E) σ :=
    vaddInvariantMeasure_of_forall_measurePreserving_shift
      (mem_invariantFields_shiftGroup.1 hσ).2
  have hne : ∀ᶠ k in Filter.atTop, (F k).Nonempty :=
    Filter.Eventually.of_forall fun k ↦ hFne.mono (hFmono (Nat.zero_le k))
  have h := tendsto_inv_card_sum_integral_mul_vadd (μ := σ) (F := F) hne hFol (C := ‖g‖) hgm
    (fun ω ↦ by simpa [Real.norm_eq_abs] using lp.norm_apply_le_norm ENNReal.top_ne_zero g ω)
  rw [smulInvariants_multiplicative_eq_invariantEvents_shiftGroup] at h
  exact h

/-- **Georgii (16.23).** If `ν` and `μ` satisfy `⟨ν, Ψ⟩ ≤ ⟨μ, Ψ⟩ + ε‖Ψ‖₀` on `ℬ_Θ(f₁, …, f_N)`
and `μ` has invariant means so nondegenerate that `4ε|Λ₀| ‖f_a‖² < μ(μ(f_a|𝓘)²) − μ(f_a)²` for all
`a ≠ 0`, then `ν` has nondegenerate invariant means as well.

The inequality (16.22) holds for every `i ≠ 0`; averaging it over a cube and letting the cube grow,
the mean ergodic theorem turns the averaged correlations into `σ(σ(f_a|𝓘)²)`. Only the single term
`i = 0` is missing from the average, and it does not affect the limit. -/
theorem hasNondegenerateInvariantMeans_of_specificEnergy_le [Nonempty ι] {I : Set (ι → ℤ)}
    {C : Set (BTheta (ι → ℤ) E)}
    (hI : Iᶜ.Finite) (hΛ₀ : Λ₀.Nonempty) (hf : ∀ n, f n ∈ localFunctionsOn (ι → ℤ) E Λ₀)
    (hfm : ∀ n, Measurable ⇑(f n))
    (hμ : μ ∈ invariantFields (shiftGroup (ι → ℤ) E))
    (hρ : ρ ∈ invariantFields (shiftGroup (ι → ℤ) E)) {ε : ℝ} (hε : 0 ≤ ε)
    (hCadd : ∀ Ψ ∈ C, ∀ Χ ∈ C, Ψ + Χ ∈ C)
    (hPmem : ∀ (a : Fin N → ℝ) (c : ℝ), localPotentialB Λ₀ (c • combo f a) ∈ C)
    (hQmem : ∀ (a : Fin N → ℝ), ∀ i ∈ I, localPotentialB (pairVolume Λ₀ i)
      ((-1 : ℝ) • (combo f a * lp.precomp (shift E i).toFun (combo f a))) ∈ C)
    (hle : ∀ Ψ ∈ C, (Ψ : Potential (ι → ℤ) E).specificEnergy ρ
        ≤ (Ψ : Potential (ι → ℤ) E).specificEnergy μ + ε * ‖Ψ‖)
    (hgap : ∀ a : Fin N → ℝ, a ≠ 0 →
      ε * (4 * #Λ₀ * ‖combo f a‖ ^ 2) < invariantVariance (shiftGroup (ι → ℤ) E) μ f a) :
    HasNondegenerateInvariantMeans (shiftGroup (ι → ℤ) E) ρ f := by
  classical
  rw [hasNondegenerateInvariantMeans_iff_invariantVariance_pos]
  intro a ha
  set g : lp (fun _ : (ι → ℤ) → E ↦ ℝ) ∞ := combo f a with hg
  have hgm : Measurable ⇑g := measurable_combo hfm a
  obtain ⟨F, C, hFmono, hFne, hFol, -, -, hcard⟩ := exists_monotone_regular_foelner_cube (ι := ι)
  have hcard' := hcard ‹Nonempty ι›
  have hlimρ := tendsto_inv_card_sum_correlation hFmono hFne hFol g hgm ρ hρ
  have hlimμ := tendsto_inv_card_sum_correlation hFmono hFne hFol g hgm μ hμ
  set Vρ : ℝ := ∫ ω, ((ρ[⇑g | invariantEvents (shiftGroup (ι → ℤ) E)]) ω) ^ 2 ∂ρ with hVρ
  set Vμ : ℝ := ∫ ω, ((μ[⇑g | invariantEvents (shiftGroup (ι → ℤ) E)]) ω) ^ 2 ∂μ with hVμ
  set A : ℝ := ∫ ω, ⇑g ω ∂ρ with hA
  set B : ℝ := ∫ ω, ⇑g ω ∂μ with hB
  set K : ℝ := A ^ 2 - B ^ 2 - 4 * ε * #Λ₀ * ‖g‖ ^ 2 with hK
  have hKle : ∀ i : ι → ℤ, i ∉ hI.toFinset → K ≤ correlation g ρ i - correlation g μ i := by
    intro i hi
    rw [Set.Finite.mem_toFinset, Set.notMem_compl_iff] at hi
    have h := correlation_sub_sq_le hΛ₀ hf hμ hρ hε hCadd hle a (hPmem a) (hQmem a i hi)
    rw [← hg, ← hA, ← hB] at h
    rw [hK]
    linarith
  have hzero : ∀ i ∈ hI.toFinset,
      K - (correlation g ρ i - correlation g μ i) ≤ |K| + 2 * (‖g‖ * ‖g‖) := by
    intro i _
    have h1 := abs_correlation_le g ρ i
    have h2 := abs_correlation_le g μ i
    have h3 : K ≤ |K| := le_abs_self K
    rw [abs_le] at h1 h2
    linarith [h1.1, h1.2, h2.1, h2.2]
  have hlim : Filter.Tendsto
      (fun k ↦ ((F k).card : ℝ)⁻¹ * ∑ i ∈ F k, (correlation g ρ i - correlation g μ i))
      Filter.atTop (𝓝 (Vρ - Vμ)) := by
    have := hlimρ.sub hlimμ
    refine this.congr fun k ↦ ?_
    rw [Finset.sum_sub_distrib, mul_sub]
  have hfinal := Filter.le_of_tendsto_inv_card_sum_of_forall_notMem hcard'
    (by positivity : (0 : ℝ) ≤ |K| + 2 * (‖g‖ * ‖g‖)) hKle hzero hlim
  rw [hK] at hfinal
  have hgapa := hgap a ha
  rw [← hg] at hgapa
  rw [invariantVariance, ← hg, ← hVρ, ← hA]
  rw [invariantVariance, ← hg, ← hVμ, ← hB] at hgapa
  nlinarith [hfinal, hgapa]

end Displays1622

/-! ### Georgii Comment (16.24)(2): the ferromagnetic cone `ℬ⁻_Θ(f)` -/

section NegCone

open Potential Potential.BTheta

variable {ι E : Type*} [Fintype ι] [DecidableEq ι] [MeasurableSpace E]
  {Λ₀ : Finset (ι → ℤ)} {g : lp (fun _ : (ι → ℤ) → E ↦ ℝ) ∞}

omit [Fintype ι] [DecidableEq ι] in
lemma localPotentialB_smul {Λ : Finset (ι → ℤ)} (hΛ : Λ.Nonempty) (c : ℝ)
    (hg : g ∈ localFunctionsOn (ι → ℤ) E Λ) :
    localPotentialB Λ (c • g) = c • localPotentialB Λ g := by
  have h := localPotentialB_sum_smul (J := Fin 1) hΛ (fun _ ↦ c) (fun _ ↦ g) (fun _ ↦ hg)
  simpa using h

/-- The generators of Georgii's cone `ℬ⁻_Θ(f)` of Comment (16.24)(2): the potential
`Φ^{(Λ₀,f)}` and its negative, and the *negatives* `−Φ^{(Λ_i, f (f ∘ θ_i))}` for `i ∈ I`. -/
def negOrderGenerators (Λ₀ : Finset (ι → ℤ)) (g : lp (fun _ : (ι → ℤ) → E ↦ ℝ) ∞)
    (I : Set (ι → ℤ)) : Set (BTheta (ι → ℤ) E) :=
  {Φ | Φ = localPotentialB Λ₀ g ∨ Φ = -localPotentialB Λ₀ g ∨
    ∃ i ∈ I, Φ = -localPotentialB (pairVolume Λ₀ i) (g * lp.precomp (shift E i).toFun g)}

/-- **Georgii's cone `ℬ⁻_Θ(f)`** of Comment (16.24)(2), for a single observable `f` (`N = 1`):
the closed convex cone generated by `±Φ^{(Λ₀,f)}` and the negatives
`−Φ^{(Λ_i, f (f ∘ θ_i))}`, `i ∈ I`. Its generators have `Φ_{Λ_i}` a *nonpositive* multiple of
`f (f ∘ θ_i)`, that is, a ferromagnetic pair interaction. -/
def BThetaOrderNeg (Λ₀ : Finset (ι → ℤ)) (g : lp (fun _ : (ι → ℤ) → E ↦ ℝ) ∞)
    (I : Set (ι → ℤ)) : PointedCone ℝ (BTheta (ι → ℤ) E) :=
  PointedCone.closure (PointedCone.hull ℝ (negOrderGenerators Λ₀ g I))

omit [DecidableEq ι] in
lemma isClosed_BThetaOrderNeg (Λ₀ : Finset (ι → ℤ)) (g : lp (fun _ : (ι → ℤ) → E ↦ ℝ) ∞)
    (I : Set (ι → ℤ)) :
    IsClosed ((BThetaOrderNeg Λ₀ g I : PointedCone ℝ (BTheta (ι → ℤ) E)) :
      Set (BTheta (ι → ℤ) E)) := by
  rw [BThetaOrderNeg, PointedCone.coe_closure]
  exact isClosed_closure

omit [DecidableEq ι] in
lemma subset_BThetaOrderNeg (Λ₀ : Finset (ι → ℤ)) (g : lp (fun _ : (ι → ℤ) → E ↦ ℝ) ∞)
    (I : Set (ι → ℤ)) : negOrderGenerators Λ₀ g I ⊆
      ((BThetaOrderNeg Λ₀ g I : PointedCone ℝ (BTheta (ι → ℤ) E)) : Set (BTheta (ι → ℤ) E)) := by
  refine (PointedCone.subset_hull (R := ℝ)).trans ?_
  rw [BThetaOrderNeg, PointedCone.coe_closure]
  exact subset_closure

omit [Fintype ι] [DecidableEq ι] in
/-- A real multiple of an element `Φ` of a pointed cone lies in the cone as soon as `−Φ` does. -/
lemma smul_mem_of_neg_mem {K : PointedCone ℝ (BTheta (ι → ℤ) E)} {Φ : BTheta (ι → ℤ) E}
    (hΦ : Φ ∈ K) (hΦ' : -Φ ∈ K) (t : ℝ) : t • Φ ∈ K := by
  rcases le_or_gt 0 t with ht | ht
  · exact Submodule.smul_mem K (⟨t, ht⟩ : {c : ℝ // 0 ≤ c}) hΦ
  · have hnt : (0 : ℝ) ≤ -t := by linarith
    have h := Submodule.smul_mem K (⟨-t, hnt⟩ : {c : ℝ // 0 ≤ c}) hΦ'
    have heq : ((⟨-t, hnt⟩ : {c : ℝ // 0 ≤ c}) • (-Φ) : BTheta (ι → ℤ) E) = t • Φ := by
      have h1 : ((⟨-t, hnt⟩ : {c : ℝ // 0 ≤ c}) • (-Φ) : BTheta (ι → ℤ) E)
          = (-t : ℝ) • (-Φ) := rfl
      rw [h1, smul_neg, neg_smul, neg_neg]
    rwa [heq] at h

omit [DecidableEq ι] in
/-- Georgii's `Ψ⁰`, `Ψ̄⁰` lie in `ℬ⁻_Θ(f)`. -/
lemma localPotentialB_smul_combo_mem_neg (hΛ₀ : Λ₀.Nonempty)
    (hg : g ∈ localFunctionsOn (ι → ℤ) E Λ₀) (I : Set (ι → ℤ)) (a : Fin 1 → ℝ) (c : ℝ) :
    localPotentialB Λ₀ (c • combo (fun _ : Fin 1 ↦ g) a) ∈ BThetaOrderNeg Λ₀ g I := by
  have hcombo : combo (fun _ : Fin 1 ↦ g) a = a 0 • g := by
    rw [combo]; simp
  rw [hcombo, smul_smul, localPotentialB_smul hΛ₀ _ hg]
  exact smul_mem_of_neg_mem (subset_BThetaOrderNeg Λ₀ g I (Or.inl rfl))
    (subset_BThetaOrderNeg Λ₀ g I (Or.inr (Or.inl rfl))) _

omit [DecidableEq ι] in
/-- Georgii's `Ψ^i` lies in `ℬ⁻_Θ(f)`: it is a *nonpositive* multiple of
`Φ^{(Λ_i, f (f ∘ θ_i))}`, because `f_a (f_a ∘ θ_i) = a₀² f (f ∘ θ_i)` when `N = 1`. -/
lemma localPotentialB_pairVolume_smul_mem_neg (hΛ₀ : Λ₀.Nonempty)
    (hg : g ∈ localFunctionsOn (ι → ℤ) E Λ₀) {I : Set (ι → ℤ)} (a : Fin 1 → ℝ) {i : ι → ℤ}
    (hi : i ∈ I) :
    localPotentialB (pairVolume Λ₀ i) ((-1 : ℝ) • (combo (fun _ : Fin 1 ↦ g) a *
        lp.precomp (shift E i).toFun (combo (fun _ : Fin 1 ↦ g) a)))
      ∈ BThetaOrderNeg Λ₀ g I := by
  have hcombo : combo (fun _ : Fin 1 ↦ g) a = a 0 • g := by
    rw [combo]; simp
  have hmul : (-1 : ℝ) • (combo (fun _ : Fin 1 ↦ g) a *
      lp.precomp (shift E i).toFun (combo (fun _ : Fin 1 ↦ g) a))
      = (-(a 0 * a 0)) • (g * lp.precomp (shift E i).toFun g) := by
    rw [hcombo, lp.precomp_smul, smul_mul_assoc, mul_smul_comm, smul_smul, smul_smul]
    ring_nf
  have hloc : g * lp.precomp (shift E i).toFun g
      ∈ localFunctionsOn (ι → ℤ) E (pairVolume Λ₀ i) :=
    Subalgebra.mul_mem _ (localFunctionsOn_mono Finset.subset_union_left hg)
      (localFunctionsOn_mono Finset.subset_union_right
        (precomp_shift_mem_localFunctionsOn hg i))
  rw [hmul, localPotentialB_smul (pairVolume_nonempty hΛ₀ i) _ hloc]
  have hneg : -localPotentialB (pairVolume Λ₀ i) (g * lp.precomp (shift E i).toFun g)
      ∈ BThetaOrderNeg Λ₀ g I := subset_BThetaOrderNeg Λ₀ g I (Or.inr (Or.inr ⟨i, hi, rfl⟩))
  have heq : (-(a 0 * a 0)) • localPotentialB (pairVolume Λ₀ i)
        (g * lp.precomp (shift E i).toFun g)
      = ((⟨a 0 * a 0, mul_self_nonneg _⟩ : {c : ℝ // 0 ≤ c}) •
        (-localPotentialB (pairVolume Λ₀ i) (g * lp.precomp (shift E i).toFun g))
          : BTheta (ι → ℤ) E) := by
    have h1 : ((⟨a 0 * a 0, mul_self_nonneg _⟩ : {c : ℝ // 0 ≤ c}) •
          (-localPotentialB (pairVolume Λ₀ i) (g * lp.precomp (shift E i).toFun g))
            : BTheta (ι → ℤ) E)
        = (a 0 * a 0 : ℝ) •
          (-localPotentialB (pairVolume Λ₀ i) (g * lp.precomp (shift E i).toFun g)) := rfl
    rw [h1, smul_neg, ← neg_smul]
  rw [heq]
  exact Submodule.smul_mem _ _ hneg

end NegCone

/-! ### Georgii Comment (16.19): a discriminating system discriminates extreme measures -/

section Comment1619

open Potential Potential.BTheta

variable {ι E : Type*} [Fintype ι] [DecidableEq ι] [Nonempty ι] [MeasurableSpace E]
  [StandardBorelSpace E] {N : ℕ} {γ : Specification (ι → ℤ) E}
  {f : Fin N → lp (fun _ : (ι → ℤ) → E ↦ ℝ) ∞}

omit [Fintype ι] [DecidableEq ι] [Nonempty ι] [StandardBorelSpace E] in
lemma measurable_withOne (hfm : ∀ n, Measurable ⇑(f n)) (n : Fin (N + 1)) :
    Measurable ⇑(withOne f n) := by
  refine Fin.cases ?_ (fun n ↦ by rw [withOne_succ]; exact hfm n) n
  rw [withOne_zero, lp.infty_coeFn_one]
  exact measurable_one

omit [Fintype ι] [DecidableEq ι] [Nonempty ι] [StandardBorelSpace E] in
/-- A linear functional applied to the vector of expectations `(μ(f₀), …, μ(f_N))` is the
expectation of the corresponding linear combination of the observables. -/
lemma apply_observableVector (hfm : ∀ n, Measurable ⇑(f n)) (b : Fin (N + 1) → ℝ)
    (σ : Measure ((ι → ℤ) → E)) [IsProbabilityMeasure σ] :
    ∑ n, observableVector f σ n * b n = ∫ ω, (∑ n, ⇑(withOne f n) ω * b n) ∂σ := by
  rw [integral_finsetSum _ fun n _ ↦
    (lp.integrable_of_measurable (measurable_withOne hfm n) σ).mul_const (b n)]
  exact Finset.sum_congr rfl fun n _ ↦ (integral_mul_const _ _).symm

omit [DecidableEq ι] in
/-- **Georgii Comment (16.19).** A discriminating system for `𝒢_Θ(γ)` is already a discriminating
system for the *extreme* shift-invariant Gibbs measures.

By Theorem (14.17) every `μ ∈ 𝒢_Θ(γ)` is `μ = μ π` for a `(𝒢_Θ(γ), 𝓘)`-kernel `π` whose values
are `μ`-a.s. extreme in `𝒢_Θ(γ)`; so a linear functional vanishing on all the vectors
`(ρ(f₀), …, ρ(f_N))`, `ρ ∈ ex 𝒢_Θ(γ)`, vanishes on all of `𝒢_Θ(γ)`, and the two families of
vectors span the same subspace of `ℝ^{N+1}`. -/
theorem isDiscriminating_extremePoints_invariantG (hfm : ∀ n, Measurable ⇑(f n))
    (hdisc : IsDiscriminating (invariantG γ (shiftGroup (ι → ℤ) E)) f) :
    IsDiscriminating ((invariantG γ (shiftGroup (ι → ℤ) E)).extremePoints ℝ≥0∞) f := by
  classical
  set Θ : Subgroup (Transformation (ι → ℤ) E) := shiftGroup (ι → ℤ) E with hΘdef
  have hΘ : ∀ Λ : Finset (ι → ℤ), ∃ τ ∈ Θ, Disjoint (τ.sites ⁻¹' (Λ : Set (ι → ℤ)))
      (Λ : Set (ι → ℤ)) := shiftGroup_exists_disjoint_sites_preimage (E := E) (S := ι → ℤ)
  have hle : invariantEvents Θ ≤ (inferInstance : MeasurableSpace ((ι → ℤ) → E)) :=
    MeasurableSpace.smulInvariants_le
  have hP : ∀ σ ∈ invariantG γ Θ, IsProbabilityMeasure σ := fun _ h ↦ h.1.1
  rw [isDiscriminating_iff_span_eq_top] at hdisc ⊢
  by_contra hspan
  obtain ⟨φ, hφ, hker⟩ := Submodule.exists_le_ker_of_lt_top _ (lt_top_iff_ne_top.2 hspan)
  set b : Fin (N + 1) → ℝ := fun n ↦ φ (fun j ↦ if n = j then 1 else 0) with hbdef
  have hφb : ∀ v : Fin (N + 1) → ℝ, φ v = ∑ n, v n * b n := fun v ↦ by
    rw [LinearMap.pi_apply_eq_sum_univ φ v]
    exact Finset.sum_congr rfl fun n _ ↦ by rw [smul_eq_mul]
  set h : ((ι → ℤ) → E) → ℝ := fun ω ↦ ∑ n, ⇑(withOne f n) ω * b n with hhdef
  have hhm : Measurable h :=
    Finset.measurable_sum _ fun n _ ↦ (measurable_withOne hfm n).mul_const (b n)
  set C : ℝ := ∑ n, ‖withOne f n‖ * |b n| with hCdef
  have hC0 : 0 ≤ C := Finset.sum_nonneg fun n _ ↦ by positivity
  have hhb : ∀ ω, |h ω| ≤ C := by
    intro ω
    refine (Finset.abs_sum_le_sum_abs _ _).trans (Finset.sum_le_sum fun n _ ↦ ?_)
    rw [abs_mul]
    exact mul_le_mul_of_nonneg_right
      (by simpa [Real.norm_eq_abs] using
        lp.norm_apply_le_norm ENNReal.top_ne_zero (withOne f n) ω) (abs_nonneg _)
  have hint : ∀ σ : Measure ((ι → ℤ) → E), IsProbabilityMeasure σ → Integrable h σ := by
    intro σ _
    exact Integrable.of_bound hhm.aestronglyMeasurable C
      (Filter.Eventually.of_forall fun ω ↦ by simpa [Real.norm_eq_abs] using hhb ω)
  have hex0 : ∀ ρ ∈ (invariantG γ Θ).extremePoints ℝ≥0∞, ∫ ω, h ω ∂ρ = 0 := by
    intro ρ hρ
    have : IsProbabilityMeasure ρ := hP ρ (extremePoints_subset hρ)
    have := hker (Submodule.subset_span ⟨ρ, hρ, rfl⟩)
    rw [LinearMap.mem_ker, hφb, apply_observableVector hfm] at this
    exact this
  -- every `μ ∈ 𝒢_Θ(γ)` also kills `h`, by the ergodic decomposition
  have hall : ∀ μ ∈ invariantG γ Θ, ∫ ω, h ω ∂μ = 0 := by
    intro μ hμ
    have hprob : IsProbabilityMeasure μ := hP μ hμ
    obtain ⟨π₀, hMarkov, hπ₀⟩ :=
      exists_isPAKernel_invariantFields_shiftGroup_int (E := E) (ι := ι) ⟨μ, hμ.2⟩
    have hπ : IsPAKernel (invariantG γ Θ) (invariantEvents Θ)
        (invariantGibbsKernel γ π₀ μ) := isPAKernel_invariantGibbsKernel hΘ hπ₀ hμ
    have hae : ∀ᵐ ω ∂μ, invariantGibbsKernel γ π₀ μ ω ∈ (invariantG γ Θ).extremePoints ℝ≥0∞ :=
      hπ.ae_mem_extremePoints hle hP measurableSet_invariantG
        (extremePoints_invariantG_eq_inter_trivialOn hΘ) hμ
    set F : ((ι → ℤ) → E) → ℝ≥0∞ := fun ω ↦ ENNReal.ofReal (h ω + C) with hFdef
    have hFm : Measurable F := ENNReal.measurable_ofReal.comp (hhm.add_const C)
    have hnn0 : ∀ ω, (0 : ℝ) ≤ h ω + C := fun ω ↦ by
      have h1 := hhb ω
      have h2 := neg_abs_le (h ω)
      linarith
    have hnn : ∀ σ : Measure ((ι → ℤ) → E), (0 : ((ι → ℤ) → E) → ℝ) ≤ᵐ[σ] fun ω ↦ h ω + C :=
      fun σ ↦ Filter.Eventually.of_forall fun ω ↦ hnn0 ω
    have hlint : ∀ (σ : Measure ((ι → ℤ) → E)) (_ : IsProbabilityMeasure σ),
        ∫⁻ ω, F ω ∂σ = ENNReal.ofReal ((∫ ω, h ω ∂σ) + C) := by
      intro σ hσ
      have h1 : ∫⁻ ω, F ω ∂σ = ∫⁻ ω, ENNReal.ofReal (h ω + C) ∂σ := rfl
      have hint2 : Integrable (fun ω ↦ h ω + C) σ := (hint σ hσ).add (integrable_const C)
      have hnn2 : (0 : ((ι → ℤ) → E) → ℝ) ≤ᵐ[σ] fun ω ↦ h ω + C :=
        Filter.Eventually.of_forall fun ω ↦ hnn0 ω
      rw [h1, ← ofReal_integral_eq_lintegral_ofReal hint2 hnn2,
        integral_add (hint σ hσ) (integrable_const C), integral_const]
      simp
    have hkey := hπ.setLIntegral_lintegral_eq hle hμ (A := Set.univ) MeasurableSet.univ hFm
    rw [Measure.restrict_univ] at hkey
    have hleft : ∫⁻ ω, ∫⁻ ω', F ω' ∂(invariantGibbsKernel γ π₀ μ ω) ∂μ = ENNReal.ofReal C := by
      have hcong : (fun ω ↦ ∫⁻ ω', F ω' ∂(invariantGibbsKernel γ π₀ μ ω))
          =ᵐ[μ] fun _ ↦ ENNReal.ofReal C := by
        filter_upwards [hae] with ω hω
        have hprob' : IsProbabilityMeasure (invariantGibbsKernel γ π₀ μ ω) :=
          hP _ (extremePoints_subset hω)
        rw [hlint _ hprob', hex0 _ hω, zero_add]
      rw [lintegral_congr_ae hcong, lintegral_const, measure_univ, mul_one]
    rw [hleft, hlint μ hprob] at hkey
    have hCnn : (0 : ℝ) ≤ (∫ ω, h ω ∂μ) + C := by
      have h2 : (0 : ℝ) ≤ ∫ ω, (h ω + C) ∂μ :=
        integral_nonneg fun ω ↦ hnn0 ω
      rw [integral_add (hint μ hprob) (integrable_const C), integral_const] at h2
      simpa using h2
    have := (ENNReal.ofReal_eq_ofReal_iff hC0 hCnn).1 hkey
    linarith
  -- hence `φ` vanishes on the span of the `𝒢_Θ(γ)`-vectors, which is everything
  refine hφ (LinearMap.ext fun v ↦ ?_)
  have htop : Submodule.span ℝ (observableVector f '' invariantG γ Θ) ≤ LinearMap.ker φ := by
    refine Submodule.span_le.2 ?_
    rintro _ ⟨μ, hμ, rfl⟩
    have : IsProbabilityMeasure μ := hP μ hμ
    rw [SetLike.mem_coe, LinearMap.mem_ker, hφb, apply_observableVector hfm]
    exact hall μ hμ
  rw [hdisc, top_le_iff] at htop
  rw [LinearMap.zero_apply, ← LinearMap.mem_ker, htop]
  trivial

omit [DecidableEq ι] in
/-- **Georgii Comment (16.19).** A potential with a discriminating system of `N` observables has
at least `N + 1` extreme shift-invariant Gibbs measures. -/
theorem le_encard_extremePoints_invariantG_of_isDiscriminating (hfm : ∀ n, Measurable ⇑(f n))
    (hdisc : IsDiscriminating (invariantG γ (shiftGroup (ι → ℤ) E)) f) :
    ((N : ℕ∞) + 1)
      ≤ ((invariantG γ (shiftGroup (ι → ℤ) E)).extremePoints ℝ≥0∞).encard := by
  obtain ⟨ρ, hρ, hdet⟩ := isDiscriminating_extremePoints_invariantG hfm hdisc
  have hinj : Function.Injective ρ := by
    intro m m' hmm'
    by_contra hne
    exact hdet (Matrix.det_zero_of_row_eq hne (funext fun n ↦ by
      simp only [observableMatrix, Matrix.of_apply, hmm']))
  have hrange : Set.range ρ ⊆ (invariantG γ (shiftGroup (ι → ℤ) E)).extremePoints ℝ≥0∞ := by
    rintro _ ⟨m, rfl⟩; exact hρ m
  have hcard : (Set.range ρ).encard = (N : ℕ∞) + 1 := by
    rw [← Set.image_univ, (hinj.injOn).encard_image, Set.encard_univ]
    simp [ENat.card_eq_coe_fintype_card]
  rw [← hcard]
  exact Set.encard_le_encard hrange

end Comment1619

/-! ### Georgii Theorem (16.21) -/

section Theorem1621

open Potential Potential.BTheta

variable {ι E : Type*} [Fintype ι] [DecidableEq ι] [Nonempty ι] [MeasurableSpace E]
  [StandardBorelSpace E] (ν : Measure E) [IsProbabilityMeasure ν] {N : ℕ}
  {Λ₀ : Finset (ι → ℤ)} {f : Fin N → lp (fun _ : (ι → ℤ) → E ↦ ℝ) ∞}

/-- **The construction behind Theorem (16.21).** Let `μ` be a shift-invariant random field of
finite specific entropy whose invariant means `μ(f_a | 𝓘)` are nondegenerate. Then there is a
single `ε ∈ ]0, ε₀]` such that *every* affine space `Φ⁰ + ℬ_Θ(f₁, …, f_N)` contains a potential
`Φ` with `ε ‖Φ − Φ⁰‖₀ ≤ 𝓀(μ|Φ⁰)` which exhibits a phase transition with discriminating system
`{f₁, …, f_N}`.

This is Proposition (16.7) (through
`MeasureTheory.GibbsMeasure.exists_mem_invariantG_specificEnergy_le`), the estimates (16.22)
and (16.23) (`MeasureTheory.GibbsMeasure.hasNondegenerateInvariantMeans_of_specificEnergy_le`)
and Lemma (16.20) (`MeasureTheory.GibbsMeasure.isDiscriminating_invariantG_iff`). -/
theorem exists_pos_forall_exists_isDiscriminating {I : Set (ι → ℤ)} {C : Set (BTheta (ι → ℤ) E)}
    (hI : Iᶜ.Finite) (hCclosed : IsClosed C) (hCconv : Convex ℝ C)
    (hC0 : (0 : BTheta (ι → ℤ) E) ∈ C) (hCadd : ∀ Ψ ∈ C, ∀ Χ ∈ C, Ψ + Χ ∈ C)
    (hPmem : ∀ (a : Fin N → ℝ) (c : ℝ), localPotentialB Λ₀ (c • combo f a) ∈ C)
    (hQmem : ∀ (a : Fin N → ℝ), ∀ i ∈ I, localPotentialB (pairVolume Λ₀ i)
      ((-1 : ℝ) • (combo f a * lp.precomp (shift E i).toFun (combo f a))) ∈ C)
    (hΛ₀ : Λ₀.Nonempty) (hf : ∀ n, f n ∈ localFunctionsOn (ι → ℤ) E Λ₀)
    (hfm : ∀ n, Measurable ⇑(f n))
    {μ : Measure ((ι → ℤ) → E)} [IsProbabilityMeasure μ]
    (hμ : μ ∈ invariantFieldsOfFiniteEntropy ι E ν)
    (hnd : HasNondegenerateInvariantMeans (shiftGroup (ι → ℤ) E) μ f)
    {ε₀ : ℝ} (hε₀ : 0 < ε₀) :
    ∃ ε : ℝ, 0 < ε ∧ ε < 1 ∧ ε ≤ ε₀ ∧ ∀ Φ₀ : BTheta (ι → ℤ) E, ∃ Φ : BTheta (ι → ℤ) E,
      Φ - Φ₀ ∈ C ∧
      ε * ‖Φ - Φ₀‖ ≤ pressure ν Φ₀ + (Φ₀ : Potential (ι → ℤ) E).specificEnergy μ
        - (specificEntropy ν μ).toReal ∧
      IsDiscriminating (invariantG (gibbsSpecificationOfAbsolutelySummable
        (Φ := (Φ : Potential (ι → ℤ) E)) ν 1) (shiftGroup (ι → ℤ) E)) f := by
  obtain ⟨ε, hε0, hε1, hgap⟩ :=
    exists_pos_lt_one_forall_lt_invariantVariance hfm hnd (4 * #Λ₀)
  refine ⟨min ε ε₀, lt_min hε0 hε₀, (min_le_left _ _).trans_lt hε1, min_le_right _ _,
    fun Φ₀ ↦ ?_⟩
  have hmin0 : 0 < min ε ε₀ := lt_min hε0 hε₀
  have hgap' : ∀ a : Fin N → ℝ, a ≠ 0 →
      min ε ε₀ * (4 * #Λ₀ * ‖combo f a‖ ^ 2)
        < invariantVariance (shiftGroup (ι → ℤ) E) μ f a := by
    intro a ha
    refine lt_of_le_of_lt ?_ (hgap a ha)
    exact mul_le_mul_of_nonneg_right (min_le_left _ _) (by positivity)
  obtain ⟨Φ, hΦC, hnorm, ρ, hρG, hle⟩ :=
    exists_mem_invariantG_specificEnergy_le ν hμ hCclosed hCconv hC0 hCadd Φ₀ hmin0
  have : IsProbabilityMeasure ρ := hρG.1.1
  refine ⟨Φ, hΦC, hnorm, ?_⟩
  refine (isDiscriminating_invariantG_iff
    (shiftGroup_exists_disjoint_sites_preimage (E := E) (S := ι → ℤ)) hfm).2 ⟨ρ, hρG, ?_⟩
  exact hasNondegenerateInvariantMeans_of_specificEnergy_le hI hΛ₀ hf hfm hμ.1 hρG.2 hmin0.le
    hCadd hPmem hQmem hle hgap'

/-- **Theorem (16.21)** for Georgii's space `ℬ_Θ(f₁, …, f_N)` itself. -/
theorem exists_pos_forall_exists_isDiscriminating_BThetaOrder {I : Set (ι → ℤ)} (hI : Iᶜ.Finite)
    (hΛ₀ : Λ₀.Nonempty) (hf : ∀ n, f n ∈ localFunctionsOn (ι → ℤ) E Λ₀)
    (hfm : ∀ n, Measurable ⇑(f n))
    {μ : Measure ((ι → ℤ) → E)} [IsProbabilityMeasure μ]
    (hμ : μ ∈ invariantFieldsOfFiniteEntropy ι E ν)
    (hnd : HasNondegenerateInvariantMeans (shiftGroup (ι → ℤ) E) μ f)
    {ε₀ : ℝ} (hε₀ : 0 < ε₀) :
    ∃ ε : ℝ, 0 < ε ∧ ε < 1 ∧ ε ≤ ε₀ ∧ ∀ Φ₀ : BTheta (ι → ℤ) E, ∃ Φ : BTheta (ι → ℤ) E,
      Φ - Φ₀ ∈ BThetaOrder Λ₀ f I ∧
      ε * ‖Φ - Φ₀‖ ≤ pressure ν Φ₀ + (Φ₀ : Potential (ι → ℤ) E).specificEnergy μ
        - (specificEntropy ν μ).toReal ∧
      IsDiscriminating (invariantG (gibbsSpecificationOfAbsolutelySummable
        (Φ := (Φ : Potential (ι → ℤ) E)) ν 1) (shiftGroup (ι → ℤ) E)) f :=
  exists_pos_forall_exists_isDiscriminating ν hI
    (isClosed_BThetaOrder (Λ₀ := Λ₀) (f := f)) (BThetaOrder Λ₀ f I).convex
    (Submodule.zero_mem _) (fun _Ψ hΨ _Χ hΧ ↦ Submodule.add_mem _ hΨ hΧ)
    (fun a c ↦ localPotentialB_smul_combo_mem hΛ₀ hf c a)
    (fun a _i hi ↦ localPotentialB_pairVolume_smul_mem hΛ₀ hf hi (-1) a)
    hΛ₀ hf hfm hμ hnd hε₀

/-- **Georgii Theorem (16.21)(a).** If there are `N + 1` shift-invariant random fields of finite
specific entropy whose matrix of expectations `(μ_m(f_n))_{0 ≤ m,n ≤ N}` has full rank, then every
affine space `Φ⁰ + ℬ_Θ(f₁, …, f_N)` contains a potential which exhibits a phase transition with
discriminating system `{f₁, …, f_N}`.

Georgii's proof takes the uniform mixture `μ = (N+1)⁻¹ ∑_m μ_m`, which is again shift invariant of
finite specific entropy (`MeasureTheory.GibbsMeasure.specificEntropy_finsetSum_smul_ne_bot`) and
has nondegenerate invariant means by the proof of Lemma (16.20)(i) ⇒ (ii)
(`MeasureTheory.GibbsMeasure.hasNondegenerateInvariantMeans_of_det_ne_zero`). -/
theorem exists_isDiscriminating_of_isDiscriminating_invariantFieldsOfFiniteEntropy
    {I : Set (ι → ℤ)} (hI : Iᶜ.Finite)
    (hΛ₀ : Λ₀.Nonempty) (hf : ∀ n, f n ∈ localFunctionsOn (ι → ℤ) E Λ₀)
    (hfm : ∀ n, Measurable ⇑(f n))
    (hdisc : IsDiscriminating (invariantFieldsOfFiniteEntropy ι E ν) f)
    (Φ₀ : BTheta (ι → ℤ) E) :
    ∃ Φ : BTheta (ι → ℤ) E, Φ - Φ₀ ∈ BThetaOrder Λ₀ f I ∧
      IsDiscriminating (invariantG (gibbsSpecificationOfAbsolutelySummable
        (Φ := (Φ : Potential (ι → ℤ) E)) ν 1) (shiftGroup (ι → ℤ) E)) f := by
  obtain ⟨ρ, hρ, hdet⟩ := hdisc
  have hprob : ∀ m, IsProbabilityMeasure (ρ m) := fun m ↦ (hρ m).1.1
  have hne : ((N : ℝ≥0∞) + 1) ≠ 0 := by positivity
  have hnt : ((N : ℝ≥0∞) + 1) ≠ ⊤ := by finiteness
  have hcast : ((((N : ℝ≥0) + 1)⁻¹ : ℝ≥0) : ℝ≥0∞) = ((N : ℝ≥0∞) + 1)⁻¹ := by
    rw [ENNReal.coe_inv (by positivity)]
    congr 1
  set μ : Measure ((ι → ℤ) → E) := ∑ m : Fin (N + 1), ((N : ℝ≥0∞) + 1)⁻¹ • ρ m with hμdef
  have hsum : ∑ _m : Fin (N + 1), ((N : ℝ≥0∞) + 1)⁻¹ = 1 := by
    rw [Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul]
    push_cast
    exact ENNReal.mul_inv_cancel hne hnt
  have hμinv : μ ∈ invariantFields (shiftGroup (ι → ℤ) E) :=
    sum_smul_mem_invariantFields (fun m ↦ (hρ m).1) hsum
  have : IsProbabilityMeasure μ := hμinv.1
  have hcsum : ∑ _m : Fin (N + 1), (((N : ℝ≥0) + 1)⁻¹ : ℝ≥0) = 1 := by
    rw [Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul]
    push_cast
    field_simp
  have hmixeq : ∑ m : Fin (N + 1), (((N : ℝ≥0) + 1)⁻¹ : ℝ≥0) • ρ m = μ := by
    rw [hμdef]
    refine Finset.sum_congr rfl fun m _ ↦ ?_
    rw [ENNReal.smul_def, hcast]
  have hμent : specificEntropy ν μ ≠ ⊥ := by
    rw [← hmixeq]
    exact specificEntropy_finsetSum_smul_ne_bot ν hcsum fun m ↦ (hρ m).2
  have hmuFin : μ ∈ invariantFieldsOfFiniteEntropy ι E ν := ⟨hμinv, hμent⟩
  have hnd : HasNondegenerateInvariantMeans (shiftGroup (ι → ℤ) E) μ f :=
    hasNondegenerateInvariantMeans_of_det_ne_zero hμinv hfm (fun m ↦ (hρ m).1)
      (absolutelyContinuous_uniform_mixture ρ) hdet
  obtain ⟨ε, -, -, -, hmain⟩ :=
    exists_pos_forall_exists_isDiscriminating_BThetaOrder ν hI hΛ₀ hf hfm hmuFin hnd one_pos
  obtain ⟨Φ, hΦC, -, hdisc'⟩ := hmain Φ₀
  exact ⟨Φ, hΦC, hdisc'⟩

/-- **Georgii Theorem (16.21)(b).** If `Ψ ∈ ℬ_Θ` exhibits a phase transition with discriminating
system `{f₁, …, f_N}`, then for every `ε₀ > 0` there is a `δ > 0` such that every affine space
`Φ⁰ + ℬ_Θ(f₁, …, f_N)` with `‖Φ⁰ − Ψ‖₀ < δ` contains a potential `Φ` with `‖Φ − Ψ‖₀ < ε₀` which
again exhibits a phase transition with the same discriminating system. In particular, such
potentials are not isolated. -/
theorem exists_pos_forall_exists_isDiscriminating_norm_sub_lt
    {I : Set (ι → ℤ)} (hI : Iᶜ.Finite)
    (hΛ₀ : Λ₀.Nonempty) (hf : ∀ n, f n ∈ localFunctionsOn (ι → ℤ) E Λ₀)
    (hfm : ∀ n, Measurable ⇑(f n)) {Ψ : BTheta (ι → ℤ) E}
    (hΨ : IsDiscriminating (invariantG (gibbsSpecificationOfAbsolutelySummable
      (Φ := (Ψ : Potential (ι → ℤ) E)) ν 1) (shiftGroup (ι → ℤ) E)) f)
    {ε₀ : ℝ} (hε₀ : 0 < ε₀) :
    ∃ δ : ℝ, 0 < δ ∧ ∀ Φ₀ : BTheta (ι → ℤ) E, ‖Φ₀ - Ψ‖ < δ → ∃ Φ : BTheta (ι → ℤ) E,
      Φ - Φ₀ ∈ BThetaOrder Λ₀ f I ∧ ‖Φ - Ψ‖ < ε₀ ∧
      IsDiscriminating (invariantG (gibbsSpecificationOfAbsolutelySummable
        (Φ := (Φ : Potential (ι → ℤ) E)) ν 1) (shiftGroup (ι → ℤ) E)) f := by
  obtain ⟨μ, hμG, hnd⟩ := (isDiscriminating_invariantG_iff
    (shiftGroup_exists_disjoint_sites_preimage (E := E) (S := ι → ℤ)) hfm).1 hΨ
  have : IsProbabilityMeasure μ := hμG.1.1
  have hmuFin : μ ∈ invariantFieldsOfFiniteEntropy ι E ν :=
    mem_invariantFieldsOfFiniteEntropy_of_mem_invariantG ν hμG
  -- `𝓀(μ) = ⟨μ, Ψ⟩ + P(Ψ)`, since `μ ∈ 𝒢_Θ(Ψ)`
  have hentropy : (specificEntropy ν μ).toReal
      = (Ψ : Potential (ι → ℤ) E).specificEnergy μ + pressure ν Ψ := by
    rw [specificEntropy_eq_specificEnergy_add_pressure ν (isShiftInvariant Ψ) hμG.2 hμG.1.2,
      EReal.toReal_coe, pressure_apply]
  obtain ⟨ε, hε0, hε1, hεle, hmain⟩ :=
    exists_pos_forall_exists_isDiscriminating_BThetaOrder ν hI hΛ₀ hf hfm hmuFin hnd hε₀
  refine ⟨ε ^ 2 / 4, by positivity, fun Φ₀ hΦ₀ ↦ ?_⟩
  obtain ⟨Φ, hΦC, hnorm, hdisc⟩ := hmain Φ₀
  refine ⟨Φ, hΦC, ?_, hdisc⟩
  -- `𝓀(μ|Φ⁰) ≤ 2 ‖Φ⁰ − Ψ‖₀`, by the Lipschitz continuity of the pressure and `|⟨μ, ·⟩| ≤ ‖·‖₀`
  have hP : |pressure ν Φ₀ - pressure ν Ψ| ≤ ‖Φ₀ - Ψ‖ := by
    have := (lipschitzWith_pressure ν).dist_le_mul Φ₀ Ψ
    rwa [Real.dist_eq, NNReal.coe_one, one_mul, dist_eq_norm] at this
  have hE : |(Φ₀ : Potential (ι → ℤ) E).specificEnergy μ
      - (Ψ : Potential (ι → ℤ) E).specificEnergy μ| ≤ ‖Φ₀ - Ψ‖ := by
    have h := abs_apply_le_norm_of_isBoundedBy ν
      (isBoundedBy_pressure_specificEnergyFunctional ν hmuFin) (Φ₀ - Ψ)
    rw [specificEnergyFunctional_apply, Submodule.coe_sub, specificEnergy_sub, abs_neg] at h
    exact h
  have hrel : pressure ν Φ₀ + (Φ₀ : Potential (ι → ℤ) E).specificEnergy μ
      - (specificEntropy ν μ).toReal ≤ 2 * ‖Φ₀ - Ψ‖ := by
    rw [hentropy]
    rw [abs_le] at hP hE
    linarith [hP.1, hP.2, hE.1, hE.2]
  have hΦΦ₀ : ‖Φ - Φ₀‖ < ε / 2 := by
    have h1 : ε * ‖Φ - Φ₀‖ ≤ 2 * ‖Φ₀ - Ψ‖ := hnorm.trans hrel
    have h2 : 2 * ‖Φ₀ - Ψ‖ < 2 * (ε ^ 2 / 4) := by linarith
    have h3 : ε * ‖Φ - Φ₀‖ < ε * (ε / 2) := by nlinarith
    exact lt_of_mul_lt_mul_left (by linarith) hε0.le
  calc ‖Φ - Ψ‖ = ‖(Φ - Φ₀) + (Φ₀ - Ψ)‖ := by rw [sub_add_sub_cancel]
    _ ≤ ‖Φ - Φ₀‖ + ‖Φ₀ - Ψ‖ := norm_add_le _ _
    _ < ε / 2 + ε ^ 2 / 4 := by linarith
    _ ≤ ε₀ := by nlinarith

/-- **Georgii Comment (16.24)(1).** The phase-transition potential of Theorem (16.21) can be
required to have *no* interaction term on any of finitely many prescribed volumes `Λ_i`, `i ∈ T`.
Since on `ℤ^d` only finitely many `Λ_i = Λ₀ ∪ (Λ₀ − i)` have diameter below a given `R`, this is
Georgii's statement that `ℬ_Θ(f₁, …, f_N)` may be replaced by `ℬ^R_Θ(f₁, …, f_N)`: the potential
`Φ` can be made of arbitrarily long range. -/
theorem exists_isDiscriminating_of_finite_excluded (T : Finset (ι → ℤ))
    (hΛ₀ : Λ₀.Nonempty) (hf : ∀ n, f n ∈ localFunctionsOn (ι → ℤ) E Λ₀)
    (hfm : ∀ n, Measurable ⇑(f n))
    (hdisc : IsDiscriminating (invariantFieldsOfFiniteEntropy ι E ν) f)
    (Φ₀ : BTheta (ι → ℤ) E) :
    ∃ Φ : BTheta (ι → ℤ) E, Φ - Φ₀ ∈ BThetaOrder Λ₀ f ((T : Set (ι → ℤ))ᶜ) ∧
      IsDiscriminating (invariantG (gibbsSpecificationOfAbsolutelySummable
        (Φ := (Φ : Potential (ι → ℤ) E)) ν 1) (shiftGroup (ι → ℤ) E)) f :=
  exists_isDiscriminating_of_isDiscriminating_invariantFieldsOfFiniteEntropy ν
    (by simp) hΛ₀ hf hfm hdisc Φ₀

/-- **Georgii Theorem (16.21)(a), complete statement.** Under the hypothesis of (16.21)(a) every
affine space `Φ⁰ + ℬ_Θ(f₁, …, f_N)` contains a potential `Φ` with `Φ ≪ {f₁, …, f_N}`, and such a
`Φ` has at least `N + 1` extreme shift-invariant Gibbs measures (Comment (16.19)). -/
theorem exists_isDiscriminating_and_le_encard_extremePoints {I : Set (ι → ℤ)} (hI : Iᶜ.Finite)
    (hΛ₀ : Λ₀.Nonempty) (hf : ∀ n, f n ∈ localFunctionsOn (ι → ℤ) E Λ₀)
    (hfm : ∀ n, Measurable ⇑(f n))
    (hdisc : IsDiscriminating (invariantFieldsOfFiniteEntropy ι E ν) f)
    (Φ₀ : BTheta (ι → ℤ) E) :
    ∃ Φ : BTheta (ι → ℤ) E, Φ - Φ₀ ∈ BThetaOrder Λ₀ f I ∧
      IsDiscriminating (invariantG (gibbsSpecificationOfAbsolutelySummable
        (Φ := (Φ : Potential (ι → ℤ) E)) ν 1) (shiftGroup (ι → ℤ) E)) f ∧
      ((N : ℕ∞) + 1) ≤ ((invariantG (gibbsSpecificationOfAbsolutelySummable
          (Φ := (Φ : Potential (ι → ℤ) E)) ν 1)
        (shiftGroup (ι → ℤ) E)).extremePoints ℝ≥0∞).encard := by
  obtain ⟨Φ, hΦC, hd⟩ :=
    exists_isDiscriminating_of_isDiscriminating_invariantFieldsOfFiniteEntropy ν hI hΛ₀ hf hfm
      hdisc Φ₀
  exact ⟨Φ, hΦC, hd, le_encard_extremePoints_invariantG_of_isDiscriminating hfm hd⟩

/-- **Georgii Comment (16.24)(2).** For a single observable `f` (`N = 1`) Theorem (16.21) holds
with `ℬ_Θ(f)` replaced by the closed convex cone `ℬ⁻_Θ(f)`: the phase-transition potential can be
required to interact ferromagnetically, `Φ_{Λ_i}` being a *nonpositive* multiple of
`f (f ∘ θ_i)`. Combined with the freedom in `I` this is Georgii's statement that `ℬ_Θ(f)` may be
replaced by `ℬ⁻_Θ(f) ∩ ℬ^R_Θ(f)` for every `R`. -/
theorem exists_pos_forall_exists_isDiscriminating_neg {I : Set (ι → ℤ)} (hI : Iᶜ.Finite)
    {Λ₀ : Finset (ι → ℤ)} (hΛ₀ : Λ₀.Nonempty)
    {g : lp (fun _ : (ι → ℤ) → E ↦ ℝ) ∞} (hg : g ∈ localFunctionsOn (ι → ℤ) E Λ₀)
    (hgm : Measurable ⇑g) {μ : Measure ((ι → ℤ) → E)} [IsProbabilityMeasure μ]
    (hμ : μ ∈ invariantFieldsOfFiniteEntropy ι E ν)
    (hnd : HasNondegenerateInvariantMeans (shiftGroup (ι → ℤ) E) μ (fun _ : Fin 1 ↦ g))
    {ε₀ : ℝ} (hε₀ : 0 < ε₀) :
    ∃ ε : ℝ, 0 < ε ∧ ε < 1 ∧ ε ≤ ε₀ ∧ ∀ Φ₀ : BTheta (ι → ℤ) E, ∃ Φ : BTheta (ι → ℤ) E,
      Φ - Φ₀ ∈ BThetaOrderNeg Λ₀ g I ∧
      ε * ‖Φ - Φ₀‖ ≤ pressure ν Φ₀ + (Φ₀ : Potential (ι → ℤ) E).specificEnergy μ
        - (specificEntropy ν μ).toReal ∧
      IsDiscriminating (invariantG (gibbsSpecificationOfAbsolutelySummable
        (Φ := (Φ : Potential (ι → ℤ) E)) ν 1) (shiftGroup (ι → ℤ) E)) (fun _ : Fin 1 ↦ g) :=
  exists_pos_forall_exists_isDiscriminating ν hI (isClosed_BThetaOrderNeg Λ₀ g I)
    (BThetaOrderNeg Λ₀ g I).convex (Submodule.zero_mem _)
    (fun _Ψ hΨ _Χ hΧ ↦ Submodule.add_mem _ hΨ hΧ)
    (fun a c ↦ localPotentialB_smul_combo_mem_neg hΛ₀ hg I a c)
    (fun a _i hi ↦ localPotentialB_pairVolume_smul_mem_neg hΛ₀ hg a hi)
    hΛ₀ (fun _ ↦ hg) (fun _ ↦ hgm) hμ hnd hε₀

end Theorem1621

/-! ### Georgii (16.29) and Theorem (16.30): potentials with broken shift invariance -/

section Oscillating

open Potential Potential.BTheta

variable {ι E : Type*} [Fintype ι] [DecidableEq ι] [MeasurableSpace E]

omit [DecidableEq ι] in
/-- The specific energy of `Φ^{(Λ_i, f (f ∘ θ_i))}` is the correlation `μ(f · f ∘ θ_i)`. -/
lemma specificEnergy_localPotentialB_pairObservable {Λ₀ : Finset (ι → ℤ)} (hΛ₀ : Λ₀.Nonempty)
    {f : lp (fun _ : (ι → ℤ) → E ↦ ℝ) ∞} (hf : f ∈ localFunctionsOn (ι → ℤ) E Λ₀) (i : ι → ℤ)
    {μ : Measure ((ι → ℤ) → E)} [IsProbabilityMeasure μ]
    (hμ : μ ∈ invariantFields (shiftGroup (ι → ℤ) E)) :
    ((localPotentialB (pairVolume Λ₀ i) (pairObservable (fun _ : Fin 1 ↦ f) i (0, 0)) :
        BTheta (ι → ℤ) E) : Potential (ι → ℤ) E).specificEnergy μ = correlation f μ i := by
  rw [specificEnergy_localPotentialB (pairVolume_nonempty hΛ₀ i)
    (pairObservable_mem_localFunctionsOn (fun _ ↦ hf) i (0, 0)) hμ]
  rfl

omit [DecidableEq ι] in
/-- `‖Φ^{(Λ_i, f (f ∘ θ_i))}‖₀ ≤ 2 |Λ₀| ‖f‖²`, the estimate of Georgii (16.22). -/
lemma norm_localPotentialB_pairObservable_le {Λ₀ : Finset (ι → ℤ)} (hΛ₀ : Λ₀.Nonempty)
    {f : lp (fun _ : (ι → ℤ) → E ↦ ℝ) ∞} (hf : f ∈ localFunctionsOn (ι → ℤ) E Λ₀) (i : ι → ℤ) :
    ‖localPotentialB (pairVolume Λ₀ i) (pairObservable (fun _ : Fin 1 ↦ f) i (0, 0))‖
      ≤ 2 * #Λ₀ * (‖f‖ * ‖f‖) := by
  rw [norm_localPotentialB (pairVolume_nonempty hΛ₀ i)
    (pairObservable_mem_localFunctionsOn (fun _ ↦ hf) i (0, 0))]
  have hcard : (#(pairVolume Λ₀ i) : ℝ) ≤ 2 * #Λ₀ := by
    exact_mod_cast card_pairVolume_le Λ₀ i
  have hobs : ‖pairObservable (fun _ : Fin 1 ↦ f) i (0, 0)‖ ≤ ‖f‖ * ‖f‖ :=
    (norm_mul_le _ _).trans
      (mul_le_mul_of_nonneg_left (lp.norm_precomp_le _ f) (norm_nonneg f))
  exact mul_le_mul hcard hobs (norm_nonneg _) (by positivity)

/-- **Georgii Theorem (16.30).** Let `f` be a bounded local observable, `I ⊆ ℤ^d` an infinite set
of sites and `μ` an `f`-`I`-oscillating shift-invariant random field of finite specific entropy.
Then every `Φ⁰ ∈ ℬ_Θ` can be modified inside `ℬ^I_Θ(f)` — i.e. only in the interaction terms
attached to the volumes `Λ_i`, `i ∈ I` — into a potential `Φ` which admits an `f`-`I`-oscillating
*shift-invariant* Gibbs measure.

The proof is Proposition (16.7) applied to the closed subspace `ℬ^I_Θ(f)`, in the form
`MeasureTheory.GibbsMeasure.exists_mem_invariantG_specificEnergy_le`: because `ℬ^I_Θ(f)` is a
*subspace*, the one-sided estimate of (16.7) applies to `±Φ^{(Λ_i, f (f ∘ θ_i))}` and yields the
two-sided bound `|ρ(f · f ∘ θ_i) − μ(f · f ∘ θ_i)| ≤ 2ε|Λ₀| ‖f‖²` for all `i ∈ I`.

Georgii asks that the two sides of (16.29) differ by more than `2ε|Λ₀|‖f‖²`; the correct constant
is `4ε|Λ₀|‖f‖²`, since each of `limsup` and `liminf` moves by up to `2ε|Λ₀|‖f‖²`. Here `ε` is
chosen accordingly, so the statement is unaffected. -/
theorem exists_mem_invariantG_isOscillating [Nonempty ι] [StandardBorelSpace E]
    (ν : Measure E) [IsProbabilityMeasure ν]
    {Λ₀ : Finset (ι → ℤ)} (hΛ₀ : Λ₀.Nonempty)
    {f : lp (fun _ : (ι → ℤ) → E ↦ ℝ) ∞} (hf : f ∈ localFunctionsOn (ι → ℤ) E Λ₀)
    {I : Set (ι → ℤ)} (hI : I.Infinite) {μ : Measure ((ι → ℤ) → E)}
    (hμ : μ ∈ invariantFieldsOfFiniteEntropy ι E ν) (hosc : IsOscillating I f μ)
    (Φ₀ : BTheta (ι → ℤ) E) :
    ∃ Φ : BTheta (ι → ℤ) E, Φ - Φ₀ ∈ BThetaOrder Λ₀ (fun _ : Fin 1 ↦ f) I ∧
      ∃ ρ ∈ invariantG (gibbsSpecificationOfAbsolutelySummable
        (Φ := (Φ : Potential (ι → ℤ) E)) ν 1) (shiftGroup (ι → ℤ) E), IsOscillating I f ρ := by
  have : IsProbabilityMeasure μ := hμ.1.1
  have : (atInfinityWithin I).NeBot := atInfinityWithin_neBot hI
  set F := atInfinityWithin I with hF
  set M : ℝ := 2 * #Λ₀ * (‖f‖ * ‖f‖) with hM
  have hM0 : 0 ≤ M := by positivity
  set d : ℝ := Filter.limsup (correlation f μ) F - Filter.liminf (correlation f μ) F with hd
  have hd0 : 0 < d := sub_pos.2 hosc
  set ε : ℝ := d / (4 * (M + 1)) with hε
  have hε0 : 0 < ε := by positivity
  have hεM : 2 * (ε * M) < d := by
    have h4 : (0 : ℝ) < 4 * (M + 1) := by positivity
    have he : ε * M = d * M / (4 * (M + 1)) := by rw [hε]; ring
    rw [he, mul_div_assoc', div_lt_iff₀ h4]
    nlinarith
  set C : Set (BTheta (ι → ℤ) E) := ↑(BThetaOrder Λ₀ (fun _ : Fin 1 ↦ f) I) with hC
  obtain ⟨Φ, hΦC, -, ρ, hρG, hle⟩ :=
    exists_mem_invariantG_specificEnergy_le ν hμ (isClosed_BThetaOrder (Λ₀ := Λ₀))
      (BThetaOrder Λ₀ (fun _ : Fin 1 ↦ f) I).convex (Submodule.zero_mem _)
      (fun _Ψ hΨ _Χ hΧ ↦ Submodule.add_mem _ hΨ hΧ) Φ₀ hε0
  have : IsProbabilityMeasure ρ := hρG.1.1
  refine ⟨Φ, hΦC, ρ, hρG, ?_⟩
  have hclose : ∀ i ∈ I, |correlation f μ i - correlation f ρ i| ≤ ε * M := by
    intro i hi
    set Ψ : BTheta (ι → ℤ) E :=
      localPotentialB (pairVolume Λ₀ i) (pairObservable (fun _ : Fin 1 ↦ f) i (0, 0)) with hΨ
    have hΨC : Ψ ∈ C := subset_BThetaOrder (Or.inr ⟨i, hi, (0, 0), rfl⟩)
    have hnegC : -Ψ ∈ C := Submodule.neg_mem _ hΨC
    have h1 := hle Ψ hΨC
    have h2 := hle (-Ψ) hnegC
    rw [specificEnergy_localPotentialB_pairObservable hΛ₀ hf i hρG.2,
      specificEnergy_localPotentialB_pairObservable hΛ₀ hf i hμ.1] at h1
    rw [Submodule.coe_neg, ← neg_one_smul ℝ (((localPotentialB (pairVolume Λ₀ i)
        (pairObservable (fun _ : Fin 1 ↦ f) i (0, 0)) : BTheta (ι → ℤ) E)) :
          Potential (ι → ℤ) E), specificEnergy_smul, specificEnergy_smul,
      specificEnergy_localPotentialB_pairObservable hΛ₀ hf i hρG.2,
      specificEnergy_localPotentialB_pairObservable hΛ₀ hf i hμ.1, norm_neg] at h2
    have hnorm : ‖Ψ‖ ≤ M := norm_localPotentialB_pairObservable_le hΛ₀ hf i
    have hεnorm : ε * ‖Ψ‖ ≤ ε * M := mul_le_mul_of_nonneg_left hnorm hε0.le
    rw [abs_le]
    constructor <;> linarith
  refine Filter.liminf_lt_limsup_of_eventually_abs_sub_le
    (M := ‖f‖ * ‖f‖) (c := ε * M) (fun i ↦ abs_correlation_le f μ i)
    (fun i ↦ abs_correlation_le f ρ i) ?_ ?_
  · filter_upwards [Filter.eventually_inf_principal.2 (Filter.Eventually.of_forall fun i hi ↦ hi)]
      with i hi using hclose i hi
  · exact hεM

end Oscillating

/-! ### Georgii Example (16.25)(1): the lattice gas with `N + 1` states -/

section Example1625

open Potential Potential.BTheta ProbabilityTheory

variable {ι : Type*} [Fintype ι] [LinearOrder ι] [Nonempty ι] {N : ℕ}

/-- **Georgii Example (16.25)(1):** the observables `f_n = 1_{σ₀ = n}`, `1 ≤ n ≤ N`, on the state
space `E = {0, 1, …, N}`, spelled `Fin (N + 1)`. -/
def gasObservable (ι : Type*) (n : Fin N) : lp (fun _ : (ι → ℤ) → Fin (N + 1) ↦ ℝ) ∞ :=
  indicatorLp {ω : (ι → ℤ) → Fin (N + 1) | ω 0 = n.succ}

omit [Fintype ι] [LinearOrder ι] [Nonempty ι] in
lemma measurableSet_cylinderEvents_spinAt (c : Fin (N + 1)) :
    MeasurableSet[cylinderEvents (X := fun _ : ι → ℤ ↦ Fin (N + 1))
        ((({0} : Finset (ι → ℤ)) : Set (ι → ℤ)))]
      {ω : (ι → ℤ) → Fin (N + 1) | ω 0 = c} := by
  have hmeas : Measurable[cylinderEvents (X := fun _ : ι → ℤ ↦ Fin (N + 1))
      ((({0} : Finset (ι → ℤ)) : Set (ι → ℤ)))] (fun ω : (ι → ℤ) → Fin (N + 1) ↦ ω 0) := by
    refine measurable_cylinderEvents_iff_dependsOn.2 ⟨measurable_pi_apply 0, fun ω ω' h ↦ ?_⟩
    exact h 0 (by simp)
  exact hmeas (measurableSet_singleton c)

omit [Fintype ι] [LinearOrder ι] [Nonempty ι] in
lemma gasObservable_mem_localFunctionsOn (n : Fin N) :
    gasObservable ι n ∈ localFunctionsOn (ι → ℤ) (Fin (N + 1)) {0} :=
  indicatorLp_mem_localFunctionsOn (measurableSet_cylinderEvents_spinAt _)

omit [Fintype ι] [LinearOrder ι] [Nonempty ι] in
lemma measurable_gasObservable (n : Fin N) : Measurable ⇑(gasObservable ι n) :=
  (mem_localFunctionsOn.1 (gasObservable_mem_localFunctionsOn n)).mono cylinderEvents_le_pi le_rfl

omit [Fintype ι] [LinearOrder ι] [Nonempty ι] in
/-- Georgii's `δ_m`, the Dirac measure at the constant configuration with value `m`, is shift
invariant. -/
lemma dirac_const_mem_invariantFields (m : Fin (N + 1)) :
    (Measure.dirac (fun _ : ι → ℤ ↦ m) : Measure ((ι → ℤ) → Fin (N + 1)))
      ∈ invariantFields (shiftGroup (ι → ℤ) (Fin (N + 1))) := by
  refine mem_invariantFields_shiftGroup.2
    ⟨inferInstance, fun j ↦ ⟨(shift (Fin (N + 1)) j).measurable_toFun, ?_⟩⟩
  rw [Measure.map_dirac' (shift (Fin (N + 1)) j).measurable_toFun (fun _ : ι → ℤ ↦ m)]
  congr 1

omit [Fintype ι] [LinearOrder ι] [Nonempty ι] in
/-- The expectations of `1, f₁, …, f_N` under `δ_m`: the matrix of Georgii Example (16.25)(1) has
first column `1` and the identity elsewhere. -/
lemma observableVector_dirac_const (m n : Fin (N + 1)) :
    observableVector (gasObservable ι) (Measure.dirac (fun _ : ι → ℤ ↦ m)) n
      = if n = 0 then 1 else if m = n then 1 else 0 := by
  refine Fin.cases ?_ (fun k ↦ ?_) n
  · simp [observableVector]
  · rw [observableVector_succ]
    have hmeas : Measurable ⇑(gasObservable ι k) := measurable_gasObservable k
    rw [integral_dirac' _ _ hmeas.stronglyMeasurable, gasObservable, coeFn_indicatorLp]
    have hsucc : (k.succ : Fin (N + 1)) ≠ 0 := Fin.succ_ne_zero k
    simp only [ite_eq_right hsucc]
    by_cases hmk : m = k.succ
    · rw [Set.indicator_of_mem (show (fun _ : ι → ℤ ↦ m) ∈
        {ω : (ι → ℤ) → Fin (N + 1) | ω 0 = k.succ} from hmk)]
      simp [hmk]
    · rw [Set.indicator_of_notMem (show (fun _ : ι → ℤ ↦ m) ∉
        {ω : (ι → ℤ) → Fin (N + 1) | ω 0 = k.succ} from hmk)]
      simp [hmk]

omit [Fintype ι] [LinearOrder ι] [Nonempty ι] in
/-- **Georgii Example (16.25)(1).** On the state space `E = {0, …, N}` with the uniform a priori
measure, the family `{1_{σ₀=1}, …, 1_{σ₀=N}}` is a discriminating system for *all* shift-invariant
random fields: the `N + 1` Dirac measures at the constant configurations already give a matrix of
expectations of full rank. -/
theorem isDiscriminating_gasObservable :
    IsDiscriminating (invariantFields (shiftGroup (ι → ℤ) (Fin (N + 1)))) (gasObservable ι) := by
  rw [isDiscriminating_iff_span_eq_top]
  set W : Submodule ℝ (Fin (N + 1) → ℝ) :=
    Submodule.span ℝ (observableVector (gasObservable ι) ''
      invariantFields (shiftGroup (ι → ℤ) (Fin (N + 1)))) with hW
  have hmem : ∀ m : Fin (N + 1),
      observableVector (gasObservable ι) (Measure.dirac (fun _ : ι → ℤ ↦ m)) ∈ W :=
    fun m ↦ Submodule.subset_span ⟨_, dirac_const_mem_invariantFields m, rfl⟩
  have hsingle : ∀ n : Fin (N + 1), (Pi.single n 1 : Fin (N + 1) → ℝ) ∈ W := by
    intro n
    rcases eq_or_ne n 0 with rfl | hn
    · have heq : (Pi.single (0 : Fin (N + 1)) 1 : Fin (N + 1) → ℝ)
          = observableVector (gasObservable ι)
            (Measure.dirac (fun _ : ι → ℤ ↦ (0 : Fin (N + 1)))) := by
        funext k
        simp only [observableVector_dirac_const, Pi.single_apply]
        rcases eq_or_ne k 0 with rfl | hk
        · simp
        · simp [hk, Ne.symm hk]
      rw [heq]; exact hmem 0
    · have heq : (Pi.single n 1 : Fin (N + 1) → ℝ)
          = observableVector (gasObservable ι) (Measure.dirac (fun _ : ι → ℤ ↦ n))
            - observableVector (gasObservable ι)
              (Measure.dirac (fun _ : ι → ℤ ↦ (0 : Fin (N + 1)))) := by
        funext k
        simp only [Pi.sub_apply, observableVector_dirac_const, Pi.single_apply]
        rcases eq_or_ne k 0 with rfl | hk
        · simp [Ne.symm hn]
        · simp only [ite_eq_right hk, ite_eq_right (Ne.symm hk), sub_zero]
          rcases eq_or_ne k n with rfl | hkn
          · rfl
          · rw [ite_eq_right hkn, ite_eq_right (Ne.symm hkn)]
      rw [heq]
      exact Submodule.sub_mem _ (hmem n) (hmem 0)
  refine top_unique ?_
  rw [← (Pi.basisFun ℝ (Fin (N + 1))).span_eq]
  refine Submodule.span_le.2 ?_
  rintro _ ⟨n, rfl⟩
  rw [Pi.basisFun_apply]
  exact hsingle n

omit [Nonempty ι] in
/-- Georgii Example (16.25)(1): the Dirac measures at the constant configurations lie in
`𝓟^λ_Θ`, because over a finite state space with the uniform a priori measure every shift-invariant
random field has finite specific entropy. -/
lemma isDiscriminating_gasObservable' :
    IsDiscriminating (invariantFieldsOfFiniteEntropy ι (Fin (N + 1)) (uniformOn Set.univ))
      (gasObservable ι) := by
  refine isDiscriminating_gasObservable.mono fun μ hμ ↦ ?_
  exact ⟨hμ, specificEntropy_uniformOn_ne_bot hμ⟩

/-- **Georgii Example (16.25)(1).** For every `Φ⁰ ∈ ℬ_Θ` over the state space `{0, …, N}` there is
a potential `Φ ∈ Φ⁰ + ℬ_Θ(1_{σ₀=1}, …, 1_{σ₀=N})` with at least `N + 1` extreme shift-invariant
Gibbs measures, told apart by the densities of the `N` non-vacuum states. The interaction terms on
any prescribed finite family of volumes `Λ_i` can be required to vanish, so `Φ − Φ⁰` can be made of
arbitrarily long range. -/
theorem exists_isDiscriminating_gasObservable {I : Set (ι → ℤ)} (hI : Iᶜ.Finite)
    (Φ₀ : Potential.BTheta (ι → ℤ) (Fin (N + 1))) :
    ∃ Φ : Potential.BTheta (ι → ℤ) (Fin (N + 1)),
      Φ - Φ₀ ∈ BThetaOrder {0} (gasObservable ι) I ∧
      IsDiscriminating (invariantG (gibbsSpecificationOfAbsolutelySummable
          (Φ := (Φ : Potential (ι → ℤ) (Fin (N + 1)))) (uniformOn Set.univ) 1)
          (shiftGroup (ι → ℤ) (Fin (N + 1)))) (gasObservable ι) ∧
      ((N : ℕ∞) + 1) ≤ ((invariantG (gibbsSpecificationOfAbsolutelySummable
          (Φ := (Φ : Potential (ι → ℤ) (Fin (N + 1)))) (uniformOn Set.univ) 1)
          (shiftGroup (ι → ℤ) (Fin (N + 1)))).extremePoints ℝ≥0∞).encard := by
  exact exists_isDiscriminating_and_le_encard_extremePoints (uniformOn Set.univ) hI
    (Finset.singleton_nonempty _) gasObservable_mem_localFunctionsOn
    (fun n ↦ measurable_gasObservable n) isDiscriminating_gasObservable' Φ₀

end Example1625

end MeasureTheory.GibbsMeasure

