/-!
# Affine signed permutations and the mirrors of the cubic lattice

The affine signed permutations `x ↦ k + r x` (`k ∈ ℤ^ι`, `r` a signed permutation) form Mathlib's
semidirect product `AffineSignedPerm ι = ℤ^ι ⋊ SignedPerm ι` (`ℤ^ι` written multiplicatively);
for finite `ι` this is the symmetry group of the lattice `ℤ^ι ⊆ ℝ^ι` and the affine Weyl group of
type `C̃`. It acts on `ι → R` for every ring `R` (`smul_apply`), by affine equivalences
(`toAffineEquiv`), continuously for a topological ring. The translation part `translationPart g`
is `W`-equivariant (`translationPart_mul`).

The *mirrors* are the hyperplanes
`mirror n m = {x | (2 / (n ⬝ᵥ n)) (n ⬝ᵥ x) = m}`, `m ∈ ℤ`, `n ∈ ℤ^ι`, `n ⬝ᵥ n ∣ 2`:
by `mem_sUnion_mirrors_iff` they are the coordinate planes `{x_i = m / 2}` and the diagonal planes
`{x_i ± x_j = m}`, `i ≠ j`. The reflection in a mirror is the affine signed permutation
`mirrorReflection n hn m : x ↦ x - ((2 / (n ⬝ᵥ n)) (n ⬝ᵥ x) - m) n` (`mirrorReflection_smul`); it
fixes the mirror and is an involution. The group permutes the mirrors (`smul_mem_mirror_iff`,
`smul_mem_sUnion_mirrors_iff`) and is generated by the mirror reflections
(`closure_range_mirrorReflection`).
-/

@[expose] public section

open Equiv Finset Function Matrix SemidirectProduct
open scoped Pointwise

namespace SignedPerm

variable {ι : Type*}

/-- Signed permutations act on the translation group `ℤ^ι`, written multiplicatively. -/
def toMulAutMultiplicative : SignedPerm ι →* MulAut (Multiplicative (ι → ℤ)) where
  toFun r := AddEquiv.toMultiplicative (DistribMulAction.toAddEquiv (ι → ℤ) r)
  map_one' := MulEquiv.ext fun x ↦ by simp
  map_mul' r r' := MulEquiv.ext fun x ↦ by simp [mul_smul]

@[simp]
theorem toMulAutMultiplicative_apply (r : SignedPerm ι) (k : Multiplicative (ι → ℤ)) :
    toMulAutMultiplicative r k = Multiplicative.ofAdd (r • k.toAdd) :=
  rfl

end SignedPerm

/-- The **affine signed permutations** `x ↦ k + r x` of `ι → R`, `k ∈ ℤ^ι` and `r` a signed
permutation: the symmetry group `ℤ^ι ⋊ O(ι, ℤ)` of the lattice `ℤ^ι`. The element `⟨k, r⟩` is
the translation by `k` after `r`. -/
abbrev AffineSignedPerm (ι : Type*) :=
  Multiplicative (ι → ℤ) ⋊[SignedPerm.toMulAutMultiplicative] SignedPerm ι

namespace AffineSignedPerm

variable {ι R : Type*}

/-- The translation part `k` of `x ↦ k + r x`. -/
def translationPart (g : AffineSignedPerm ι) : ι → ℤ :=
  g.left.toAdd

theorem translationPart_mul (g h : AffineSignedPerm ι) :
    translationPart (g * h) = translationPart g + g.right • translationPart h :=
  rfl

@[simp]
theorem translationPart_one : translationPart (1 : AffineSignedPerm ι) = 0 :=
  rfl

@[simp]
theorem translationPart_inl (k : Multiplicative (ι → ℤ)) :
    translationPart (inl k : AffineSignedPerm ι) = k.toAdd :=
  rfl

@[simp]
theorem translationPart_inr (r : SignedPerm ι) :
    translationPart (inr r : AffineSignedPerm ι) = 0 :=
  rfl

theorem translationPart_inv (g : AffineSignedPerm ι) :
    translationPart g⁻¹ = -(g.right⁻¹ • translationPart g) := by
  change Multiplicative.toAdd (SignedPerm.toMulAutMultiplicative g.right⁻¹ g.left⁻¹) = _
  rw [SignedPerm.toMulAutMultiplicative_apply, toAdd_ofAdd, toAdd_inv, smul_neg]
  rfl

/-! ### The action on `ι → R` -/

section Action

variable [Ring R]

instance : MulAction (AffineSignedPerm ι) (ι → R) where
  smul g x := (fun i ↦ (translationPart g i : R)) + g.right • x
  one_smul x := by
    change (fun i ↦ ((0 : ι → ℤ) i : R)) + (1 : SignedPerm ι) • x = x
    ext i
    simp
  mul_smul g h x := by
    change (fun i ↦ (translationPart (g * h) i : R)) + (g.right * h.right) • x =
      (fun i ↦ (translationPart g i : R)) +
        g.right • ((fun i ↦ (translationPart h i : R)) + h.right • x)
    rw [translationPart_mul, smul_add, mul_smul, ← add_assoc]
    congr 2
    have := SignedPerm.comp_smul (Int.castAddHom R) g.right (translationPart h)
    simp only [Int.coe_castAddHom] at this
    rw [← this]
    ext i
    simp

theorem smul_def (g : AffineSignedPerm ι) (x : ι → R) :
    g • x = (fun i ↦ (translationPart g i : R)) + g.right • x :=
  rfl

theorem smul_apply (g : AffineSignedPerm ι) (x : ι → R) (i : ι) :
    (g • x) i = translationPart g i + (g.right • x) i :=
  rfl

@[simp]
theorem inl_smul (k : Multiplicative (ι → ℤ)) (x : ι → R) :
    (inl k : AffineSignedPerm ι) • x = (fun i ↦ (k.toAdd i : R)) + x := by
  simp [smul_def]

@[simp]
theorem inr_smul (r : SignedPerm ι) (x : ι → R) : (inr r : AffineSignedPerm ι) • x = r • x := by
  ext i
  simp [smul_apply]

/-- On the lattice, `g • k` is the integer point `translationPart g + g.right • k`. -/
theorem smul_intCast (g : AffineSignedPerm ι) (k : ι → ℤ) :
    (g • fun i ↦ (k i : R)) = fun i ↦ ((g • k) i : R) := by
  ext i
  simp [smul_apply, SignedPerm.smul_apply, Units.smul_def]

/-- The image of `0` is the translation part. -/
theorem smul_zero_eq (g : AffineSignedPerm ι) :
    g • (0 : ι → R) = fun i ↦ (translationPart g i : R) := by
  simp [smul_def]

/-- `translationPart (g * h) = g • translationPart h`: the translation part is equivariant. -/
theorem translationPart_mul_eq_smul (g h : AffineSignedPerm ι) :
    translationPart (g * h) = g • translationPart h := by
  rw [translationPart_mul, smul_def]
  simp

variable (R) in
/-- The action of `g` as an affine equivalence of `ι → R`. -/
def toAffineEquiv (g : AffineSignedPerm ι) : (ι → R) ≃ᵃ[R] (ι → R) :=
  (DistribMulAction.toLinearEquiv R (ι → R) g.right).toAffineEquiv.trans
    (AffineEquiv.constVAdd R (ι → R) fun i ↦ (translationPart g i : R))

@[simp]
theorem toAffineEquiv_apply (g : AffineSignedPerm ι) (x : ι → R) :
    toAffineEquiv R g x = g • x := by
  simp [toAffineEquiv, smul_def]

instance [TopologicalSpace R] [IsTopologicalRing R] :
    ContinuousConstSMul (AffineSignedPerm ι) (ι → R) where
  continuous_const_smul g := by
    refine continuous_pi fun i ↦ ?_
    simp only [smul_apply, SignedPerm.smul_apply, Units.smul_def, zsmul_eq_mul]
    fun_prop

end Action

/-- The action on `ι → R` is faithful (`R` of characteristic zero). -/
theorem ext_smul [Ring R] [CharZero R] {g g' : AffineSignedPerm ι}
    (h : ∀ x : ι → R, g • x = g' • x) : g = g' := by
  have hk : translationPart g = translationPart g' := funext fun i ↦ by
    have := congrFun (h 0) i
    simp only [smul_zero_eq] at this
    exact_mod_cast this
  refine SemidirectProduct.ext hk (SignedPerm.smul_injective fun y ↦ funext fun i ↦ ?_)
  have := congrFun (h fun i ↦ (y i : R)) i
  rw [smul_intCast, smul_intCast] at this
  have h' : (g • y) i = (g' • y) i := Int.cast_injective (α := R) this
  rw [smul_apply, smul_apply, hk] at h'
  simpa using h'

/-- A subgroup containing the signed permutations and one coordinate translation is
everything. -/
theorem eq_top_of_inr_mem_of_inl_single_mem [Finite ι] [DecidableEq ι]
    {H : Subgroup (AffineSignedPerm ι)} (hr : ∀ r, inr r ∈ H) {i₀ : ι}
    (hk : inl (Multiplicative.ofAdd (Pi.single i₀ 1)) ∈ H) : H = ⊤ := by
  have hsingle : ∀ i, inl (Multiplicative.ofAdd (Pi.single i 1)) ∈ H := fun i ↦ by
    have h := inl_aut (φ := SignedPerm.toMulAutMultiplicative) (inr (Equiv.swap i₀ i))
      (Multiplicative.ofAdd (Pi.single i₀ 1))
    rw [SignedPerm.toMulAutMultiplicative_apply, toAdd_ofAdd, SignedPerm.smul_single] at h
    simp only [right_inr, left_inr, Pi.one_apply, one_smul, swap_apply_left] at h
    rw [h]
    exact H.mul_mem (H.mul_mem (hr _) hk) (hr _)
  have hinl : ∀ k : ι → ℤ, inl (Multiplicative.ofAdd k) ∈ H := fun k ↦ by
    have := Fintype.ofFinite ι
    change Multiplicative.ofAdd k ∈ H.comap inl
    rw [← Finset.univ_sum_single k, ofAdd_sum]
    refine Subgroup.prod_mem _ fun i _ ↦ ?_
    change inl _ ∈ H
    convert H.zpow_mem (hsingle i) (k i) using 1
    rw [← map_zpow, ← ofAdd_zsmul]
    congr 2
    ext j
    rcases eq_or_ne j i with rfl | hj <;> simp [*]
  refine eq_top_iff.2 fun g _ ↦ ?_
  rw [← inl_left_mul_inr_right g]
  exact H.mul_mem (hinl _) (hr _)

/-! ### Mirrors and their reflections -/

section Mirror

variable [Fintype ι]

/-- The **mirror** `{x | (2 / (n ⬝ᵥ n)) (n ⬝ᵥ x) = m}` with normal `n ∈ ℤ^ι` at height `m ∈ ℤ`.
For `n ⬝ᵥ n ∣ 2` these are the coordinate planes `{2 x_i = ± m}` (`n = ± e i`) and the diagonal
planes `{± x_i ± x_j = m}` (`n = ± e i ± e j`). -/
def mirror (n : ι → ℤ) (m : ℤ) : Set (ι → ℝ) :=
  {x | ((2 / (n ⬝ᵥ n) : ℤ) : ℝ) * ((fun i ↦ (n i : ℝ)) ⬝ᵥ x) = m}

variable (ι) in
/-- The mirrors of the cubic lattice: `mirror n m` for `n ⬝ᵥ n ∣ 2`, `m ∈ ℤ`. -/
def mirrors : Set (Set (ι → ℝ)) :=
  {H | ∃ n : ι → ℤ, n ⬝ᵥ n ∣ 2 ∧ ∃ m : ℤ, H = mirror n m}

variable {n : ι → ℤ}

theorem mem_mirror {m : ℤ} {x : ι → ℝ} :
    x ∈ mirror n m ↔ ((2 / (n ⬝ᵥ n) : ℤ) : ℝ) * ((fun i ↦ (n i : ℝ)) ⬝ᵥ x) = m :=
  Iff.rfl

theorem mirror_mem_mirrors (hn : n ⬝ᵥ n ∣ 2) (m : ℤ) : mirror n m ∈ mirrors ι :=
  ⟨n, hn, m, rfl⟩

theorem intCast_dotProduct_intCast (n k : ι → ℤ) :
    (fun i ↦ (n i : ℝ)) ⬝ᵥ (fun i ↦ (k i : ℝ)) = ((n ⬝ᵥ k : ℤ) : ℝ) := by
  simp [dotProduct]

theorem intCast_two_div_mul_dotProduct_self (hn : n ⬝ᵥ n ∣ 2) :
    ((2 / (n ⬝ᵥ n) : ℤ) : ℝ) * ((fun i ↦ (n i : ℝ)) ⬝ᵥ fun i ↦ (n i : ℝ)) = 2 := by
  rw [intCast_dotProduct_intCast, ← Int.cast_mul, Int.ediv_mul_cancel hn]
  norm_num

/-- **The group permutes the mirrors**: `g` maps `mirror n m` onto the mirror with normal
`g.right • n` at height `m + (2 / (n ⬝ᵥ n)) ((g.right • n) ⬝ᵥ translationPart g)`. -/
theorem smul_mem_mirror_iff (g : AffineSignedPerm ι) (m : ℤ) (x : ι → ℝ) :
    g • x ∈ mirror (g.right • n) (m + 2 / (n ⬝ᵥ n) * ((g.right • n) ⬝ᵥ translationPart g)) ↔
      x ∈ mirror n m := by
  have hcast : (fun i ↦ ((g.right • n) i : ℝ)) = g.right • fun i ↦ (n i : ℝ) := by
    simpa using SignedPerm.comp_smul (Int.castAddHom ℝ) g.right n
  rw [mem_mirror, mem_mirror, SignedPerm.dotProduct_smul_smul, hcast, smul_def, dotProduct_add,
    SignedPerm.dotProduct_smul_smul, ← hcast, intCast_dotProduct_intCast]
  push_cast
  constructor <;> intro h <;> linarith

theorem smul_mirror (g : AffineSignedPerm ι) (m : ℤ) :
    g • mirror n m =
      mirror (g.right • n) (m + 2 / (n ⬝ᵥ n) * ((g.right • n) ⬝ᵥ translationPart g)) :=
  Set.ext fun y ↦ by
    rw [Set.mem_smul_set_iff_inv_smul_mem, ← smul_mem_mirror_iff g, smul_inv_smul]

theorem smul_mem_mirrors (g : AffineSignedPerm ι) {H : Set (ι → ℝ)} (hH : H ∈ mirrors ι) :
    g • H ∈ mirrors ι := by
  obtain ⟨n, hn, m, rfl⟩ := hH
  rw [smul_mirror]
  exact mirror_mem_mirrors (by rwa [SignedPerm.dotProduct_smul_smul]) _

/-- A point lies on a mirror iff its image does. -/
theorem smul_mem_sUnion_mirrors_iff (g : AffineSignedPerm ι) (x : ι → ℝ) :
    g • x ∈ ⋃₀ mirrors ι ↔ x ∈ ⋃₀ mirrors ι := by
  have key : ∀ (g : AffineSignedPerm ι) x, x ∈ ⋃₀ mirrors ι → g • x ∈ ⋃₀ mirrors ι := by
    rintro g x ⟨H, hH, hx⟩
    exact ⟨g • H, smul_mem_mirrors g hH, Set.smul_mem_smul_set hx⟩
  exact ⟨fun h ↦ by simpa using key g⁻¹ _ h, key g x⟩

/-! ### The reflection in a mirror -/

variable [DecidableEq ι]

/-- The **reflection in `mirror n m`**: the affine signed permutation `x ↦ m n + r_n x`, i.e.
`x ↦ x - ((2 / (n ⬝ᵥ n)) (n ⬝ᵥ x) - m) n` (`mirrorReflection_smul`). -/
noncomputable def mirrorReflection (n : ι → ℤ) (hn : n ⬝ᵥ n ∣ 2) (m : ℤ) : AffineSignedPerm ι :=
  ⟨Multiplicative.ofAdd (m • n), SignedPerm.reflection n hn⟩

theorem mirrorReflection_smul {R : Type*} [CommRing R] (hn : n ⬝ᵥ n ∣ 2) (m : ℤ)
    (x : ι → R) : mirrorReflection n hn m • x =
      x - (((2 / (n ⬝ᵥ n) : ℤ) : R) * ((fun i ↦ (n i : R)) ⬝ᵥ x) - m) • fun i ↦ (n i : R) := by
  rw [smul_def]
  change _ + SignedPerm.reflection n hn • x = _
  rw [SignedPerm.reflection_smul]
  ext i
  simp [mirrorReflection, translationPart]
  ring

/-- The reflection fixes its mirror pointwise. -/
theorem mirrorReflection_smul_of_mem (hn : n ⬝ᵥ n ∣ 2) {m : ℤ} {x : ι → ℝ}
    (hx : x ∈ mirror n m) : mirrorReflection n hn m • x = x := by
  rw [mirrorReflection_smul, mem_mirror.1 hx, sub_self, zero_smul, sub_zero]

/-- The reflection is an involution. -/
theorem mirrorReflection_mul_self (hn : n ⬝ᵥ n ∣ 2) (m : ℤ) :
    mirrorReflection n hn m * mirrorReflection n hn m = 1 := by
  refine ext_smul (R := ℝ) fun x ↦ ?_
  have hc := intCast_two_div_mul_dotProduct_self hn
  set c : ℝ := ((2 / (n ⬝ᵥ n) : ℤ) : ℝ)
  set v : ι → ℝ := fun i ↦ (n i : ℝ)
  rw [mul_smul, mirrorReflection_smul, mirrorReflection_smul, one_smul, dotProduct_sub,
    dotProduct_smul, smul_eq_mul]
  have : c * (v ⬝ᵥ x - (c * (v ⬝ᵥ x) - m) * (v ⬝ᵥ v)) - m = -(c * (v ⬝ᵥ x) - m) := by
    linear_combination (-(c * (v ⬝ᵥ x)) + m) * hc
  rw [this, neg_smul, sub_neg_eq_add, sub_add_cancel]

/-! ### The mirrors in coordinates -/

/-- The integral vectors of norm `1` are `± e i`. -/
theorem exists_eq_single_of_dotProduct_self_eq_one (h : n ⬝ᵥ n = 1) :
    ∃ i, ∃ u : ℤˣ, n = Pi.single i (u : ℤ) := by
  obtain ⟨i, hi⟩ : ∃ i, n i ≠ 0 := by
    by_contra! h0
    simp [dotProduct, h0] at h
  obtain ⟨h1, h0⟩ := SignedPerm.mul_self_eq_one_and_eq_zero_of_dotProduct_self_eq_one h hi
  refine ⟨i, (IsUnit.of_mul_eq_one _ h1).unit, funext fun j ↦ ?_⟩
  rcases eq_or_ne j i with rfl | hj
  · simp
  · rw [h0 j hj, Pi.single_eq_of_ne hj]

/-- The integral vectors of norm `2` are `± e i ± e j`, `i ≠ j`. -/
theorem exists_eq_single_add_single_of_dotProduct_self_eq_two (h : n ⬝ᵥ n = 2) :
    ∃ i j, i ≠ j ∧ ∃ u v : ℤˣ, n = Pi.single i (u : ℤ) + Pi.single j (v : ℤ) := by
  obtain ⟨i, hi⟩ : ∃ i, n i ≠ 0 := by
    by_contra! h0
    simp [dotProduct, h0] at h
  have hsplit : (n - Pi.single i (n i)) ⬝ᵥ (n - Pi.single i (n i)) = n ⬝ᵥ n - n i * n i := by
    simp only [sub_dotProduct, dotProduct_sub, single_dotProduct, dotProduct_single,
      Pi.sub_apply, Pi.single_eq_same]
    ring
  have hnn : 0 ≤ (n - Pi.single i (n i)) ⬝ᵥ (n - Pi.single i (n i)) :=
    sum_nonneg fun k _ ↦ mul_self_nonneg _
  have hi1 : n i = 1 ∨ n i = -1 := by
    have h1 : -1 ≤ n i := by nlinarith
    have h2 : n i ≤ 1 := by nlinarith
    omega
  have hn1 : n i * n i = 1 := by rcases hi1 with h | h <;> rw [h] <;> norm_num
  obtain ⟨j, v, hv⟩ :=
    exists_eq_single_of_dotProduct_self_eq_one (n := n - Pi.single i (n i)) (by linarith)
  have hji : j ≠ i := by
    rintro rfl
    have := congrFun hv j
    simp only [Pi.sub_apply, Pi.single_eq_same, sub_self] at this
    exact v.ne_zero this.symm
  refine ⟨i, j, hji.symm, (IsUnit.of_mul_eq_one _ hn1).unit, v, ?_⟩
  rw [IsUnit.unit_spec, ← hv]
  abel

omit [DecidableEq ι] in
theorem intCast_dotProduct_eq_sum (n : ι → ℤ) (x : ι → ℝ) :
    (fun i ↦ (n i : ℝ)) ⬝ᵥ x = ∑ i, (n i : ℝ) * x i :=
  rfl

theorem dotProduct_single_self (i : ι) (u : ℤˣ) :
    Pi.single i (u : ℤ) ⬝ᵥ Pi.single i (u : ℤ) = 1 := by
  rw [single_dotProduct, Pi.single_eq_same, ← Units.val_mul, Int.units_mul_self, Units.val_one]

theorem dotProduct_single_one_self (i : ι) : Pi.single i (1 : ℤ) ⬝ᵥ Pi.single i 1 = 1 := by
  simp

theorem dotProduct_single_add_single_self {i j : ι} (hij : i ≠ j) (u v : ℤˣ) :
    (Pi.single i (u : ℤ) + Pi.single j (v : ℤ) : ι → ℤ) ⬝ᵥ
      (Pi.single i (u : ℤ) + Pi.single j (v : ℤ)) = 2 := by
  simp only [add_dotProduct, dotProduct_add, single_dotProduct, Pi.single_eq_same,
    Pi.single_eq_of_ne hij, Pi.single_eq_of_ne hij.symm, mul_zero, add_zero, zero_add,
    ← Units.val_mul, Int.units_mul_self, Units.val_one]
  rfl

theorem dotProduct_single_one_add_single_self {i j : ι} (hij : i ≠ j) (u : ℤˣ) :
    (Pi.single i (1 : ℤ) + Pi.single j (u : ℤ) : ι → ℤ) ⬝ᵥ
      (Pi.single i (1 : ℤ) + Pi.single j (u : ℤ)) = 2 := by
  simpa using dotProduct_single_add_single_self hij 1 u

theorem intCast_single_dotProduct (i : ι) (u : ℤ) (x : ι → ℝ) :
    (fun k ↦ ((Pi.single i u : ι → ℤ) k : ℝ)) ⬝ᵥ x = u * x i := by
  rw [intCast_dotProduct_eq_sum, sum_eq_single i (fun k _ hk ↦ by simp [hk]) (by simp)]
  simp

theorem intCast_single_add_single_dotProduct (i j : ι) (u v : ℤ) (x : ι → ℝ) :
    (fun k ↦ ((Pi.single i u + Pi.single j v : ι → ℤ) k : ℝ)) ⬝ᵥ x = u * x i + v * x j := by
  have h : (fun k ↦ ((Pi.single i u + Pi.single j v : ι → ℤ) k : ℝ)) =
      (fun k ↦ ((Pi.single i u : ι → ℤ) k : ℝ)) + fun k ↦ ((Pi.single j v : ι → ℤ) k : ℝ) := by
    ext k
    simp
  rw [h, add_dotProduct, intCast_single_dotProduct, intCast_single_dotProduct]

/-- The coordinate mirror `{x | 2 x_i = m}`. -/
theorem mem_mirror_single {i : ι} {m : ℤ} {x : ι → ℝ} :
    x ∈ mirror (Pi.single i 1) m ↔ 2 * x i = m := by
  rw [mem_mirror, dotProduct_single_one_self, intCast_single_dotProduct]
  norm_num

/-- The diagonal mirror `{x | x_i + u x_j = m}`, `u = ± 1`. -/
theorem mem_mirror_single_add_single {i j : ι} (hij : i ≠ j) (u : ℤˣ) {m : ℤ} {x : ι → ℝ} :
    x ∈ mirror (Pi.single i 1 + Pi.single j (u : ℤ)) m ↔ x i + u * x j = m := by
  rw [mem_mirror, dotProduct_single_one_add_single_self hij, intCast_single_add_single_dotProduct]
  norm_num

omit [DecidableEq ι] in
theorem dotProduct_self_eq_one_or_two (hn : n ⬝ᵥ n ∣ 2) : n ⬝ᵥ n = 1 ∨ n ⬝ᵥ n = 2 := by
  have h0 : 0 ≤ n ⬝ᵥ n := sum_nonneg fun k _ ↦ mul_self_nonneg _
  have hle := Int.le_of_dvd two_pos hn
  have hne : n ⬝ᵥ n ≠ 0 := by rintro h; rw [h] at hn; norm_num at hn
  omega

omit [DecidableEq ι] in
/-- **The mirrors in coordinates**: a point lies on a mirror iff `2 x_i ∈ ℤ` for some `i`, or
`x_i + x_j ∈ ℤ` or `x_i - x_j ∈ ℤ` for some `i ≠ j`. -/
theorem mem_sUnion_mirrors_iff {x : ι → ℝ} : x ∈ ⋃₀ mirrors ι ↔
    (∃ i, ∃ m : ℤ, 2 * x i = m) ∨ ∃ i j, i ≠ j ∧ ∃ m : ℤ, x i + x j = m ∨ x i - x j = m := by
  classical
  constructor
  · rintro ⟨_, ⟨n, hn, m, rfl⟩, hx⟩
    rcases dotProduct_self_eq_one_or_two hn with h | h
    · obtain ⟨i, u, rfl⟩ := exists_eq_single_of_dotProduct_self_eq_one h
      rw [mem_mirror, h, intCast_single_dotProduct] at hx
      refine .inl ⟨i, (u : ℤ) * m, ?_⟩
      rcases Int.units_eq_one_or u with rfl | rfl <;> push_cast at hx ⊢ <;> norm_num at hx <;>
        linarith
    · obtain ⟨i, j, hij, u, v, rfl⟩ := exists_eq_single_add_single_of_dotProduct_self_eq_two h
      rw [mem_mirror, h, intCast_single_add_single_dotProduct] at hx
      norm_num at hx
      refine .inr ⟨i, j, hij, ?_⟩
      rcases Int.units_eq_one_or u with rfl | rfl <;> rcases Int.units_eq_one_or v with rfl | rfl
      · exact ⟨m, .inl (by push_cast at hx; linarith)⟩
      · exact ⟨m, .inr (by push_cast at hx; linarith)⟩
      · exact ⟨-m, .inr (by push_cast at hx ⊢; linarith)⟩
      · exact ⟨-m, .inl (by push_cast at hx ⊢; linarith)⟩
  · rintro (⟨i, m, h⟩ | ⟨i, j, hij, m, h | h⟩)
    · exact ⟨_, mirror_mem_mirrors (by rw [dotProduct_single_one_self]; exact one_dvd _) m,
        mem_mirror_single.2 h⟩
    · have hx := (mem_mirror_single_add_single (x := x) (m := m) hij 1).2
        (by rw [Units.val_one, Int.cast_one, one_mul]; exact h)
      exact ⟨_, mirror_mem_mirrors (by rw [dotProduct_single_one_add_single_self hij]) m, hx⟩
    · have hx := (mem_mirror_single_add_single (x := x) (m := m) hij (-1)).2
        (by rw [Units.val_neg, Units.val_one, Int.cast_neg, Int.cast_one, neg_one_mul,
          ← sub_eq_add_neg]; exact h)
      exact ⟨_, mirror_mem_mirrors (by rw [dotProduct_single_one_add_single_self hij]) m, hx⟩

/-! ### Conjugation and generation -/

omit [Fintype ι] [DecidableEq ι] in
theorem intCast_smul (r : SignedPerm ι) (n : ι → ℤ) :
    (fun i ↦ ((r • n) i : ℝ)) = r • fun i ↦ (n i : ℝ) := by
  simpa using SignedPerm.comp_smul (Int.castAddHom ℝ) r n

omit [DecidableEq ι] in
theorem intCast_smul_dotProduct_smul (g : AffineSignedPerm ι) (n : ι → ℤ) (y : ι → ℝ) :
    (fun i ↦ ((g.right • n) i : ℝ)) ⬝ᵥ (g • y) =
      (((g.right • n) ⬝ᵥ translationPart g : ℤ) : ℝ) + (fun i ↦ (n i : ℝ)) ⬝ᵥ y := by
  rw [smul_def, dotProduct_add, intCast_dotProduct_intCast, intCast_smul,
    SignedPerm.dotProduct_smul_smul]

omit [Fintype ι] [DecidableEq ι] in
/-- Differences transform by the linear part. -/
theorem smul_sub_smul_eq (g : AffineSignedPerm ι) (x y : ι → ℝ) :
    g • x - g • y = g.right • (x - y) := by
  rw [smul_def, smul_def, smul_sub]
  abel

omit [Fintype ι] [DecidableEq ι] in
theorem smul_sub_smul (g : AffineSignedPerm ι) (y v : ι → ℝ) (a : ℝ) :
    g • (y - a • v) = g • y - a • (g.right • v) := by
  rw [smul_def, smul_def, smul_sub, smul_comm g.right a v]
  abel

/-- **Conjugating a mirror reflection** by `g` gives the reflection in the image mirror
(`smul_mirror`). -/
theorem mul_mirrorReflection_mul_inv (g : AffineSignedPerm ι) (hn : n ⬝ᵥ n ∣ 2) (m : ℤ) :
    g * mirrorReflection n hn m * g⁻¹ =
      mirrorReflection (g.right • n) (by rwa [SignedPerm.dotProduct_smul_smul])
        (m + 2 / (n ⬝ᵥ n) * ((g.right • n) ⬝ᵥ translationPart g)) := by
  refine ext_smul (R := ℝ) fun x ↦ ?_
  obtain ⟨y, rfl⟩ : ∃ y, g • y = x := ⟨g⁻¹ • x, smul_inv_smul g x⟩
  rw [mul_smul, mul_smul, inv_smul_smul, mirrorReflection_smul, mirrorReflection_smul,
    SignedPerm.dotProduct_smul_smul, smul_sub_smul, intCast_smul_dotProduct_smul, ← intCast_smul]
  push_cast
  congr 2
  ring

/-- The reflection in a mirror with normal `n` at height `0` is the linear reflection. -/
theorem mirrorReflection_zero (hn : n ⬝ᵥ n ∣ 2) :
    mirrorReflection n hn 0 = inr (SignedPerm.reflection n hn) :=
  SemidirectProduct.ext (by simp [mirrorReflection]) rfl

/-- Two parallel coordinate mirrors compose to a translation: `θ_{x_i = 1/2} θ_{x_i = 0} = τ_{e_i}`.
-/
theorem mirrorReflection_single_one_mul_zero (i : ι)
    (h : Pi.single i (1 : ℤ) ⬝ᵥ Pi.single i 1 ∣ 2) :
    mirrorReflection (Pi.single i 1) h 1 * mirrorReflection (Pi.single i 1) h 0 =
      inl (Multiplicative.ofAdd (Pi.single i 1)) := by
  have hr := congrArg SemidirectProduct.right (mirrorReflection_mul_self h 0)
  rw [mul_right] at hr
  refine SemidirectProduct.ext ?_ ?_
  · simp [mirrorReflection, mul_left]
  · rw [mul_right, right_inl]
    exact hr

/-- **The group is generated by the mirror reflections.** -/
theorem closure_mirrorReflection :
    Subgroup.closure {g : AffineSignedPerm ι | ∃ n hn m, mirrorReflection n hn m = g} = ⊤ := by
  set H := Subgroup.closure {g : AffineSignedPerm ι | ∃ n hn m, mirrorReflection n hn m = g}
  have hmem : ∀ n hn m, mirrorReflection n hn m ∈ H := fun n hn m ↦
    Subgroup.subset_closure ⟨n, hn, m, rfl⟩
  rcases isEmpty_or_nonempty ι with hι | ⟨⟨i₀⟩⟩
  · refine eq_top_iff.2 fun g _ ↦ ?_
    have : g = 1 := SemidirectProduct.ext (Multiplicative.toAdd.injective (funext isEmptyElim))
      (SemidirectProduct.ext (funext isEmptyElim) (Equiv.ext isEmptyElim))
    exact this ▸ H.one_mem
  have h1 : Pi.single i₀ (1 : ℤ) ⬝ᵥ Pi.single i₀ 1 ∣ 2 := by
    rw [dotProduct_single_one_self]; exact one_dvd _
  refine eq_top_of_inr_mem_of_inl_single_mem (i₀ := i₀) (fun r ↦ ?_) ?_
  · have hle : Subgroup.closure (insert (inl (Pi.mulSingle i₀ (-1)))
        (inr '' {σ : Perm ι | σ.IsSwap}) : Set (SignedPerm ι)) ≤ H.comap inr := by
      rw [Subgroup.closure_le]
      rintro _ (rfl | ⟨σ, ⟨i, j, hij, rfl⟩, rfl⟩)
      · rw [SetLike.mem_coe, Subgroup.mem_comap, ← SignedPerm.reflection_single i₀ h1,
          ← mirrorReflection_zero]
        exact hmem _ _ _
      · have h2 : (Pi.single i 1 + Pi.single j (-1) : ι → ℤ) ⬝ᵥ
            (Pi.single i 1 + Pi.single j (-1)) ∣ 2 := by
          have := dotProduct_single_one_add_single_self hij (-1)
          simp only [Units.val_neg, Units.val_one] at this
          rw [this]
        rw [SetLike.mem_coe, Subgroup.mem_comap,
          ← SignedPerm.reflection_single_add_single_neg_one hij h2, ← mirrorReflection_zero]
        exact hmem _ _ _
    rw [SignedPerm.closure_insert_inl_mulSingle_image_inr Perm.closure_isSwap i₀] at hle
    exact hle (Subgroup.mem_top r)
  · rw [← mirrorReflection_single_one_mul_zero i₀ h1]
    exact H.mul_mem (hmem _ _ _) (hmem _ _ _)

/-! ### Bonds across a mirror; a mirror determines its normal and its reflection -/

/-- **A point and its mirror image differ by a multiple of the normal** (the reflection crosses the
mirror orthogonally). -/
theorem mirrorReflection_smul_sub (hn : n ⬝ᵥ n ∣ 2) (m : ℤ) (x : ι → ℝ) :
    mirrorReflection n hn m • x - x =
      -(((2 / (n ⬝ᵥ n) : ℤ) : ℝ) * ((fun i ↦ (n i : ℝ)) ⬝ᵥ x) - m) • fun i ↦ (n i : ℝ) := by
  rw [mirrorReflection_smul, sub_sub_cancel_left, neg_smul]

/-- **The midpoint of a point and its mirror image lies on the mirror.** -/
theorem midpoint_mem_mirror (hn : n ⬝ᵥ n ∣ 2) (m : ℤ) (x : ι → ℝ) :
    midpoint ℝ x (mirrorReflection n hn m • x) ∈ mirror n m := by
  have hc := intCast_two_div_mul_dotProduct_self hn
  rw [mirrorReflection_smul, midpoint_eq_smul_add, mem_mirror]
  set c : ℝ := ((2 / (n ⬝ᵥ n) : ℤ) : ℝ)
  set v : ι → ℝ := fun i ↦ (n i : ℝ)
  simp only [dotProduct_smul, dotProduct_add, dotProduct_sub, smul_eq_mul, invOf_eq_inv]
  linear_combination (-(1 / 2) * (c * (v ⬝ᵥ x) - m)) * hc

omit [DecidableEq ι] in
/-- **A mirror determines its normal and height up to a common sign.** -/
theorem eq_or_eq_neg_of_mirror_eq {n' : ι → ℤ} (hn : n ⬝ᵥ n ∣ 2) (hn' : n' ⬝ᵥ n' ∣ 2)
    {m m' : ℤ} (h : mirror n m = mirror n' m') : (n' = n ∧ m' = m) ∨ (n' = -n ∧ m' = -m) := by
  have hc := intCast_two_div_mul_dotProduct_self hn
  have hc' := intCast_two_div_mul_dotProduct_self hn'
  set c : ℝ := ((2 / (n ⬝ᵥ n) : ℤ) : ℝ)
  set c' : ℝ := ((2 / (n' ⬝ᵥ n') : ℤ) : ℝ)
  set v : ι → ℝ := fun i ↦ (n i : ℝ)
  have hc'0 : c' ≠ 0 := fun h0 ↦ by rw [h0, zero_mul] at hc'; norm_num at hc'
  set p : ι → ℝ := ((m : ℝ) / 2) • v
  have hp : p ∈ mirror n m := by
    rw [mem_mirror, dotProduct_smul, smul_eq_mul]
    linear_combination ((m : ℝ) / 2) * hc
  have hp' : p ∈ mirror n' m' := h ▸ hp
  have key : ∀ w : ι → ℤ, n ⬝ᵥ w = 0 → n' ⬝ᵥ w = 0 := fun w hw ↦ by
    have hpw : p + (fun i ↦ (w i : ℝ)) ∈ mirror n m := by
      rw [mem_mirror, dotProduct_add, intCast_dotProduct_intCast, hw, Int.cast_zero, add_zero]
      exact hp
    rw [h, mem_mirror, dotProduct_add, mul_add, mem_mirror.1 hp', intCast_dotProduct_intCast,
      add_eq_left] at hpw
    exact_mod_cast (mul_eq_zero.1 hpw).resolve_left hc'0
  have hcomm : n' ⬝ᵥ n = n ⬝ᵥ n' := dotProduct_comm _ _
  have h1 := key ((n ⬝ᵥ n) • n' - (n ⬝ᵥ n') • n) (by
    rw [dotProduct_sub, dotProduct_smul, dotProduct_smul, smul_eq_mul, smul_eq_mul]
    ring)
  rw [dotProduct_sub, dotProduct_smul, dotProduct_smul, smul_eq_mul, smul_eq_mul, hcomm] at h1
  have hww : ((n ⬝ᵥ n) • n' - (n ⬝ᵥ n') • n) ⬝ᵥ ((n ⬝ᵥ n) • n' - (n ⬝ᵥ n') • n) = 0 := by
    simp only [dotProduct_sub, sub_dotProduct, dotProduct_smul, smul_dotProduct, smul_eq_mul,
      hcomm]
    linear_combination (n ⬝ᵥ n) * h1
  have hw0 := dotProduct_self_eq_zero.1 hww
  rw [sub_eq_zero] at hw0
  have hn0 : n ⬝ᵥ n ≠ 0 := fun h0 ↦ by rw [h0] at hn; norm_num at hn
  have hdd : (n ⬝ᵥ n') * (n ⬝ᵥ n') = (n ⬝ᵥ n) * (n' ⬝ᵥ n') := by linarith
  have hsign : n ⬝ᵥ n' = n ⬝ᵥ n ∨ n ⬝ᵥ n' = -(n ⬝ᵥ n) := by
    rcases dotProduct_self_eq_one_or_two hn with ha | ha <;>
      rcases dotProduct_self_eq_one_or_two hn' with hb | hb <;> rw [ha, hb] at hdd <;> rw [ha]
    · have : n ⬝ᵥ n' ≤ 1 := by nlinarith
      have : -1 ≤ n ⬝ᵥ n' := by nlinarith
      interval_cases (n ⬝ᵥ n') <;> simp_all
    · have : n ⬝ᵥ n' ≤ 1 := by nlinarith
      have : -1 ≤ n ⬝ᵥ n' := by nlinarith
      interval_cases (n ⬝ᵥ n') <;> simp_all
    · have : n ⬝ᵥ n' ≤ 1 := by nlinarith
      have : -1 ≤ n ⬝ᵥ n' := by nlinarith
      interval_cases (n ⬝ᵥ n') <;> simp_all
    · have : n ⬝ᵥ n' ≤ 2 := by nlinarith
      have : -2 ≤ n ⬝ᵥ n' := by nlinarith
      interval_cases (n ⬝ᵥ n') <;> simp_all
  have hpm : ∀ {n'' : ι → ℤ} {m'' : ℤ}, n'' ⬝ᵥ n'' = n ⬝ᵥ n → p ∈ mirror n'' m'' →
      ((m'' : ℤ) : ℝ) = c * ((fun i ↦ (n'' i : ℝ)) ⬝ᵥ p) := fun hnn hp'' ↦ by
    rw [mem_mirror, hnn] at hp''
    exact hp''.symm
  rcases hsign with hd | hd
  · have hnn : n' = n := smul_right_injective _ hn0
      (show (n ⬝ᵥ n) • n' = (n ⬝ᵥ n) • n by rw [hw0, hd])
    subst hnn
    refine .inl ⟨rfl, ?_⟩
    exact_mod_cast (hpm rfl hp').trans (mem_mirror.1 hp)
  · have hnn : n' = -n := smul_right_injective _ hn0
      (show (n ⬝ᵥ n) • n' = (n ⬝ᵥ n) • -n by rw [hw0, hd, neg_smul, smul_neg])
    subst hnn
    refine .inr ⟨rfl, ?_⟩
    have h2 := hpm (by rw [neg_dotProduct, dotProduct_neg, neg_neg]) hp'
    have h3 := mem_mirror.1 hp
    have h4 : (fun i ↦ ((-n) i : ℝ)) ⬝ᵥ p = -(v ⬝ᵥ p) := by
      simp [v, dotProduct]
    rw [h4] at h2
    have : (m' : ℝ) = -m := by rw [h2, ← h3]; ring
    exact_mod_cast this

theorem mirrorReflection_neg (hn : n ⬝ᵥ n ∣ 2) (hn' : (-n) ⬝ᵥ (-n) ∣ 2) (m : ℤ) :
    mirrorReflection (-n) hn' (-m) = mirrorReflection n hn m := by
  refine ext_smul (R := ℝ) fun x ↦ ?_
  rw [mirrorReflection_smul, mirrorReflection_smul, neg_dotProduct, dotProduct_neg, neg_neg]
  have h : (fun i ↦ ((-n) i : ℝ)) = -fun i ↦ (n i : ℝ) := by ext; simp
  rw [h, neg_dotProduct, smul_neg]
  push_cast
  module

/-- **The reflection in a mirror depends only on the mirror.** -/
theorem mirrorReflection_eq_of_mirror_eq {n' : ι → ℤ} (hn : n ⬝ᵥ n ∣ 2) (hn' : n' ⬝ᵥ n' ∣ 2)
    {m m' : ℤ} (h : mirror n m = mirror n' m') :
    mirrorReflection n hn m = mirrorReflection n' hn' m' := by
  rcases eq_or_eq_neg_of_mirror_eq hn hn' h with ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩
  · rfl
  · exact (mirrorReflection_neg hn hn' m).symm

end Mirror

