/-!
# Cohomology of cubical cochains

The closed `k`-cochains `cocycles R e k = ker (d : C^k → C^{k+1})` contain the exact ones
`coboundaries R e k` (`0` in degree `0`, `range (d : C^{k-1} → C^k)` above) because `d ∘ d = 0`
(`coboundaries_le_cocycles`); `cohomology R e k` is the quotient `H^k`. The same differentials
form the cochain complex `cochainComplex R e` in `ModuleCat R`, exact at `k + 1` exactly when
every closed `(k + 1)`-cochain is exact (`exactAt_cochainComplex_succ_iff`).

**Degree `0`.** If the steps generate `X` as a group (`AddSubgroup.closure (Set.range e) = ⊤`,
the cubical complex is connected), a closed `0`-cochain is invariant under every translation,
hence constant (`mem_cocycles_zero_iff`), and evaluation at the vertex `0` is an isomorphism
`H⁰ ≃ R` (`cohomologyZeroEquiv`). The hypothesis holds for `ℤᵈ` and the product tori
`∏ ℤ/nᵢ` (`closure_range_single_one`) and passes to quotients, e.g. every torus `ℤᵈ ⧸ Γ`
(`closure_range_comp`).

**Contracting homotopies.** If an additive operator `S` on total cochains inverts the
difference `Δ_[e j]` up to `Q` from the right and up to `P` from the left, and commutes with the
other differences and with the linear maps of the fibre, then `h = e_j* ⌟ S` satisfies
`d h + h d = 1 - (e_j* ⌟ e_j ∧ P + e_j ∧ e_j* ⌟ Q)`
(`totalCoboundary_contract_add_contract_totalCoboundary`): the Koszul homotopy of one of the
commuting differences. Its instances compute the cohomology of `ℤᵈ` (`S` the oriented line
sum, `Q = 0`: the Poincaré lemma, `CubicalCochain.Poincare`) and of the product tori (`S` the
cyclic line sum, `Q` the line total at the seam: `CubicalCochain.Torus`).

## Searches

Mathlib `d13f23b7` has the homological algebra (`CochainComplex.of`, `HomologicalComplex.ExactAt`,
`ShortComplex.moduleCat_exact_iff_ker_sub_range`, `Homotopy`) but no cubical or lattice cochain
complex and no cohomology of a cubical complex (`rg -i "cubical|cochain"`: group, Lie algebra and
Čech cochains only; `rg -i koszul`: docstrings only).
-/

@[expose] public section

open Finset CategoryTheory

namespace CubicalCochain

open CubicalCell

section Generation

variable {X ι : Type*} [AddCommGroup X]

/-! ### Lattices generated by their steps -/

/-- The unit vectors `Pi.single i 1` generate `∀ i, A i` when each `A i` is generated by `1`,
e.g. `ℤᵈ` and the product tori `∏ ZMod (n i)`. -/
theorem closure_range_single_one [Finite ι] [DecidableEq ι] {A : ι → Type*}
    [∀ i, AddCommGroupWithOne (A i)] (hA : ∀ i, Function.Surjective (Int.cast : ℤ → A i)) :
    AddSubgroup.closure (Set.range fun i ↦ (Pi.single i 1 : ∀ i, A i)) = ⊤ := by
  have := Fintype.ofFinite ι
  refine eq_top_iff.2 fun x _ ↦ ?_
  rw [← univ_sum_single x]
  refine AddSubgroup.sum_mem _ fun i _ ↦ ?_
  obtain ⟨n, hn⟩ := hA i (x i)
  rw [← hn, ← zsmul_one, ← AddMonoidHom.single_apply, map_zsmul]
  exact AddSubgroup.zsmul_mem _ (AddSubgroup.subset_closure (Set.mem_range_self i)) n

/-- Steps generating `X` map to steps generating a quotient `Y`, e.g. `ℤᵈ → ℤᵈ ⧸ Γ`. -/
theorem closure_range_comp {e : ι → X} {Y : Type*} [AddCommGroup Y] (φ : X →+ Y)
    (hφ : Function.Surjective φ) (he : AddSubgroup.closure (Set.range e) = ⊤) :
    AddSubgroup.closure (Set.range (φ ∘ e)) = ⊤ := by
  rw [Set.range_comp, ← AddMonoidHom.map_closure, he, AddSubgroup.map_top_of_surjective φ hφ]

end Generation

section Update

variable {ι : Type*} [DecidableEq ι] {A : ι → Type*} [∀ i, AddCommGroup (A i)]

/-! ### Moving along a coordinate line -/

theorem update_add_single_self (x : ∀ i, A i) (j : ι) (t a : A j) :
    Function.update x j t + Pi.single j a = Function.update x j (t + a) := by
  ext i
  rcases eq_or_ne i j with rfl | h <;> simp [*]

theorem update_add_single_left_self (x : ∀ i, A i) (j : ι) (t a : A j) :
    Function.update (x + Pi.single j a) j t = Function.update x j t := by
  ext i
  rcases eq_or_ne i j with rfl | h <;> simp [*]

theorem update_add_single_of_ne (x : ∀ i, A i) {i j : ι} (h : i ≠ j) (a : A i) (t : A j) :
    Function.update (x + Pi.single i a) j t = Function.update x j t + Pi.single i a := by
  ext l
  rcases eq_or_ne l j with rfl | hl
  · simp [h.symm]
  · simp [hl]

end Update

variable {X ι R : Type*} [AddCommGroup X] [LinearOrder ι] [Fintype ι] [CommRing R]
  {e : ι → X} {k : ℕ}

/-- The degree-`k + 1` part of a total coboundary sees only the degree-`k` part. -/
theorem restrict_totalCoboundary (V : X → Finset ι → R) :
    restrict (k + 1) (totalCoboundary e V) = coboundary e k (restrict k V) := by
  ext c
  rw [coboundary_apply, restrict_apply, totalCoboundary_apply]
  refine sum_congr rfl fun j hj ↦ ?_
  have h : #((c.dirs : Finset ι).erase j) = k := by
    rw [card_erase_of_mem hj, Set.powersetCard.card_eq, Nat.add_sub_cancel]
  rw [extend_apply_of_card_eq _ _ h, extend_apply_of_card_eq _ _ h]
  rfl

/-- A total coboundary has no degree-`0` part. -/
theorem restrict_zero_totalCoboundary (V : X → Finset ι → R) :
    restrict 0 (totalCoboundary e V) = 0 := by
  ext c
  rw [restrict_apply, totalCoboundary_apply,
    Finset.card_eq_zero.1 (Set.powersetCard.card_eq c.dirs), sum_empty, Pi.zero_apply]

/-! ### Cocycles, coboundaries and cohomology -/

variable (R) in
/-- The closed `k`-cochains, `ker (d : C^k → C^{k+1})`. -/
def cocycles (e : ι → X) (k : ℕ) : Submodule R (CubicalCell X ι k → R) :=
  LinearMap.ker (coboundary e k)

variable (R) in
/-- The exact `k`-cochains: `0` in degree `0` and `range (d : C^k → C^{k+1})` in degree `k + 1`. -/
def coboundaries (e : ι → X) : (k : ℕ) → Submodule R (CubicalCell X ι k → R)
  | 0 => ⊥
  | k + 1 => LinearMap.range (coboundary e k)

theorem mem_cocycles_iff {u : CubicalCell X ι k → R} :
    u ∈ cocycles R e k ↔ coboundary e k u = 0 :=
  Iff.rfl

@[simp]
theorem coboundaries_zero : coboundaries R e 0 = ⊥ :=
  rfl

theorem coboundaries_succ : coboundaries R e (k + 1) = LinearMap.range (coboundary e k) :=
  rfl

theorem coboundaries_le_cocycles : coboundaries R e k ≤ cocycles R e k := by
  cases k with
  | zero => exact bot_le
  | succ k => exact LinearMap.range_le_ker_iff.2 coboundary_comp_coboundary

variable (R) in
/-- The cohomology `H^k = cocycles R e k ⧸ coboundaries R e k` of the cubical complex. -/
abbrev cohomology (e : ι → X) (k : ℕ) : Type _ :=
  cocycles R e k ⧸ (coboundaries R e k).comap (cocycles R e k).subtype

/-- `H^k = 0` exactly when every closed `k`-cochain is exact. -/
theorem subsingleton_cohomology_iff :
    Subsingleton (cohomology R e k) ↔ cocycles R e k ≤ coboundaries R e k := by
  rw [Submodule.Quotient.subsingleton_iff, Submodule.comap_subtype_eq_top]

/-- The class of a closed cochain vanishes exactly when the cochain is exact. -/
theorem cohomology_mk_eq_zero_iff (u : cocycles R e k) :
    (Submodule.Quotient.mk u : cohomology R e k) = 0 ↔ (u : CubicalCell X ι k → R) ∈
      coboundaries R e k := by
  rw [Submodule.Quotient.mk_eq_zero, Submodule.mem_comap, Submodule.subtype_apply]

variable (R) in
/-- The cubical cochain complex `C^0 → C^1 → C^2 → ⋯` in `ModuleCat R`. -/
def cochainComplex (e : ι → X) : CochainComplex (ModuleCat R) ℕ :=
  CochainComplex.of (fun k ↦ ModuleCat.of R (CubicalCell X ι k → R))
    (fun k ↦ ModuleCat.ofHom (coboundary e k))
    (fun k ↦ by ext u : 2; simp)

/-- The cochain complex is exact at `k + 1` exactly when every closed `(k + 1)`-cochain is
exact. -/
theorem exactAt_cochainComplex_succ_iff :
    (cochainComplex R e).ExactAt (k + 1) ↔ cocycles R e (k + 1) ≤ coboundaries R e (k + 1) := by
  rw [HomologicalComplex.exactAt_iff' _ k (k + 1) (k + 1 + 1) (by simp) (by simp),
    ShortComplex.moduleCat_exact_iff_ker_sub_range]
  simp only [HomologicalComplex.shortComplexFunctor'_obj_f,
    HomologicalComplex.shortComplexFunctor'_obj_g, cochainComplex, CochainComplex.of_d]
  rfl

/-! ### Degree `0` -/

/-- A closed `0`-cochain is invariant under translation by the group generated by the steps. -/
theorem coboundary_zero_eq_zero_iff {u : CubicalCell X ι 0 → R} :
    coboundary e 0 u = 0 ↔ ∀ v ∈ AddSubgroup.closure (Set.range e), ∀ x,
      u (vertexEquiv (x + v)) = u (vertexEquiv x) := by
  constructor
  · intro hu v hv
    induction hv using AddSubgroup.closure_induction with
    | mem v hv =>
      obtain ⟨μ, rfl⟩ := hv
      intro x
      have h := congrFun hu (linkEquiv (x, μ))
      rwa [coboundary_zero_apply, Pi.zero_apply, sub_eq_zero] at h
    | zero => simp
    | add a b _ _ ha hb => intro x; rw [← add_assoc, hb, ha]
    | neg a _ ha => intro x; rw [← ha (x + -a), neg_add_cancel_right]
  · intro hu
    ext c
    obtain ⟨⟨x, μ⟩, rfl⟩ := linkEquiv.surjective c
    rw [coboundary_zero_apply, hu _ (AddSubgroup.subset_closure ⟨μ, rfl⟩), sub_self,
      Pi.zero_apply]

/-- **Closed `0`-cochains are constant** on a lattice generated by its steps. -/
theorem mem_cocycles_zero_iff (he : AddSubgroup.closure (Set.range e) = ⊤)
    {u : CubicalCell X ι 0 → R} : u ∈ cocycles R e 0 ↔ ∃ r, u = fun _ ↦ r := by
  rw [mem_cocycles_iff, coboundary_zero_eq_zero_iff, he]
  constructor
  · intro hu
    refine ⟨u (vertexEquiv 0), funext fun c ↦ ?_⟩
    obtain ⟨x, rfl⟩ := vertexEquiv.surjective c
    simpa using hu x (AddSubgroup.mem_top x) 0
  · rintro ⟨r, rfl⟩ _ _ _
    rfl

/-- On a lattice generated by its steps, a closed `0`-cochain is its value at the vertex `0`. -/
def cocyclesZeroEquiv (he : AddSubgroup.closure (Set.range e) = ⊤) :
    cocycles R e 0 ≃ₗ[R] R where
  toFun u := (u : CubicalCell X ι 0 → R) (vertexEquiv 0)
  invFun r := ⟨fun _ ↦ r, (mem_cocycles_zero_iff he).2 ⟨r, rfl⟩⟩
  map_add' _ _ := rfl
  map_smul' _ _ := rfl
  left_inv u := by
    obtain ⟨r, hr⟩ := (mem_cocycles_zero_iff he).1 u.2
    ext c
    simp [hr]
  right_inv _ := rfl

/-- **`H⁰ = R`** on a lattice generated by its steps (a connected cubical complex). -/
def cohomologyZeroEquiv (he : AddSubgroup.closure (Set.range e) = ⊤) :
    cohomology R e 0 ≃ₗ[R] R :=
  (Submodule.quotEquivOfEqBot _ (by simp)).trans (cocyclesZeroEquiv he)

/-! ### The contracting homotopy of one direction -/

omit [Fintype ι] in
/-- `e_j* ⌟ (e_j ∧ f)` is the part of `f` without `e_j`. -/
theorem contract_wedge_self_apply (j : ι) (f : Finset ι → R) (I : Finset ι) :
    contract j (wedge j f) I = if j ∈ I then 0 else f I := by
  by_cases h : j ∈ I
  · simp [contract_apply, h]
  · rw [contract_apply, ite_eq_right h, ite_eq_right h, wedge_apply,
      ite_eq_left (mem_insert_self j I), erase_insert h, ← mul_assoc,
      neg_one_pow_card_filter_insert h, ite_eq_right (lt_irrefl j), ← pow_add, ← two_mul,
      pow_mul]
    simp

omit [Fintype ι] in
/-- `e_j ∧ (e_j* ⌟ f)` is the part of `f` with `e_j`. -/
theorem wedge_contract_self_apply (j : ι) (f : Finset ι → R) (I : Finset ι) :
    wedge j (contract j f) I = if j ∈ I then f I else 0 := by
  have h := congrFun (contract_wedge_add_wedge_contract j j f) I
  rw [ite_eq_left rfl, Pi.add_apply, contract_wedge_self_apply] at h
  by_cases hj : j ∈ I
  · simpa [hj] using h
  · simp only [hj, ite_false] at h ⊢
    linear_combination h

/-- **Homotopy formula of one direction.** Let `S` invert the difference `Δ_[e j]` up to `Q`
from the right and up to `P` from the left, and commute with the differences in the other
directions and with the linear maps of the fibre `Finset ι → R`. Then `h U x = e_j* ⌟ S U x`
satisfies `d h + h d = 1 - (e_j* ⌟ e_j ∧ P + e_j ∧ e_j* ⌟ Q)`: the anticommutation relations
of `contract j` and `wedge i` cancel the directions `i ≠ j`. -/
theorem totalCoboundary_contract_add_contract_totalCoboundary (j : ι)
    (S : (X → Finset ι → R) →+ X → Finset ι → R) (P Q : (X → Finset ι → R) → X → Finset ι → R)
    (hS : ∀ (L : (Finset ι → R) →ₗ[R] Finset ι → R) U, S (fun y ↦ L (U y)) = fun x ↦ L (S U x))
    (hright : ∀ U, fwdDiff (e j) (S U) = U - Q U) (hleft : ∀ U, S (fwdDiff (e j) U) = U - P U)
    (hcomm : ∀ i, i ≠ j → ∀ U, S (fwdDiff (e i) U) = fwdDiff (e i) (S U))
    (U : X → Finset ι → R) :
    totalCoboundary e (fun x ↦ contract j (S U x)) +
        (fun x ↦ contract j (S (totalCoboundary e U) x)) =
      U - fun x ↦ contract j (wedge j (P U x)) + wedge j (contract j (Q U x)) := by
  ext x : 1
  have h₁ : ∀ i, fwdDiff (e i) (fun x ↦ contract j (S U x)) x =
      contract j (fwdDiff (e i) (S U) x) := fun i ↦ (map_sub (contract j) _ _).symm
  have h₂ : S (totalCoboundary e U) x = ∑ i, wedge i (S (fwdDiff (e i) U) x) := by
    have hD : totalCoboundary e U = ∑ i, fun y ↦ wedge i (fwdDiff (e i) U y) := by
      ext y : 1
      rw [totalCoboundary_apply', Finset.sum_apply]
    rw [hD, map_sum, Finset.sum_apply]
    simp only [hS]
  simp only [Pi.add_apply, Pi.sub_apply, totalCoboundary_apply', h₁, h₂, map_sum,
    ← sum_add_distrib]
  rw [sum_eq_single j]
  · rw [hright, hleft]
    ext I
    have hI := congrFun (contract_wedge_add_wedge_contract j j (U x)) I
    rw [ite_eq_left rfl] at hI
    simp only [Pi.add_apply, Pi.sub_apply, map_sub] at hI ⊢
    linear_combination hI
  · intro i _ hij
    rw [hcomm i hij, add_comm, contract_wedge_add_wedge_contract, ite_eq_right hij.symm]
  · simp

end CubicalCochain
