module

public import GibbsMeasure.Model.BoundaryLawPhaseTransition

/-!
# The two-sided Markov property of the measure (11.10)

Sites `ℤ`, a countable state space `E`, a positive matrix `Q` with finite powers (Georgii (11.1))
and a boundary law `{ℓ_i, r_i}` for it (Definition (11.8)). The measure `μ` of (11.10) has the
cylinder probabilities `μ(σ_a = x_a, …, σ_b = x_b) = ℓ_a(x_a) Q(x_a, x_{a+1}) ⋯ Q(x_{b-1}, x_b)
r_b(x_b)`, so for two cylinders `A` over `[a, i]` and `B` over `[i, b]` that agree at the common
site `i`,

`μ(A ∩ B) μ(σ_i = x) = μ(A) μ(B)`  (`x` the common value at `i`).

Both σ-algebras `𝓕_{]-∞,i]}` and `𝓕_{[i,∞[}` are generated by such cylinders, so the identity
extends: *the past and the future are conditionally independent given the present*,

`μ(A ∩ B ∩ {σ_i = x}) μ(σ_i = x) = μ(A ∩ {σ_i = x}) μ(B ∩ {σ_i = x})`

for all `A ∈ 𝓕_{]-∞,i]}`, `B ∈ 𝓕_{[i,∞[}` (`IsBoundaryLaw.measure_inter_inter_preimage_mul`). This
is the form of "the one-sided Markov property (10.7)" that Georgii's proof of Corollary (11.33)
uses, with `U` a function of the past and `V` a function of the future.

## Main declarations

* `leftCylinders c`, `rightCylinders c`: the interval cylinders over intervals `[a, c]`, resp.
  `[c, b]`; `isPiSystem_leftCylinders`, `isPiSystem_rightCylinders`,
  `cylinderEvents_Iic_eq_generateFrom_leftCylinders`,
  `cylinderEvents_Ici_eq_generateFrom_rightCylinders`.
* `IsBoundaryLaw.boundaryLawMeasure_intervalCylinder_inter`: the product formula for two
  cylinders meeting at a site.
* `IsBoundaryLaw.measure_inter_inter_preimage_mul`: the conditional independence of past and
  future given the present.
-/

@[expose] public section

open MeasureTheory ProbabilityTheory Set
open scoped ENNReal

noncomputable section

namespace MeasureTheory.GibbsMeasure.Markov

variable {E : Type*} [MeasurableSpace E] [Countable E] [MeasurableSingletonClass E]

/-! ## The interval cylinders ending, resp. starting, at a site -/

section Cylinders

/-- The interval cylinders `{σ_a = ζ_a, …, σ_c = ζ_c}` over an interval `[a, c]` ending at `c`. -/
def leftCylinders (c : ℤ) : Set (Set (ℤ → E)) :=
  {S | ∃ (a : ℤ) (ζ : ℤ → E), a ≤ c ∧ S = intervalCylinder a c ζ}

/-- The interval cylinders `{σ_c = ζ_c, …, σ_b = ζ_b}` over an interval `[c, b]` starting at
`c`. -/
def rightCylinders (c : ℤ) : Set (Set (ℤ → E)) :=
  {S | ∃ (b : ℤ) (ζ : ℤ → E), c ≤ b ∧ S = intervalCylinder c b ζ}

omit [MeasurableSpace E] [Countable E] [MeasurableSingletonClass E] in
/-- Two interval cylinders ending at `c` are disjoint or intersect in the cylinder over the larger
interval. -/
lemma isPiSystem_leftCylinders (c : ℤ) : IsPiSystem (leftCylinders (E := E) c) := by
  rintro S₁ ⟨a₁, ζ₁, ha₁, rfl⟩ S₂ ⟨a₂, ζ₂, ha₂, rfl⟩ ⟨τ₀, hτ₁, hτ₂⟩
  refine ⟨min a₁ a₂, τ₀, by omega, ?_⟩
  simp only [mem_intervalCylinder, Finset.mem_Icc] at hτ₁ hτ₂
  ext τ
  simp only [Set.mem_inter_iff, mem_intervalCylinder, Finset.mem_Icc]
  constructor
  · rintro ⟨h1, h2⟩ k hk
    rcases le_or_gt a₁ k with hk1 | hk1
    · rw [h1 k ⟨hk1, hk.2⟩, hτ₁ k ⟨hk1, hk.2⟩]
    · rw [h2 k ⟨by omega, hk.2⟩, hτ₂ k ⟨by omega, hk.2⟩]
  · intro h
    exact ⟨fun k hk ↦ by rw [h k ⟨by omega, hk.2⟩, hτ₁ k hk],
      fun k hk ↦ by rw [h k ⟨by omega, hk.2⟩, hτ₂ k hk]⟩

omit [MeasurableSpace E] [Countable E] [MeasurableSingletonClass E] in
/-- Two interval cylinders starting at `c` are disjoint or intersect in the cylinder over the
larger interval. -/
lemma isPiSystem_rightCylinders (c : ℤ) : IsPiSystem (rightCylinders (E := E) c) := by
  rintro S₁ ⟨b₁, ζ₁, hb₁, rfl⟩ S₂ ⟨b₂, ζ₂, hb₂, rfl⟩ ⟨τ₀, hτ₁, hτ₂⟩
  refine ⟨max b₁ b₂, τ₀, by omega, ?_⟩
  simp only [mem_intervalCylinder, Finset.mem_Icc] at hτ₁ hτ₂
  ext τ
  simp only [Set.mem_inter_iff, mem_intervalCylinder, Finset.mem_Icc]
  constructor
  · rintro ⟨h1, h2⟩ k hk
    rcases le_or_gt k b₁ with hk1 | hk1
    · rw [h1 k ⟨hk.1, hk1⟩, hτ₁ k ⟨hk.1, hk1⟩]
    · rw [h2 k ⟨hk.1, by omega⟩, hτ₂ k ⟨hk.1, by omega⟩]
  · intro h
    exact ⟨fun k hk ↦ by rw [h k ⟨hk.1, by omega⟩, hτ₁ k hk],
      fun k hk ↦ by rw [h k ⟨hk.1, by omega⟩, hτ₂ k hk]⟩

variable [Nonempty E]

/-- The σ-algebra `𝓕_{]-∞,c]}` of the coordinates up to `c` is generated by the interval
cylinders ending at `c`: a coordinate event `{σ_k = e}`, `k ≤ c`, is the countable union of the
cylinders over `[k, c]` with value `e` at `k`. -/
lemma cylinderEvents_Iic_eq_generateFrom_leftCylinders (c : ℤ) :
    cylinderEvents (X := fun _ : ℤ ↦ E) (Set.Iic c)
      = MeasurableSpace.generateFrom (leftCylinders (E := E) c) := by
  refine le_antisymm ?_ (MeasurableSpace.generateFrom_le ?_)
  · have key : ∀ k ∈ Set.Iic c,
        Measurable[MeasurableSpace.generateFrom (leftCylinders (E := E) c)]
          fun τ : ℤ → E ↦ τ k := by
      intro k hk
      rw [Set.mem_Iic] at hk
      refine @measurable_to_countable' E (ℤ → E) _ _
        (MeasurableSpace.generateFrom (leftCylinders (E := E) c)) _ fun e ↦ ?_
      have hk' : k ∈ Finset.Icc k c := by simp only [Finset.mem_Icc]; omega
      have hset : (fun τ : ℤ → E ↦ τ k) ⁻¹' {e}
          = ⋃ x ∈ {x : Π _j : (Finset.Icc k c : Finset ℤ), E | x ⟨k, hk'⟩ = e},
              intervalCylinder k c (extendBy (Finset.Icc k c) x) := by
        ext τ
        simp only [Set.mem_preimage, Set.mem_singleton_iff, Set.mem_iUnion, Set.mem_ofPred_eq,
          mem_intervalCylinder, exists_prop]
        constructor
        · intro hτ
          refine ⟨(Finset.Icc k c).restrict τ, hτ, fun j hj ↦ ?_⟩
          rw [extendBy_of_mem _ hj]
          rfl
        · rintro ⟨x, hx, hτ⟩
          rw [hτ k hk', extendBy_of_mem _ hk', hx]
      rw [hset]
      refine MeasurableSet.biUnion (Set.to_countable _) fun x _ ↦ ?_
      exact MeasurableSpace.measurableSet_generateFrom ⟨k, _, hk, rfl⟩
    exact iSup₂_le fun k hk ↦ (key k hk).comap_le
  · rintro S ⟨a, ζ, hac, rfl⟩
    exact measurableSet_cylinderEvents_intervalCylinder
      (fun j hj ↦ by simp only [Set.mem_Icc] at hj; simp only [Set.mem_Iic]; omega) ζ

/-- The σ-algebra `𝓕_{[c,∞[}` of the coordinates from `c` on is generated by the interval
cylinders starting at `c`. -/
lemma cylinderEvents_Ici_eq_generateFrom_rightCylinders (c : ℤ) :
    cylinderEvents (X := fun _ : ℤ ↦ E) (Set.Ici c)
      = MeasurableSpace.generateFrom (rightCylinders (E := E) c) := by
  refine le_antisymm ?_ (MeasurableSpace.generateFrom_le ?_)
  · have key : ∀ k ∈ Set.Ici c,
        Measurable[MeasurableSpace.generateFrom (rightCylinders (E := E) c)]
          fun τ : ℤ → E ↦ τ k := by
      intro k hk
      rw [Set.mem_Ici] at hk
      refine @measurable_to_countable' E (ℤ → E) _ _
        (MeasurableSpace.generateFrom (rightCylinders (E := E) c)) _ fun e ↦ ?_
      have hk' : k ∈ Finset.Icc c k := by simp only [Finset.mem_Icc]; omega
      have hset : (fun τ : ℤ → E ↦ τ k) ⁻¹' {e}
          = ⋃ x ∈ {x : Π _j : (Finset.Icc c k : Finset ℤ), E | x ⟨k, hk'⟩ = e},
              intervalCylinder c k (extendBy (Finset.Icc c k) x) := by
        ext τ
        simp only [Set.mem_preimage, Set.mem_singleton_iff, Set.mem_iUnion, Set.mem_ofPred_eq,
          mem_intervalCylinder, exists_prop]
        constructor
        · intro hτ
          refine ⟨(Finset.Icc c k).restrict τ, hτ, fun j hj ↦ ?_⟩
          rw [extendBy_of_mem _ hj]
          rfl
        · rintro ⟨x, hx, hτ⟩
          rw [hτ k hk', extendBy_of_mem _ hk', hx]
      rw [hset]
      refine MeasurableSet.biUnion (Set.to_countable _) fun x _ ↦ ?_
      exact MeasurableSpace.measurableSet_generateFrom ⟨k, _, hk, rfl⟩
    exact iSup₂_le fun k hk ↦ (key k hk).comap_le
  · rintro S ⟨b, ζ, hcb, rfl⟩
    exact measurableSet_cylinderEvents_intervalCylinder
      (fun j hj ↦ by simp only [Set.mem_Icc] at hj; simp only [Set.mem_Ici]; omega) ζ

end Cylinders

/-! ## Conditional independence of past and future given the present -/

section MarkovProperty

omit [MeasurableSpace E] [Countable E] [MeasurableSingletonClass E] in
/-- Two interval cylinders over `[a, i]` and `[i, b]` which agree at the common endpoint `i`
intersect in the cylinder over `[a, b]` glued from the two configurations. -/
lemma intervalCylinder_inter_intervalCylinder {a i b : ℤ} (hai : a ≤ i) (hib : i ≤ b)
    {η ζ : ℤ → E} (h : η i = ζ i) :
    intervalCylinder a i η ∩ intervalCylinder i b ζ
      = intervalCylinder a b fun k ↦ if k ≤ i then η k else ζ k := by
  ext τ
  simp only [Set.mem_inter_iff, mem_intervalCylinder, Finset.mem_Icc]
  constructor
  · rintro ⟨h1, h2⟩ k hk
    split_ifs with hki
    · exact h1 k ⟨hk.1, hki⟩
    · exact h2 k ⟨by omega, hk.2⟩
  · intro hτ
    refine ⟨fun k hk ↦ ?_, fun k hk ↦ ?_⟩
    · have := hτ k ⟨hk.1, by omega⟩
      rwa [ite_eq_left hk.2] at this
    · have := hτ k ⟨by omega, hk.2⟩
      rcases eq_or_lt_of_le hk.1 with hik | hik
      · subst hik
        rwa [ite_eq_left le_rfl, h] at this
      · rwa [ite_eq_right (not_le.2 hik)] at this

variable [Nonempty E] {Q : E → E → ℝ≥0∞} {ℓ r : ℤ → E → ℝ≥0∞} (hbl : IsBoundaryLaw Q ℓ r)
include hbl

/-- **The product formula for two cylinders meeting at a site.** For the measure (11.10) and
cylinders `A = {σ_a = η_a, …, σ_i = η_i}`, `B = {σ_i = ζ_i, …, σ_b = ζ_b}` with `η_i = ζ_i`,
`μ(A ∩ B) μ(σ_i = η_i) = μ(A) μ(B)`: both sides are
`ℓ_a(η_a) Q ⋯ Q r_i(η_i) · ℓ_i(η_i) Q ⋯ Q r_b(ζ_b)`. -/
theorem IsBoundaryLaw.boundaryLawMeasure_intervalCylinder_inter {a i b : ℤ} (hai : a ≤ i)
    (hib : i ≤ b) {η ζ : ℤ → E} (h : η i = ζ i) :
    boundaryLawMeasure hbl (intervalCylinder a i η ∩ intervalCylinder i b ζ)
        * (ℓ i (η i) * r i (η i))
      = boundaryLawMeasure hbl (intervalCylinder a i η)
        * boundaryLawMeasure hbl (intervalCylinder i b ζ) := by
  rw [intervalCylinder_inter_intervalCylinder hai hib h,
    hbl.boundaryLawMeasure_intervalCylinder (hai.trans hib),
    hbl.boundaryLawMeasure_intervalCylinder hai, hbl.boundaryLawMeasure_intervalCylinder hib,
    pathProd_split Q hai hib]
  have h1 : pathProd Q a i (fun k ↦ if k ≤ i then η k else ζ k) = pathProd Q a i η :=
    pathProd_congr Q fun k hk ↦ by
      rw [Finset.mem_Icc] at hk
      exact ite_eq_left hk.2
  have h2 : pathProd Q i b (fun k ↦ if k ≤ i then η k else ζ k) = pathProd Q i b ζ :=
    pathProd_congr Q fun k hk ↦ by
      rw [Finset.mem_Icc] at hk
      rcases eq_or_lt_of_le hk.1 with hik | hik
      · subst hik
        rw [ite_eq_left le_rfl, h]
      · exact ite_eq_right (not_le.2 hik)
  have ha : (if a ≤ i then η a else ζ a) = η a := ite_eq_left hai
  have hb : (if b ≤ i then η b else ζ b) = ζ b := by
    rcases eq_or_lt_of_le hib with hib' | hib'
    · subst hib'
      rw [ite_eq_left le_rfl, h]
    · exact ite_eq_right (not_le.2 hib')
  simp only [h1, h2, ha, hb]
  rw [h]
  ring

/-- **Conditional independence of past and future given the present**, for the measure (11.10)
of a boundary law: for every `A ∈ 𝓕_{]-∞,i]}` and `B ∈ 𝓕_{[i,∞[}`,

`μ(A ∩ B ∩ {σ_i = x}) μ(σ_i = x) = μ(A ∩ {σ_i = x}) μ(B ∩ {σ_i = x})`.

The identity holds for interval cylinders `A` over `[a, i]` and `B` over `[i, b]`
(`boundaryLawMeasure_intervalCylinder_inter`), and both sides are finite measures in `A` for fixed
`B`, and in `B` for fixed `A`; the two π-systems of such cylinders generate the two
σ-algebras. -/
theorem IsBoundaryLaw.measure_inter_inter_preimage_mul (i : ℤ) (x : E) {A B : Set (ℤ → E)}
    (hA : MeasurableSet[cylinderEvents (Set.Iic i)] A)
    (hB : MeasurableSet[cylinderEvents (Set.Ici i)] B) :
    boundaryLawMeasure hbl (A ∩ B ∩ (fun σ : ℤ → E ↦ σ i) ⁻¹' {x})
        * boundaryLawMeasure hbl ((fun σ : ℤ → E ↦ σ i) ⁻¹' {x})
      = boundaryLawMeasure hbl (A ∩ (fun σ : ℤ → E ↦ σ i) ⁻¹' {x})
        * boundaryLawMeasure hbl (B ∩ (fun σ : ℤ → E ↦ σ i) ⁻¹' {x}) := by
  classical
  set μ := boundaryLawMeasure hbl with hμ
  set X : Set (ℤ → E) := (fun σ : ℤ → E ↦ σ i) ⁻¹' {x} with hX
  have hXmass : μ X = ℓ i x * r i x := by
    have := hbl.boundaryLawMeasure_intervalCylinder_self i (fun _ ↦ x)
    rwa [intervalCylinder_self] at this
  have hAm : MeasurableSet A := cylinderEvents_le_pi _ hA
  have hBm : MeasurableSet B := cylinderEvents_le_pi _ hB
  -- the base case: two interval cylinders meeting at `i`
  have base : ∀ (a : ℤ) (η : ℤ → E), a ≤ i → ∀ (b : ℤ) (ζ : ℤ → E), i ≤ b →
      μ (intervalCylinder a i η ∩ intervalCylinder i b ζ ∩ X) * μ X
        = μ (intervalCylinder a i η ∩ X) * μ (intervalCylinder i b ζ ∩ X) := by
    intro a η hai b ζ hib
    by_cases hη : η i = x
    · have hAX : intervalCylinder a i η ∩ X = intervalCylinder a i η := by
        refine Set.inter_eq_left.2 fun τ hτ ↦ ?_
        rw [mem_intervalCylinder] at hτ
        change τ i = x
        rw [hτ i (Finset.mem_Icc.2 ⟨hai, le_rfl⟩), hη]
      by_cases hζ : ζ i = x
      · have hBX : intervalCylinder i b ζ ∩ X = intervalCylinder i b ζ := by
          refine Set.inter_eq_left.2 fun τ hτ ↦ ?_
          rw [mem_intervalCylinder] at hτ
          change τ i = x
          rw [hτ i (Finset.mem_Icc.2 ⟨le_rfl, hib⟩), hζ]
        rw [Set.inter_assoc, hBX, hAX, hXmass, ← hη]
        exact hbl.boundaryLawMeasure_intervalCylinder_inter hai hib (hη.trans hζ.symm)
      · have hBX : intervalCylinder i b ζ ∩ X = ∅ := by
          refine Set.eq_empty_of_forall_notMem fun τ ⟨hτ, hτx⟩ ↦ hζ ?_
          rw [mem_intervalCylinder] at hτ
          rw [← hτ i (Finset.mem_Icc.2 ⟨le_rfl, hib⟩)]
          exact hτx
        rw [Set.inter_assoc, hBX, Set.inter_empty, measure_empty, zero_mul, mul_zero]
    · have hAX : intervalCylinder a i η ∩ X = ∅ := by
        refine Set.eq_empty_of_forall_notMem fun τ ⟨hτ, hτx⟩ ↦ hη ?_
        rw [mem_intervalCylinder] at hτ
        rw [← hτ i (Finset.mem_Icc.2 ⟨hai, le_rfl⟩)]
        exact hτx
      have hABX : intervalCylinder a i η ∩ intervalCylinder i b ζ ∩ X = ∅ := by
        rw [Set.inter_right_comm, hAX, Set.empty_inter]
      rw [hABX, hAX, measure_empty, zero_mul, zero_mul]
  have hgenL := cylinderEvents_Iic_eq_generateFrom_leftCylinders (E := E) i
  have hgenR := cylinderEvents_Ici_eq_generateFrom_rightCylinders (E := E) i
  -- Step 1: a general past event `A`, a cylinder `B`
  have step1 : ∀ (b : ℤ) (ζ : ℤ → E), i ≤ b →
      μ (A ∩ intervalCylinder i b ζ ∩ X) * μ X
        = μ (A ∩ X) * μ (intervalCylinder i b ζ ∩ X) := by
    intro b ζ hib
    have hBm' : MeasurableSet (intervalCylinder i b ζ) := measurableSet_intervalCylinder i b ζ
    have : IsFiniteMeasure (μ X • μ.restrict (intervalCylinder i b ζ ∩ X)) :=
      Measure.smul_finite _ (measure_ne_top μ X)
    have key := ext_on_measurableSpace_of_generate_finite MeasurableSpace.pi
      (μ := μ X • μ.restrict (intervalCylinder i b ζ ∩ X))
      (ν := μ (intervalCylinder i b ζ ∩ X) • μ.restrict X) (leftCylinders i) ?_
      cylinderEvents_le_pi hgenL (isPiSystem_leftCylinders i) ?_ hA
    · simp only [Measure.smul_apply, Measure.restrict_apply hAm, smul_eq_mul] at key
      rw [Set.inter_assoc, mul_comm, key, mul_comm]
    · rintro S ⟨a, η, hai, rfl⟩
      simp only [Measure.smul_apply, Measure.restrict_apply (measurableSet_intervalCylinder _ _ _),
        smul_eq_mul]
      rw [mul_comm, ← Set.inter_assoc, base a η hai b ζ hib, mul_comm]
    · simp only [Measure.smul_apply, Measure.restrict_apply_univ, smul_eq_mul]
      rw [mul_comm]
  -- Step 2: a general future event `B`
  have : IsFiniteMeasure (μ X • μ.restrict (A ∩ X)) := Measure.smul_finite _ (measure_ne_top μ X)
  have key := ext_on_measurableSpace_of_generate_finite MeasurableSpace.pi
    (μ := μ X • μ.restrict (A ∩ X)) (ν := μ (A ∩ X) • μ.restrict X) (rightCylinders i) ?_
    cylinderEvents_le_pi hgenR (isPiSystem_rightCylinders i) ?_ hB
  · simp only [Measure.smul_apply, Measure.restrict_apply hBm, smul_eq_mul] at key
    have hset : A ∩ B ∩ X = B ∩ (A ∩ X) := by
      ext τ
      simp only [Set.mem_inter_iff]
      tauto
    rw [hset, mul_comm, key]
  · rintro S ⟨b, ζ, hib, rfl⟩
    simp only [Measure.smul_apply, Measure.restrict_apply (measurableSet_intervalCylinder _ _ _),
      smul_eq_mul]
    have hset : intervalCylinder i b ζ ∩ (A ∩ X) = A ∩ intervalCylinder i b ζ ∩ X := by
      ext τ
      simp only [Set.mem_inter_iff]
      tauto
    rw [hset, mul_comm, step1 b ζ hib]
  · simp only [Measure.smul_apply, Measure.restrict_apply_univ, smul_eq_mul]
    rw [mul_comm]

end MarkovProperty

end MeasureTheory.GibbsMeasure.Markov

end
